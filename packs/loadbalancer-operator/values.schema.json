{
  "$comment": "SPDX-FileCopyrightText: 2026 Norca contributors; SPDX-License-Identifier: MPL-2.0",
  "type": "object",
  "properties": {
    "job_name": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$"},
    "namespace": {"type": "string", "minLength": 1},
    "region": {"type": "string"},
    "datacenters": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "count": {"type": "integer", "minimum": 1, "maximum": 5},
    "driver": {"enum": ["raw_exec", "exec", "docker", "mock_driver"]},
    "binary": {"type": "string"},
    "image": {"type": "string"},
    "cpu": {"type": "integer", "minimum": 20},
    "memory": {"type": "integer", "minimum": 16},
    "log_level": {"enum": ["debug", "info", "warn", "error"]},
    "proxy_driver": {"enum": ["raw_exec", "exec", "docker", "mock_driver"]},
    "proxy_image": {"type": "string"},
    "discover_services": {"type": "boolean"},
    "webhook_enabled": {"type": "boolean"},
    "webhook_url": {"type": "string", "pattern": "^(https://[^/?#]+(/[^?#]*)?)?$"},
    "webhook_ca_cert": {"type": "string"},
    "webhook_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "webhook_failure_policy": {"enum": ["fail", "ignore"]},
    "default_class": {"type": "string", "minLength": 1},
    "classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acl_policy_enabled": {"type": "boolean"},
    "admission_policy_enabled": {"type": "boolean"},
    "admission_policy_action": {"enum": ["deny", "warn"]},
    "write_rate": {"type": "number", "minimum": 0},
    "identity_write_rate": {"type": "number", "minimum": 0},
    "max_objects_per_namespace": {"type": "integer", "minimum": 0},
    "max_watches_per_identity": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"driver": {"const": "docker"}}, "required": ["driver"]},
      "then": {"properties": {"image": {"minLength": 1}}}
    },
    {
      "if": {"properties": {"proxy_driver": {"const": "docker"}}, "required": ["proxy_driver"]},
      "then": {"properties": {"proxy_image": {"minLength": 1}}}
    },
    {
      "if": {"properties": {"webhook_enabled": {"const": true}}, "required": ["webhook_enabled"]},
      "then": {"properties": {"webhook_url": {"minLength": 9}}}
    }
  ]
}
