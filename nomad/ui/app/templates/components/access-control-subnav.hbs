<div
  class="tabs is-subnav"
  data-test-access-control-subnav
  {{did-insert this.keyboard.registerNav type="subnav"}}
  {{will-destroy this.keyboard.unregisterSubnav}}
>
  <ul>
    <li data-test-tab="overview">
      <LinkTo @route="access-control.index" @activeClass="is-active">
        Overview
      </LinkTo>
    </li>
    {{#if (can "list tokens")}}
      <li data-test-tab="tokens">
        <LinkTo @route="access-control.tokens" @activeClass="is-active">
          Tokens
        </LinkTo>
      </li>
    {{/if}}
    {{#if (can "list roles")}}
      <li data-test-tab="roles">
        <LinkTo @route="access-control.roles" @activeClass="is-active">
          Roles
        </LinkTo>
      </li>
    {{/if}}
    {{#if (can "list policies")}}
      <li data-test-tab="policies">
        <LinkTo @route="access-control.policies" @activeClass="is-active">
          Policies
        </LinkTo>
      </li>
    {{/if}}
  </ul>
</div>
