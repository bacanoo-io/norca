{{page-title "Server " this.model.name}}
<Servers::Header @server={{this.model}}>
  {{#if (can "read agent")}}
    <AgentMonitor
      @level={{this.level}}
      @server={{this.model}}
      @onLevelChange={{fn (mut this.level)}} />
  {{else}}
    <ForbiddenMessage @permission="agent:read" />
  {{/if}}
</Servers::Header>
