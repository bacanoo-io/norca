{{page-title "Server " this.model.name}}
<Servers::Header @server={{this.model}}>
  <div class="row g-3">
    <div class="col-lg-5">
      <Ui::Card @title="Server details" data-test-server-details>
        <Ui::Datagrid as |g|>
          <g.Item @title="Status">
            <span data-test-status><Ui::StatusIndicator @status={{this.model.status}} /></span>
          </g.Item>
          <g.Item @title="Address" @monospace={{true}}><span data-test-address>{{this.model.rpcAddr}}</span></g.Item>
          <g.Item @title="Datacenter"><span data-test-datacenter>{{this.model.datacenter}}</span></g.Item>
          <g.Item @title="Region"><span data-test-region>{{or this.model.region "–"}}</span></g.Item>
          <g.Item @title="Version">
            <span data-test-version title={{if this.model.norcaVersion (concat "Nomad API " this.model.version " compatible")}}>
              {{#if this.model.norcaVersion}}Norca {{this.model.norcaVersion}}{{else}}Nomad {{this.model.version}}{{/if}}
            </span>
          </g.Item>
          <g.Item @title="Serf port" @monospace={{true}}>{{this.model.serfPort}}</g.Item>
        </Ui::Datagrid>
      </Ui::Card>
    </div>
    <div class="col-lg-7">
      <Ui::Card @title="Server tags" @flush={{true}} data-test-server-tags>
        <Ui::KeyValueTable @data={{this.model.tags}} @caption="Server tags" />
      </Ui::Card>
    </div>
  </div>
</Servers::Header>
