{{page-title "Servers"}}
<Ui::PageHeader @pretitle="Operations" @title="Servers and regions" @subtitle="Server members of every region, as seen by the agent">
  <:actions>
    {{#unless this.isForbidden}}
      <Ui::Button
        @icon="refresh"
        @disabled={{this.regionsLoading}}
        data-test-refresh-regions
        {{on "click" this.refreshRegions}}
      >Refresh</Ui::Button>
    {{/unless}}
  </:actions>
</Ui::PageHeader>
<Ui::PageBody>
  {{#if this.isForbidden}}
    <ForbiddenMessage />
  {{else}}
    <Servers::Regions
      @summaries={{this.regionRows}}
      @isLoading={{this.regionsLoading}}
      class="mb-3"
    />
    <Ui::DataTable
      @id="servers"
      @caption="Servers"
      @columns={{this.columns}}
      @rows={{this.sortedAgents}}
      @sortBy={{this.sortProperty}}
      @sortDescending={{this.sortDescending}}
      @onSort={{this.sort}}
      @pageSize={{this.pageSize}}
      @page={{this.currentPage}}
      @onPageChange={{this.setPage}}
      @onRowClick={{this.gotoServer}}
      @enumerate={{true}}
      @noun="servers"
    >
      <:row as |agent r|>
        <Servers::ListRow
          @agent={{agent}}
          @r={{r}}
          @isLeader={{this.isLeader agent}}
          @raftPeer={{this.raftPeerOf agent}}
          @region={{this.regionOf agent}}
          @colorIndex={{this.colorIndexOf (this.regionOf agent)}}
        />
      </:row>
      <:empty>
        <Ui::EmptyState
          @icon="server-off"
          @title="No Servers"
          @message="The agent knows no server members. Check that the servers are running and joined to each other."
          data-test-empty-servers-list
        />
      </:empty>
    </Ui::DataTable>
  {{/if}}
</Ui::PageBody>
