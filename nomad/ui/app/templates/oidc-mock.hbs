{{page-title "Mock OIDC Test Page"}}
{{! A full-screen stand-in for an identity provider (Mirage only). }}
<main class="norca-error-page" data-test-oidc-mock>
  <Ui::Card class="norca-oidc-mock">
    <h1 class="h2">OIDC test route: {{this.auth_method}}</h1>
    <p class="text-secondary">Mirage only</p>
    <div class="d-grid gap-2">
      {{#each this.model as |fakeAccount|}}
        <Ui::Button
          @variant="primary"
          {{on "click" (fn this.signIn fakeAccount)}}
          data-test-oidc-mock-account
        >
          Sign In as {{fakeAccount.name}}
        </Ui::Button>
      {{/each}}
      <Ui::Button
        @variant="danger"
        {{on "click" this.failToSignIn}}
        data-test-oidc-mock-failure
      >
        Simulate Failure
      </Ui::Button>
    </div>
  </Ui::Card>
</main>
{{outlet}}
