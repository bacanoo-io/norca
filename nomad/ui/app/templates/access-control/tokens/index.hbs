{{page-title "Tokens"}}
<section class="section">
  <header class="acl-list-header">
    <div>
      <h1 class="title">Tokens</h1>
      <p class="acl-explainer">
        Tokens authenticate requests to Nomad. Client tokens get their permissions from linked roles and policies;
        management tokens can do everything.
      </p>
    </div>
    <div class="acl-list-actions">
      {{#if (can "write token")}}
        <Hds::Button
          @text="Create Token"
          @icon="plus"
          @route="access-control.tokens.new"
          data-test-create-token
        />
      {{else}}
        <Hds::Button
          @text="Create Token"
          @icon="plus"
          disabled
          title="You don’t have sufficient permissions"
          data-test-disabled-create-token
        />
      {{/if}}
    </div>
  </header>

  {{#if this.tokens.length}}
    <Hds::Table
      class="acl-table"
      @model={{this.tokens}}
      @columns={{this.columns}}
      @sortBy="name"
    >
      <:body as |B|>
        {{#let (eq B.data.id this.selfTokenId) as |isOwnToken|}}
          <B.Tr data-test-token-row>
            <B.Td data-test-token-name={{B.data.name}}>
              {{#if isOwnToken}}
                {{B.data.name}}
              {{else}}
                <LinkTo @route="access-control.tokens.token" @model={{B.data.id}}>{{B.data.name}}</LinkTo>
              {{/if}}
            </B.Td>
            <B.Td data-test-token-type={{B.data.type}}>{{B.data.type}}</B.Td>
            <B.Td data-test-token-create-time>
              {{#if B.data.createTime}}
                <span title={{format-ts B.data.createTime}}>{{moment-from-now B.data.createTime}}</span>
              {{/if}}
            </B.Td>
            <B.Td
              class={{if B.data.isExpired "has-text-danger"}}
              data-test-token-expiration-time
            >{{#if B.data.expirationTime}}{{moment-from-now B.data.expirationTime interval=1000}}{{else}}Never{{/if}}</B.Td>
            <B.Td data-test-token-roles>
              <div class="tag-group">
                {{#each B.data.roles as |role|}}
                  <span class="tag">
                    {{#if (can "read role")}}
                      <LinkTo @route="access-control.roles.role" @model={{role.id}}>{{role.name}}</LinkTo>
                    {{else}}
                      {{role.name}}
                    {{/if}}
                  </span>
                {{else}}
                  No Roles
                {{/each}}
              </div>
            </B.Td>
            <B.Td data-test-token-policies>
              <div class="tag-group">
                {{#each B.data.policies as |policy|}}
                  <span class="tag">
                    {{#if (can "read policy")}}
                      <LinkTo @route="access-control.policies.policy" @model={{policy.name}}>{{policy.name}}</LinkTo>
                    {{else}}
                      {{policy.name}}
                    {{/if}}
                  </span>
                {{else}}
                  No Policies
                {{/each}}
              </div>
            </B.Td>
            {{#if (can "destroy token")}}
              <B.Td data-test-delete-token>
                <Hds::Button
                  @text="Delete"
                  @color="critical"
                  @size="small"
                  disabled={{or isOwnToken this.deleteToken.isRunning}}
                  title={{if isOwnToken "You cannot delete the token you are signed in with"}}
                  {{on "click" (perform this.deleteToken B.data)}}
                />
              </B.Td>
            {{/if}}
          </B.Tr>
        {{/let}}
      </:body>
    </Hds::Table>
  {{else}}
    <div class="empty-message">
      <h3 data-test-empty-tokens-list-headline class="empty-message-headline">
        No Tokens
      </h3>
    </div>
  {{/if}}
</section>
