<Breadcrumb @crumb={{hash label=this.tokenRecord.name args=(array "access-control.tokens.token" this.tokenRecord.id)}} />
{{page-title "Token " this.tokenRecord.name}}
<section class="section">
  <h1 class="title with-flex" data-test-title>
    <div>
      {{this.tokenRecord.name}}
      {{#if this.isOwnToken}}
        <Hds::Badge @text="Your token" @color="highlight" data-test-own-token-badge />
      {{/if}}
    </div>
    {{#if (can "destroy token")}}
      <div>
        <Hds::Button
          @text="Delete Token"
          @color="critical"
          disabled={{or this.isOwnToken this.deleteToken.isRunning}}
          title={{if this.isOwnToken "You cannot delete the token you are signed in with"}}
          data-test-delete-token
          {{on "click" (perform this.deleteToken)}}
        />
      </div>
    {{/if}}
  </h1>

  {{! Re-create the editor when the token changes so its selection state resets }}
  {{#each (array this.tokenRecord) as |token|}}
    <TokenEditor
      @token={{token}}
      @policies={{this.policies}}
      @roles={{this.roles}}
    />
  {{/each}}
</section>
