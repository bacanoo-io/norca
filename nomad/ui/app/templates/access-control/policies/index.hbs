{{page-title "Policies"}}
<Access::Header @title="Policies">
  {{#if (can "write policy")}}
    <Ui::Button @variant="primary" @icon="plus" @route="access-control.policies.new" data-test-create-policy>Create Policy</Ui::Button>
  {{else}}
    <Ui::Tooltip @text="You don’t have sufficient permissions">
      <Ui::Button @variant="primary" @icon="plus" @disabled={{true}} data-test-disabled-create-policy>Create Policy</Ui::Button>
    </Ui::Tooltip>
  {{/if}}
</Access::Header>
<Ui::PageBody>
  <Access::Tabs />
  <p class="text-secondary">
    Policies are sets of rules that grant capabilities. Link them to tokens directly or through roles.
  </p>
  <Ui::DataTable
    @id="access-policies"
    @caption="Policies"
    @columns={{this.columns}}
    @rows={{this.rows}}
    @sortBy={{this.list.sortBy}}
    @sortDescending={{this.list.sortDescending}}
    @onSort={{this.list.sort}}
    @pageSize={{this.list.pageSize}}
    @page={{this.list.page}}
    @onPageChange={{this.list.setPage}}
    @onPageSizeChange={{this.list.setPageSize}}
    @onRowClick={{this.openPolicy}}
    @enumerate={{true}}
    @noun="policies"
    @viewState={{this.list.viewState}}
    @onApplyView={{this.list.applyView}}
  >
    <:filters>
      <Ui::Input
        @type="search"
        @icon="search"
        @placeholder="Search policies..."
        @value={{this.list.searchTerm}}
        @onInput={{this.list.search}}
        aria-label="Search policies"
        data-test-policies-search
      />
    </:filters>
    <:row as |policy r|>
      <r.Row data-test-policy-row>
        <r.Cell @key="name" data-test-policy-name={{policy.name}}>
          <LinkTo @route="access-control.policies.policy" @model={{policy.name}}>{{policy.name}}</LinkTo>
        </r.Cell>
        <r.Cell @key="description" data-test-policy-description>{{policy.description}}</r.Cell>
        <r.Cell @key="tokens" class="tabular-nums" data-test-policy-token-count>
          {{#let (get this.tokenCounts policy.name) as |counts|}}
            <span data-test-policy-total-tokens>{{if counts counts.total 0}}</span>
            {{#if counts.expired}}
              <span class="text-danger" data-test-policy-expired-tokens>({{counts.expired}} expired)</span>
            {{/if}}
          {{/let}}
        </r.Cell>
        <r.Cell @key="actions" class="text-end">
          <Ui::ConfirmButton
            @label="Delete"
            @icon="trash"
            @size="sm"
            @message="Delete the policy {{policy.name}}?"
            @confirmLabel="Yes, delete"
            @disabled={{this.deletePolicy.isRunning}}
            @isRunning={{this.deletePolicy.isRunning}}
            @onConfirm={{perform this.deletePolicy policy}}
            data-test-delete-policy
          />
        </r.Cell>
      </r.Row>
    </:row>
    <:empty>
      {{#if this.policies.length}}
        <Ui::EmptyState @icon="filter-off" @title="No Matches" @message="No policies match the search." data-test-empty-policies-list />
      {{else}}
        <Ui::EmptyState @icon="shield" @title="No Policies" data-test-empty-policies-list>
          {{#if (can "write policy")}}
            <p class="text-secondary">Get started by <LinkTo @route="access-control.policies.new">creating a new policy</LinkTo>.</p>
          {{/if}}
        </Ui::EmptyState>
      {{/if}}
    </:empty>
  </Ui::DataTable>
</Ui::PageBody>
