{{page-title "Policies"}}
<section class="section">
  <header class="acl-list-header">
    <div>
      <h1 class="title">Policies</h1>
      <p class="acl-explainer">
        Policies are sets of rules that grant capabilities. Link them to tokens directly or through roles.
      </p>
    </div>
    <div class="acl-list-actions">
      {{#if (can "write policy")}}
        <Hds::Button
          @text="Create Policy"
          @icon="plus"
          @route="access-control.policies.new"
          data-test-create-policy
        />
      {{else}}
        <Hds::Button
          @text="Create Policy"
          @icon="plus"
          disabled
          title="You don’t have sufficient permissions"
          data-test-disabled-create-policy
        />
      {{/if}}
    </div>
  </header>

  {{#if this.policies.length}}
    <Hds::Table
      class="acl-table"
      @model={{this.policies}}
      @columns={{this.columns}}
      @sortBy="name"
    >
      <:body as |B|>
        <B.Tr
          class="is-interactive"
          data-test-policy-row
          {{on "click" (fn this.openPolicy B.data)}}
        >
          <B.Td data-test-policy-name={{B.data.name}}>
            <LinkTo @route="access-control.policies.policy" @model={{B.data.name}}>{{B.data.name}}</LinkTo>
          </B.Td>
          <B.Td data-test-policy-description>{{B.data.description}}</B.Td>
          {{#if (can "list tokens")}}
            {{#let (get this.tokenCounts B.data.name) as |counts|}}
              <B.Td data-test-policy-token-count>
                <span data-test-policy-total-tokens>{{if counts counts.total 0}}</span>
                {{#if counts.expired}}
                  <span data-test-policy-expired-tokens class="number-expired">({{counts.expired}} expired)</span>
                {{/if}}
              </B.Td>
            {{/let}}
          {{/if}}
          {{#if (can "destroy policy")}}
            <B.Td>
              <Hds::Button
                @text="Delete"
                @color="critical"
                @size="small"
                disabled={{this.deletePolicy.isRunning}}
                data-test-delete-policy
                {{on "click" (perform this.deletePolicy B.data)}}
              />
            </B.Td>
          {{/if}}
        </B.Tr>
      </:body>
    </Hds::Table>
  {{else}}
    <div class="empty-message">
      <h3 data-test-empty-policies-list-headline class="empty-message-headline">
        No Policies
      </h3>
      {{#if (can "write policy")}}
        <p class="empty-message-body">
          Get started by <LinkTo @route="access-control.policies.new">creating a new policy</LinkTo>.
        </p>
      {{/if}}
    </div>
  {{/if}}
</section>
