{{page-title "Role " this.role.name}}
<Access::Header
  @title={{this.role.name}}
  @trail={{array (hash label="Roles" route="access-control.roles" id="access-control.roles") (hash label=this.role.name)}}
>
  {{#if (can "destroy role")}}
    <Ui::ConfirmButton
      @label="Delete Role"
      @icon="trash"
      @message="Delete the role {{this.role.name}}?"
      @confirmLabel="Yes, delete"
      @disabled={{this.deleteRole.isRunning}}
      @isRunning={{this.deleteRole.isRunning}}
      @onConfirm={{perform this.deleteRole}}
      data-test-delete-role
    />
  {{/if}}
</Access::Header>
<Ui::PageBody>
  {{! Re-create the editor when the role changes so its selection state resets }}
  {{#each (array this.role) as |role|}}
    <RoleEditor @role={{role}} @policies={{this.policies}} />
  {{/each}}

  {{#if (can "list tokens")}}
    <h2 class="h3 mt-4 mb-2">Tokens</h2>

    {{#if (can "write token")}}
      <Ui::Card @title="Create tokens from the Norca CLI" class="mb-3">
        <p class="text-secondary">Create a token linked to this role with:</p>
        <Ui::CodeBlock @code={{this.newTokenString}} @copy={{true}} @label="The command" />
        <p class="mt-2 mb-0">
          Or <LinkTo @route="access-control.tokens.new">create a token</LinkTo> here and select this role.
        </p>
      </Ui::Card>
    {{/if}}

    {{#if this.tokens.length}}
      <Ui::Table @caption="Tokens linked to {{this.role.name}}" @columns={{this.tokenColumns}} @rows={{this.tokens}} @rowTestId="role-token-row" as |token|>
        <td data-test-token-name={{token.name}}>
          <LinkTo @route="access-control.tokens.token" @model={{token.id}}>{{token.name}}</LinkTo>
        </td>
        <td class="text-nowrap">{{moment-from-now token.createTime interval=1000}}</td>
        <td class="text-nowrap">
          {{#if token.expirationTime}}
            <span class={{if token.isExpired "text-danger"}} data-test-token-expiration-time>{{moment-from-now token.expirationTime interval=1000}}</span>
          {{else}}
            <span data-test-token-expiration-time>Never</span>
          {{/if}}
        </td>
        {{#if (can "destroy token")}}
          <td class="text-end">
            <Ui::ConfirmButton
              @label="Delete Token"
              @icon="trash"
              @size="sm"
              @message="Delete the token {{token.name}}?"
              @confirmLabel="Yes, delete"
              @disabled={{this.deleteToken.isRunning}}
              @isRunning={{this.deleteToken.isRunning}}
              @onConfirm={{perform this.deleteToken token}}
              data-test-delete-token-button
            />
          </td>
        {{/if}}
      </Ui::Table>
    {{else}}
      <Ui::EmptyState @compact={{true}} @icon="key" @title="No Tokens" @message="No tokens are linked to this role." data-test-empty-role-tokens />
    {{/if}}
  {{/if}}
</Ui::PageBody>
