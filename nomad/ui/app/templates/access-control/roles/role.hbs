<Breadcrumb @crumb={{hash label=this.role.name args=(array "access-control.roles.role" this.role.id)}} />
{{page-title "Role " this.role.name}}
<section class="section">
  <h1 class="title with-flex" data-test-title>
    <div>
      {{this.role.name}}
    </div>
    {{#if (can "destroy role")}}
      <div>
        <Hds::Button
          @text="Delete Role"
          @color="critical"
          disabled={{this.deleteRole.isRunning}}
          data-test-delete-role
          {{on "click" (perform this.deleteRole)}}
        />
      </div>
    {{/if}}
  </h1>

  {{! Re-create the editor when the role changes so its selection state resets }}
  {{#each (array this.role) as |role|}}
    <RoleEditor
      @role={{role}}
      @policies={{this.policies}}
    />
  {{/each}}

  {{#if (can "list tokens")}}
    <hr />
    <h2 class="title">Tokens</h2>

    {{#if (can "write token")}}
      <div class="boxed-section">
        <div class="boxed-section-head">
          <h3>Create Tokens from the Nomad CLI</h3>
        </div>
        <div class="boxed-section-body">
          <p>Create a token linked to this role with:</p>
          <pre class="acl-cli-hint"><code>{{this.newTokenString}}</code><CopyButton @clipboardText={{this.newTokenString}} @compact={{true}} /></pre>
          <p>
            Or <LinkTo @route="access-control.tokens.new">create a token</LinkTo> here and select this role.
          </p>
        </div>
      </div>
    {{/if}}

    {{#if this.tokens.length}}
      <ListTable
        @source={{this.tokens}}
        @class="no-mobile-condense" as |t|>
        <t.head>
          <th>Name</th>
          <th>Created</th>
          <th>Expires</th>
          {{#if (can "destroy token")}}
            <th>Delete</th>
          {{/if}}
        </t.head>
        <t.body as |row|>
          <tr data-test-role-token-row>
            <td data-test-token-name={{row.model.name}}>
              <LinkTo @route="access-control.tokens.token" @model={{row.model.id}}>{{row.model.name}}</LinkTo>
            </td>
            <td>
              {{moment-from-now row.model.createTime interval=1000}}
            </td>
            <td>
              {{#if row.model.expirationTime}}
                <span data-test-token-expiration-time class="{{if row.model.isExpired "has-text-danger"}}">{{moment-from-now row.model.expirationTime interval=1000}}</span>
              {{else}}
                <span data-test-token-expiration-time>Never</span>
              {{/if}}
            </td>
            {{#if (can "destroy token")}}
              <td class="is-200px">
                <Hds::Button
                  @text="Delete Token"
                  @color="critical"
                  @size="small"
                  disabled={{this.deleteToken.isRunning}}
                  data-test-delete-token-button
                  {{on "click" (perform this.deleteToken row.model)}}
                />
              </td>
            {{/if}}
          </tr>
        </t.body>
      </ListTable>
    {{else}}
      <div class="empty-message">
        <h3 data-test-empty-role-tokens-headline class="empty-message-headline">
          No Tokens
        </h3>
        <p class="empty-message-body">
          No tokens are linked to this role.
        </p>
      </div>
    {{/if}}
  {{/if}}
</section>
