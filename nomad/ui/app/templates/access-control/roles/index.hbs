{{page-title "Roles"}}
<Access::Header @title="Roles">
  {{#if (can "write role")}}
    <Ui::Button @variant="primary" @icon="plus" @route="access-control.roles.new" data-test-create-role>Create Role</Ui::Button>
  {{else}}
    <Ui::Tooltip @text="You don’t have sufficient permissions">
      <Ui::Button @variant="primary" @icon="plus" @disabled={{true}} data-test-disabled-create-role>Create Role</Ui::Button>
    </Ui::Tooltip>
  {{/if}}
</Access::Header>
<Ui::PageBody>
  <Access::Tabs />
  <p class="text-secondary">
    Roles group policies under a name. A token linked to a role gets the permissions of all of its policies.
  </p>
  <Ui::DataTable
    @id="access-roles"
    @caption="Roles"
    @columns={{this.columns}}
    @rows={{this.rows}}
    @sortBy={{this.list.sortBy}}
    @sortDescending={{this.list.sortDescending}}
    @onSort={{this.list.sort}}
    @pageSize={{this.list.pageSize}}
    @page={{this.list.page}}
    @onPageChange={{this.list.setPage}}
    @onPageSizeChange={{this.list.setPageSize}}
    @onRowClick={{this.openRole}}
    @enumerate={{true}}
    @noun="roles"
    @viewState={{this.list.viewState}}
    @onApplyView={{this.list.applyView}}
  >
    <:filters>
      <Ui::Input
        @type="search"
        @icon="search"
        @placeholder="Search roles..."
        @value={{this.list.searchTerm}}
        @onInput={{this.list.search}}
        aria-label="Search roles"
        data-test-roles-search
      />
    </:filters>
    <:row as |role r|>
      <r.Row data-test-role-row>
        <r.Cell @key="name" data-test-role-name={{role.name}}>
          <LinkTo @route="access-control.roles.role" @model={{role.id}}>{{role.name}}</LinkTo>
        </r.Cell>
        <r.Cell @key="description" data-test-role-description>{{role.description}}</r.Cell>
        <r.Cell @key="policies" data-test-role-policies>
          <Access::LinkList @items={{role.policies}} @route="access-control.policies.policy" @idKey="name" @permission="read policy" @empty="No Policies" />
        </r.Cell>
        <r.Cell @key="tokens" class="tabular-nums" data-test-role-total-tokens>{{or (get this.tokenCounts role.id) 0}}</r.Cell>
        <r.Cell @key="actions" class="text-end">
          <Ui::ConfirmButton
            @label="Delete"
            @icon="trash"
            @size="sm"
            @message="Delete the role {{role.name}}?"
            @confirmLabel="Yes, delete"
            @disabled={{this.deleteRole.isRunning}}
            @isRunning={{this.deleteRole.isRunning}}
            @onConfirm={{perform this.deleteRole role}}
            data-test-delete-role
          />
        </r.Cell>
      </r.Row>
    </:row>
    <:empty>
      {{#if this.roles.length}}
        <Ui::EmptyState @icon="filter-off" @title="No Matches" @message="No roles match the search." data-test-empty-roles-list />
      {{else}}
        <Ui::EmptyState @icon="users" @title="No Roles" data-test-empty-roles-list>
          {{#if (can "write role")}}
            <p class="text-secondary">Get started by <LinkTo @route="access-control.roles.new">creating a new role</LinkTo>.</p>
          {{/if}}
        </Ui::EmptyState>
      {{/if}}
    </:empty>
  </Ui::DataTable>
</Ui::PageBody>
