{{page-title "Access Control"}}
<Ui::PageHeader @breadcrumbs={{array (hash label="Access control")}}>
  <:title><span data-test-title>Access Control</span></:title>
</Ui::PageHeader>
<Ui::PageBody>
  <Access::Tabs />
  <p class="text-secondary">
    Norca's access control lists (ACLs) decide what each request may do. A <strong>token</strong> authenticates
    a request; a <strong>policy</strong> is a set of rules granting capabilities; a <strong>role</strong> bundles
    policies so they can be linked to many tokens at once. Client tokens get the permissions of their policies and
    roles, management tokens can do everything.
  </p>

  <div class="row row-cards">
    {{#if (can "list tokens")}}
      <div class="col-md-4">
        <Ui::Card @title="Tokens" class="h-100" data-test-tokens-card>
          <:actions>
            <Ui::Badge @color="secondary" data-test-tokens-count>{{this.model.tokens.length}}</Ui::Badge>
          </:actions>
          <:default>
            <p class="text-secondary">Credentials for users and automation. Each token links to policies and roles, and may expire.</p>
            <div class="d-flex flex-wrap gap-2">
              <Ui::Button @size="sm" @route="access-control.tokens">View Tokens</Ui::Button>
              {{#if (can "write token")}}
                <Ui::Button @size="sm" @variant="primary" @icon="plus" @route="access-control.tokens.new" data-test-overview-create-token>Create Token</Ui::Button>
              {{/if}}
            </div>
          </:default>
        </Ui::Card>
      </div>
    {{/if}}

    {{#if (can "list roles")}}
      <div class="col-md-4">
        <Ui::Card @title="Roles" class="h-100" data-test-roles-card>
          <:actions>
            <Ui::Badge @color="secondary" data-test-roles-count>{{this.model.roles.length}}</Ui::Badge>
          </:actions>
          <:default>
            <p class="text-secondary">Named groups of policies. Linking a role to a token grants all of the role's policies.</p>
            <div class="d-flex flex-wrap gap-2">
              <Ui::Button @size="sm" @route="access-control.roles">View Roles</Ui::Button>
              {{#if (can "write role")}}
                <Ui::Button @size="sm" @variant="primary" @icon="plus" @route="access-control.roles.new" data-test-overview-create-role>Create Role</Ui::Button>
              {{/if}}
            </div>
          </:default>
        </Ui::Card>
      </div>
    {{/if}}

    {{#if (can "list policies")}}
      <div class="col-md-4">
        <Ui::Card @title="Policies" class="h-100" data-test-policies-card>
          <:actions>
            <Ui::Badge @color="secondary" data-test-policies-count>{{this.model.policies.length}}</Ui::Badge>
          </:actions>
          <:default>
            <p class="text-secondary">Rules that grant capabilities on namespaces, nodes, variables, the agent and the operator API.</p>
            <div class="d-flex flex-wrap gap-2">
              <Ui::Button @size="sm" @route="access-control.policies">View Policies</Ui::Button>
              {{#if (can "write policy")}}
                <Ui::Button @size="sm" @variant="primary" @icon="plus" @route="access-control.policies.new" data-test-overview-create-policy>Create Policy</Ui::Button>
              {{/if}}
            </div>
          </:default>
        </Ui::Card>
      </div>
    {{/if}}
  </div>
</Ui::PageBody>
