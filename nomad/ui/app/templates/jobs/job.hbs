{{did-update this.notFoundJobHandler this.watchers.job.isError}}
<PageLayout @legacy={{false}}>
  {{#if this.isTaskGroupPage}}
    {{outlet}}
  {{else}}
    <Jobs::Header @job={{this.job}} />
    <Ui::PageBody>
      <Jobs::Tabs @job={{this.job}} />
      {{outlet}}
    </Ui::PageBody>
  {{/if}}
</PageLayout>
