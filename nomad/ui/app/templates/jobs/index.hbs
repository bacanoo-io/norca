{{page-title "Jobs"}}
<PageLayout @legacy={{false}}>
  <Ui::PageHeader @pretitle="Workloads" @title="Jobs" @subtitle={{this.scopeLabel}}>
    <:actions>
      {{#if (can "run job" namespace=this.qpNamespace)}}
        <Ui::Button
          @route="jobs.run"
          @query={{hash namespace=this.qpNamespace}}
          @variant="primary"
          @icon="plus"
          data-test-run-job
          {{keyboard-shortcut label="Run Job" pattern=(array "r" "u" "n") action=(action this.goToRun)}}
        >Run job</Ui::Button>
      {{else}}
        <Ui::Button
          @variant="primary"
          @icon="plus"
          @disabled={{true}}
          title="You don’t have permission to run jobs"
          data-test-run-job
        >Run job</Ui::Button>
      {{/if}}
    </:actions>
  </Ui::PageHeader>

  <Ui::PageBody>
    {{#if this.isAllRegions}}
      <Jobs::FederatedList @regions={{this.frame.scopedRegions}} @namespace={{this.qpNamespace}} />
    {{else if this.isForbidden}}
      <Ui::Card>
        <ForbiddenMessage />
      </Ui::Card>
    {{else}}
      <Ui::DataTable
        @id="jobs"
        @caption="Jobs"
        @columns={{this.columns}}
        @rows={{this.sortedJobs}}
        @sortBy={{this.sortProperty}}
        @sortDescending={{this.sortDescending}}
        @onSort={{this.sort}}
        @pageSize={{this.pageSize}}
        @page={{this.currentPage}}
        @onPageChange={{this.setPage}}
        @onPageSizeChange={{this.setPageSize}}
        @onRowClick={{this.gotoJob}}
        @enumerate={{true}}
        @noun="jobs"
        @viewState={{this.viewState}}
        @onApplyView={{this.applyView}}
        data-test-jobs-list
      >
        <:filters>
          <Ui::Input
            @type="search"
            @icon="search"
            @placeholder="Search jobs..."
            @value={{this.searchTerm}}
            @onInput={{this.search}}
            aria-label="Search jobs"
            data-test-jobs-search
          />
          {{#if this.system.shouldShowNamespaces}}
            <Ui::Select
              @label="Namespace"
              @options={{this.namespaceSelectOptions}}
              @value={{this.qpNamespace}}
              @onChange={{this.setNamespace}}
              class="w-auto"
              data-test-namespace-facet
            />
          {{/if}}
          <Ui::FilterDropdown
            @label="Type"
            @options={{this.optionsType}}
            @selection={{this.selectionType}}
            @onSelect={{fn this.setFilter "qpType"}}
            data-test-type-facet
          />
          <Ui::FilterDropdown
            @label="Node Pool"
            @options={{this.optionsNodePool}}
            @selection={{this.selectionNodePool}}
            @onSelect={{fn this.setFilter "qpNodePool"}}
            data-test-node-pool-facet
          />
          <Ui::FilterDropdown
            @label="Status"
            @options={{this.optionsStatus}}
            @selection={{this.selectionStatus}}
            @onSelect={{fn this.setFilter "qpStatus"}}
            data-test-status-facet
          />
          <Ui::FilterDropdown
            @label="Datacenter"
            @options={{this.optionsDatacenter}}
            @selection={{this.selectionDatacenter}}
            @onSelect={{fn this.setFilter "qpDatacenter"}}
            data-test-datacenter-facet
          />
          <Ui::FilterDropdown
            @label="Prefix"
            @options={{this.optionsPrefix}}
            @selection={{this.selectionPrefix}}
            @onSelect={{fn this.setFilter "qpPrefix"}}
            data-test-prefix-facet
          />
        </:filters>
        <:row as |job r|>
          <Jobs::ListRow @job={{job}} @r={{r}} />
        </:row>
        <:empty>
          {{#if (eq this.visibleJobs.length 0)}}
            <Ui::EmptyState
              @icon="briefcase"
              @title="No Jobs"
              @message="The cluster has no jobs in this namespace yet. Run a job to see it here."
              data-test-empty-jobs-list
            >
              {{#if (can "run job" namespace=this.qpNamespace)}}
                <Ui::Button @route="jobs.run" @query={{hash namespace=this.qpNamespace}} @variant="primary" @icon="plus">Run job</Ui::Button>
              {{/if}}
            </Ui::EmptyState>
          {{else if (eq this.filteredJobs.length 0)}}
            <Ui::EmptyState
              @icon="filter-off"
              @title="No Matches"
              @message="No jobs match your current filter selection. Clear the filters to see every job."
              data-test-empty-jobs-list
            />
          {{else}}
            <Ui::EmptyState
              @icon="search"
              @title="No Matches"
              @message="No jobs match the term {{this.searchTerm}}."
              data-test-empty-jobs-list
            />
          {{/if}}
        </:empty>
        <:footer>
          {{#if this.searchTerm}}
            <span class="text-secondary" data-test-hidden-by-search>
              ({{dec this.sortedJobs.length this.filteredJobs.length}} hidden by search term)
            </span>
          {{/if}}
        </:footer>
      </Ui::DataTable>
    {{/if}}
  </Ui::PageBody>
</PageLayout>
