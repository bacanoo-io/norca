{{page-title "Job " this.job.name " allocations"}}
<Allocations::Table
  @id="job-allocations"
  @caption="Allocations of {{this.job.name}}"
  @context="job"
  @allocations={{this.sortedAllocations}}
  @presorted={{true}}
  @sortBy={{this.sortProperty}}
  @sortDescending={{this.sortDescending}}
  @onSort={{this.sort}}
  @pageSize={{this.pageSize}}
  @page={{this.currentPage}}
  @onPageChange={{this.setPage}}
  @onPageSizeChange={{this.setPageSize}}
  @activeTask={{this.activeTask}}
  @onSetActiveTask={{this.setActiveTaskQueryParam}}
  @viewState={{this.viewState}}
  @onApplyView={{this.applyView}}
>
  <:filters>
    <Ui::Input
      @type="search"
      @icon="search"
      @placeholder="Search allocations..."
      @value={{this.searchTerm}}
      @onInput={{this.search}}
      aria-label="Search allocations"
      data-test-allocations-search
    />
    <Ui::FilterDropdown
      @label="Status"
      @options={{this.optionsAllocationStatus}}
      @selection={{this.selectionStatus}}
      @onSelect={{fn this.setFilter "qpStatus"}}
      data-test-allocation-status-facet
    />
    <Ui::FilterDropdown
      @label="Client"
      @options={{this.optionsClients}}
      @selection={{this.selectionClient}}
      @onSelect={{fn this.setFilter "qpClient"}}
      data-test-allocation-client-facet
    />
    <Ui::FilterDropdown
      @label="Task Group"
      @options={{this.optionsTaskGroups}}
      @selection={{this.selectionTaskGroup}}
      @onSelect={{fn this.setFilter "qpTaskGroup"}}
      data-test-allocation-task-group-facet
    />
    <Ui::FilterDropdown
      @label="Job Version"
      @options={{this.optionsVersions}}
      @selection={{this.selectionVersion}}
      @onSelect={{fn this.setFilter "qpVersion"}}
      data-test-allocation-version-facet
    />
    <Ui::FilterDropdown
      @label="Scheduling"
      @options={{this.optionsScheduling}}
      @selection={{this.selectionScheduling}}
      @onSelect={{fn this.setFilter "qpScheduling"}}
      data-test-allocation-scheduling-facet
    />
  </:filters>
  <:empty>
    {{#if this.allocations.length}}
      <Ui::EmptyState
        @icon="filter-off"
        @title="No matches"
        @message="No allocations match the search and the filters. Clear them to see every allocation of the job."
        data-test-empty-allocations-list
       />
    {{else}}
      <Ui::EmptyState
        @icon="box"
        @title="No allocations"
        @message="No allocations have been placed. Check the placement failures on the overview and the evaluations of the job."
        data-test-empty-allocations-list
       />
    {{/if}}
  </:empty>
</Allocations::Table>
