{{page-title "Task group " this.model.name " - Job " this.model.job.name}}
<Ui::PageHeader @breadcrumbs={{this.breadcrumbs}} data-test-task-group-header>
  <:title>
    <span data-test-task-group-name>{{this.model.name}}</span>
  </:title>
  <:subtitle>
    Task group of {{this.model.job.name}}{{#if this.system.shouldShowNamespaces}}, namespace {{this.model.job.namespace.name}}{{/if}}
  </:subtitle>
  <:actions>
    <Exec::OpenButton @job={{this.model.job}} @taskGroup={{this.model}} />
    {{#if this.model.scaling}}
      <Ui::Stepper
        @label="Count"
        @min={{this.model.scaling.min}}
        @max={{this.model.scaling.max}}
        @value={{this.model.count}}
        @disabled={{or this.model.job.runningDeployment (cannot "scale job" namespace=this.model.job.namespace.name)}}
        @disabledReason={{this.tooltipText}}
        @onChange={{action "scaleTaskGroup"}}
        data-test-task-group-count-stepper
      />
    {{/if}}
  </:actions>
</Ui::PageHeader>

<Ui::PageBody>
  <Ui::Card class="mb-3">
    <Ui::Datagrid as |g|>
      <g.Item @title="Tasks" data-test-task-group-tasks>{{this.model.tasks.length}}</g.Item>
      <g.Item @title="Reserved CPU" data-test-task-group-cpu>{{format-scheduled-hertz this.model.reservedCPU}}</g.Item>
      <g.Item @title="Reserved memory" data-test-task-group-mem>
        {{format-scheduled-bytes this.model.reservedMemory start="MiB"}}
        {{#if (gt this.model.reservedMemoryMax this.model.reservedMemory)}}
          ({{format-scheduled-bytes this.model.reservedMemoryMax start="MiB"}}Max)
        {{/if}}
      </g.Item>
      <g.Item @title="Reserved disk" data-test-task-group-disk>{{format-scheduled-bytes this.model.reservedEphemeralDisk start="MiB"}}</g.Item>
      <g.Item @title="Namespace">{{this.model.job.namespace.name}}</g.Item>
      {{#if this.model.scaling}}
        <g.Item @title="Count range" data-test-task-group-min>{{this.model.scaling.min}} to {{this.model.scaling.max}}</g.Item>
        <g.Item @title="Scaling policy" data-test-task-group-max>
          {{if this.model.scaling.policy "Yes" "No"}}
          <LinkTo @route="jobs.job.scaling" @model={{this.model.job}} class="ms-1">Scaling</LinkTo>
        </g.Item>
      {{/if}}
      {{#if (and (can "list variables") this.model.pathLinkedVariable)}}
        <g.Item @title="Variables" data-test-task-group-stat="variables">
          <LinkTo @route="variables.variable" @model={{this.model.pathLinkedVariable.id}}>{{this.model.pathLinkedVariable.path}}</LinkTo>
        </g.Item>
      {{/if}}
    </Ui::Datagrid>
  </Ui::Card>

  <Ui::Card @title="Allocation status" class="mb-3" data-test-task-group-allocation-status>
    <:actions><Ui::Badge @color="secondary">{{this.allocations.length}}</Ui::Badge></:actions>
    <:default>
      <Jobs::AllocationSummary @summary={{this.model.summary}} @job={{this.model.job}} />
    </:default>
  </Ui::Card>

  <h2 class="h3 mb-2">Allocations</h2>
  <Allocations::Table
    @id="task-group-allocations"
    @caption="Allocations of the task group {{this.model.name}}"
    @context="taskGroup"
    @allocations={{this.sortedAllocations}}
    @presorted={{true}}
    @sortBy={{this.sortProperty}}
    @sortDescending={{this.sortDescending}}
    @onSort={{this.sort}}
    @pageSize={{this.pageSize}}
    @page={{this.currentPage}}
    @onPageChange={{this.setPage}}
    @onPageSizeChange={{this.setPageSize}}
    @activeTask={{this.activeTask}}
    @onSetActiveTask={{action "setActiveTaskQueryParam"}}
    @viewState={{this.viewState}}
    @onApplyView={{this.applyView}}
    class="mb-3"
  >
    <:filters>
      <Ui::Input
        @type="search"
        @icon="search"
        @placeholder="Search allocations..."
        @value={{this.searchTerm}}
        @onInput={{this.search}}
        aria-label="Search allocations"
        data-test-allocations-search
      />
      <Ui::FilterDropdown
        @label="Status"
        @options={{this.optionsAllocationStatus}}
        @selection={{this.selectionStatus}}
        @onSelect={{fn this.setFilter "qpStatus"}}
        data-test-allocation-status-facet
      />
      <Ui::FilterDropdown
        @label="Client"
        @options={{this.optionsClients}}
        @selection={{this.selectionClient}}
        @onSelect={{fn this.setFilter "qpClient"}}
        data-test-allocation-client-facet
      />
    </:filters>
    <:empty>
      {{#if this.allocations.length}}
        <Ui::EmptyState @icon="filter-off" @title="No matches" @message="No allocations match the search and the filters." data-test-empty-allocations-list />
      {{else}}
        <Ui::EmptyState @icon="box" @title="No allocations" @message="No allocations have been placed for the task group." data-test-empty-allocations-list />
      {{/if}}
    </:empty>
  </Allocations::Table>

  <LifecycleChart @tasks={{this.model.tasks}} />

  {{#if this.model.scaleState.isVisible}}
    <Jobs::ScaleEvents @events={{this.sortedScaleEvents}} />
  {{/if}}

  {{#if this.model.volumes.length}}
    <h2 class="h3 mb-2">Volume requirements</h2>
    <Ui::DataTable
      @id="task-group-volumes"
      @caption="Volume requirements"
      @columns={{array (hash key="name" label="Name") (hash key="type" label="Type") (hash key="source" label="Source") (hash key="permissions" label="Permissions")}}
      @rows={{this.model.volumes}}
      @columnPicker={{false}}
      class="mb-3"
      data-test-volumes
    >
      <:row as |volume r|>
        <r.Row data-test-volume>
          <r.Cell @key="name" data-test-volume-name>
            {{#if volume.isCSI}}
              {{!-- with per_alloc=true there is no one specific volume: link to the volumes list with a search --}}
              {{#if volume.perAlloc}}
                <LinkTo @route="csi.volumes.index" @query={{hash search=volume.source}}>{{volume.name}}</LinkTo>
              {{else}}
                <LinkTo @route="csi.volumes.volume" @model={{concat volume.source "@" volume.namespace.id}}>{{volume.name}}</LinkTo>
              {{/if}}
            {{else}}
              {{volume.name}}
            {{/if}}
          </r.Cell>
          <r.Cell @key="type" data-test-volume-type>{{volume.type}}</r.Cell>
          <r.Cell @key="source" data-test-volume-source>{{volume.source}}</r.Cell>
          <r.Cell @key="permissions" data-test-volume-permissions>{{if volume.readOnly "Read" "Read/Write"}}</r.Cell>
        </r.Row>
      </:row>
    </Ui::DataTable>
  {{/if}}
</Ui::PageBody>
