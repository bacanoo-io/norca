{{page-title "Job " this.job.name " clients"}}
<Ui::DataTable
  @id="job-clients"
  @caption="Clients of {{this.job.name}}"
  @columns={{this.columns}}
  @rows={{this.sortedClients}}
  @rowKey="node.id"
  @sortBy={{this.sortProperty}}
  @sortDescending={{this.sortDescending}}
  @onSort={{this.sort}}
  @pageSize={{this.pageSize}}
  @page={{this.currentPage}}
  @onPageChange={{this.setPage}}
  @onRowClick={{this.gotoClientRow}}
  @enumerate={{true}}
  @noun="clients"
  @viewState={{this.viewState}}
  @onApplyView={{this.applyView}}
>
  <:filters>
    <Ui::Input
      @type="search"
      @icon="search"
      @placeholder="Search clients..."
      @value={{this.searchTerm}}
      @onInput={{this.search}}
      aria-label="Search clients"
      data-test-clients-search
    />
    <Ui::FilterDropdown
      @label="Job Status"
      @options={{this.optionsJobStatus}}
      @selection={{this.selectionStatus}}
      @onSelect={{fn this.setFilter "qpStatus"}}
      data-test-job-status-facet
    />
    <Ui::FilterDropdown
      @label="Datacenter"
      @options={{this.optionsDatacenter}}
      @selection={{this.selectionDatacenter}}
      @onSelect={{fn this.setFilter "qpDatacenter"}}
      data-test-datacenter-facet
    />
    <Ui::FilterDropdown
      @label="Client Class"
      @options={{this.optionsClientClass}}
      @selection={{this.selectionClientClass}}
      @onSelect={{fn this.setFilter "qpClientClass"}}
      data-test-client-class-facet
    />
  </:filters>
  <:row as |row r|>
    <Jobs::ClientStatusRow @row={{row}} @r={{r}} />
  </:row>
  <:empty>
    {{#if this.nodes.length}}
      <Ui::EmptyState @icon="filter-off" @title="No matches" @message="No clients match the search and the filters." data-test-empty-clients-list />
    {{else}}
      <Ui::EmptyState @icon="server-2" @title="No clients" @message="No clients are available to the job." data-test-empty-clients-list />
    {{/if}}
  </:empty>
</Ui::DataTable>
