{{page-title "Job " this.job.name " evaluations"}}
<Ui::DataTable
  @id="job-evaluations"
  @caption="Evaluations of {{this.job.name}}"
  @columns={{this.columns}}
  @rows={{this.sortedEvaluations}}
  @sortBy={{this.sortProperty}}
  @sortDescending={{this.sortDescending}}
  @onSort={{this.sort}}
>
  <:row as |evaluation r|>
    <r.Row data-test-evaluation={{evaluation.shortId}}>
      <r.Cell @key="id" class="font-monospace" data-test-id>{{evaluation.shortId}}</r.Cell>
      <r.Cell @key="priority" data-test-priority>{{evaluation.priority}}</r.Cell>
      <r.Cell @key="createTime" class="tabular-nums" data-test-create-time>{{format-month-ts evaluation.createTime}}</r.Cell>
      <r.Cell @key="triggeredBy" data-test-triggered-by>{{evaluation.triggeredBy}}</r.Cell>
      <r.Cell @key="status" data-test-status><Ui::StatusIndicator @status={{evaluation.status}} /></r.Cell>
      <r.Cell @key="hasPlacementFailures" data-test-blocked>
        {{#if (eq evaluation.status "blocked")}}
          N/A - In Progress
        {{else if evaluation.hasPlacementFailures}}
          True
        {{else}}
          False
        {{/if}}
      </r.Cell>
    </r.Row>
  </:row>
  <:empty>
    <Ui::EmptyState
      @icon="clipboard-list"
      @title="No evaluations"
      @message="The evaluations of the job have been garbage collected. A new evaluation is created when the job changes."
      data-test-empty-evaluations-list
    />
  </:empty>
</Ui::DataTable>
