{{page-title "Edit template"}}
<PageLayout>
  <Ui::PageHeader
    @breadcrumbs={{array
      (hash label="Jobs" route="jobs.index" id="jobs.index")
      (hash label="Run a job" route="jobs.run" id="jobs.run")
      (hash label="Templates" route="jobs.run.templates" id="jobs.run.templates")
      (hash label="Manage" route="jobs.run.templates.manage" id="jobs.run.templates.manage")
      (hash label=(format-template-label this.model.path) id="jobs.run.templates.template")
    }}
    @title="Edit template"
  >
    <:actions>
      <Ui::ConfirmButton
        @label="Delete"
        @message="Delete the template?"
        @confirmLabel="Yes, Delete Template"
        @isRunning={{this.deleteTemplate.isRunning}}
        @disabled={{cannot "destroy variable" namespace="*"}}
        @disabledReason="Deleting a template needs the destroy variable capability"
        @onConfirm={{perform this.deleteTemplate}}
        data-test-delete
      />
    </:actions>
  </Ui::PageHeader>
  <Ui::PageBody>
    <form autocomplete="off" {{on "submit" this.save}}>
      <Ui::Card>
        <div class="row g-3">
          <div class="col-md">
            <Ui::Field @label="Template name" as |f|>
              <Ui::Input @id={{f.id}} @value={{this.model.path}} @readonly={{true}} data-test-template-name />
            </Ui::Field>
          </div>
          {{#if this.system.shouldShowNamespaces}}
            <div class="col-md-4">
              <Ui::Field @label="Namespace" as |f|>
                <Ui::Input @id={{f.id}} @value={{this.model.namespace}} @readonly={{true}} data-test-namespace-facet />
              </Ui::Field>
            </div>
          {{/if}}
        </div>
        <VariableForm::JobTemplateEditor
          @keyValues={{this.model.keyValues}}
          @updateKeyValue={{this.updateKeyValue}}
        />
        <div class="d-flex flex-wrap gap-2">
          <Ui::Button @type="submit" @variant="primary" data-test-edit-template>Save</Ui::Button>
          <Ui::Button @route="jobs.run.templates" data-test-cancel-template>Cancel</Ui::Button>
        </div>
      </Ui::Card>
    </form>
  </Ui::PageBody>
</PageLayout>
