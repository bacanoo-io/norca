{{page-title "Choose a template"}}
<PageLayout @legacy={{false}}>
  <Ui::PageHeader
    @breadcrumbs={{array
      (hash label="Jobs" route="jobs.index" id="jobs.index")
      (hash label="Run a job" route="jobs.run" id="jobs.run")
      (hash label="Templates" id="jobs.run.templates")
    }}
    @title="Choose a template"
    @subtitle="Select a custom or default job template. You can modify and plan the job before it is submitted."
  >
    <:actions>
      {{#if this.templates.length}}
        <Ui::Button @icon="list-details" @route="jobs.run.templates.manage" data-test-manage-button>Manage</Ui::Button>
        <Ui::Button @icon="plus" @route="jobs.run.templates.new" data-test-create-new-button>Create New Template</Ui::Button>
      {{/if}}
    </:actions>
  </Ui::PageHeader>
  <Ui::PageBody>
    {{#if (eq this.templates.length 0)}}
      <Ui::EmptyState
        @icon="file-text"
        @title="No templates"
        @message="You have no templates to choose from. Create one, or go back to the editor."
        data-test-empty-templates-list-headline
      >
        <div class="d-flex flex-wrap gap-2 justify-content-center">
          <Ui::Button @variant="primary" @icon="plus" @route="jobs.run.templates.new" data-test-create-inline>Create a template</Ui::Button>
          <Ui::Button @icon="arrow-left" @route="jobs.run" data-test-cancel>Back to editor</Ui::Button>
        </div>
      </Ui::EmptyState>
    {{else}}
      <fieldset data-test-template-list>
        <legend class="visually-hidden">Select a template</legend>
        <div class="row row-cards">
          {{#each this.templates as |card|}}
            <div class="col-md-6 col-xl-4">
              <label class="norca-choice-card" data-test-template-card={{format-template-label card.path}}>
                <input
                  type="radio"
                  name="job-template"
                  class="norca-choice-input"
                  id={{card.id}}
                  checked={{eq card.id this.selectedTemplate}}
                  {{on "change" this.onChange}}
                />
                <span class="norca-choice-body">
                  <span class="fw-medium d-block" data-test-template-label>{{format-template-label card.path}}</span>
                  <span class="text-secondary small d-block" data-test-template-description>{{card.items.description}}</span>
                </span>
              </label>
            </div>
          {{/each}}
        </div>
      </fieldset>
      <div class="d-flex flex-wrap gap-2 mt-3">
        <Ui::Button
          @variant="primary"
          @route="jobs.run"
          @query={{hash template=this.selectedTemplate}}
          @disabled={{is-equal this.selectedTemplate null}}
          data-test-apply
        >Apply</Ui::Button>
        <Ui::Button @route="jobs.run" data-test-cancel>Cancel</Ui::Button>
      </div>
    {{/if}}
  </Ui::PageBody>
</PageLayout>
