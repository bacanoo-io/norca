<Ui::PageHeader @breadcrumbs={{this.variableController.breadcrumbItems}}>
  <:title>
    <span class="d-inline-flex flex-wrap align-items-center gap-2" data-test-variable-title>
      <Ui::Icon @name="file-text" />
      <span class="font-monospace">{{this.model.path}}</span>
      <Ui::CopyButton @text={{this.model.path}} @label="Copy the path" />
    </span>
  </:title>
  <:actions>
    <Ui::Switch
      @switch={{true}}
      @label="JSON"
      @checked={{eq this.view "json"}}
      @onChange={{this.toggleView}}
      class="mb-0 me-2"
      data-test-memory-toggle
      {{keyboard-shortcut label="Toggle View (JSON/List)" pattern=(array "j") action=this.toggleView}}
    />
    {{#unless this.isDeleting}}
      {{#if (can "write variable" path=this.model.path namespace=this.model.namespace)}}
        <Ui::Button
          @icon="pencil"
          @route="variables.variable.edit"
          @model={{this.model}}
          @query={{hash view=this.view}}
          data-test-edit-button
          {{autofocus}}
        >Edit</Ui::Button>
      {{/if}}
    {{/unless}}
    {{#if (can "destroy variable" path=this.model.path namespace=this.model.namespace)}}
      <Ui::ConfirmButton
        @label="Delete"
        @icon="trash"
        @message="Are you sure you want to delete this variable and all its items?"
        @confirmLabel="Yes, delete"
        @cancelLabel="Cancel"
        @isRunning={{this.deleteVariableFile.isRunning}}
        @onConfirm={{perform this.deleteVariableFile}}
        @onPrompt={{this.onDeletePrompt}}
        @onCancel={{this.onDeleteCancel}}
        data-test-delete-button
      />
    {{/if}}
  </:actions>
</Ui::PageHeader>

<Ui::PageBody>
  {{#if this.shouldShowLinkedEntities}}
    <VariableForm::RelatedEntities
      @job={{this.model.pathLinkedEntities.job}}
      @group={{this.model.pathLinkedEntities.group}}
      @task={{this.model.pathLinkedEntities.task}}
      @namespace={{or this.model.namespace "default"}}
    />
  {{/if}}

  {{#if (eq this.view "json")}}
    <Ui::Card @title="Key/value data" @flush={{true}}>
      <:actions>
        <Ui::CopyButton @text={{stringify-object this.model.items}} @label="Copy the items as JSON" />
      </:actions>
      <:default>
        <JsonViewer @json={{this.model.items}} />
      </:default>
    </Ui::Card>
  {{else}}
    <Ui::Table
      @caption="Items of {{this.model.path}}"
      @columns={{this.itemColumns}}
      @rows={{this.sortedKeyValues}}
      @sortBy={{this.sortProperty}}
      @sortDescending={{this.sortDescending}}
      @onSort={{this.sort}}
      class="norca-variable-items"
      data-test-variable-items
      as |item|
    >
      <td class="font-monospace text-break" data-test-var={{item.key}}>{{item.key}}</td>
      <td>
        <span class="d-flex align-items-center gap-1">
          <Ui::CopyButton @text={{item.value}} @label="Copy the value of {{item.key}}" />
          <Ui::Button
            @size="sm"
            @variant="ghost"
            @icon={{if item.isVisible "eye" "eye-off"}}
            @iconOnly={{true}}
            @label={{if item.isVisible "Hide Value" "Show Value"}}
            aria-pressed={{if item.isVisible "true" "false"}}
            data-test-toggle-value
            {{on "click" (fn this.toggleRowVisibility item)}}
            {{keyboard-shortcut label="Toggle Variable Visibility" pattern=(array "v") action=(fn this.toggleRowVisibility item)}}
          />
          {{#if item.isVisible}}
            <code class="text-break" data-test-var-value-shown>{{item.value}}</code>
          {{else}}
            <span aria-label="Hidden value">********</span>
          {{/if}}
        </span>
      </td>
    </Ui::Table>
  {{/if}}
</Ui::PageBody>
