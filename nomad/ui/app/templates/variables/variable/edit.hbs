{{page-title "Edit Variable"}}
<Ui::PageHeader @title="Edit {{this.model.path}}" @breadcrumbs={{this.variableController.breadcrumbItems}}>
  <:actions>
    <Ui::Button @variant="ghost" @icon="arrow-left" @route="variables.variable.index" data-test-back-link>Back to {{this.model.path}}</Ui::Button>
    <Ui::Switch
      @switch={{true}}
      @label="JSON"
      @checked={{eq this.view "json"}}
      @onChange={{this.toggleView}}
      class="mb-0"
      data-test-json-toggle
    />
  </:actions>
</Ui::PageHeader>
<Ui::PageBody>
  <VariableForm @model={{this.model}} @existingVariables={{this.existingVariables}} @view={{this.view}} />
</Ui::PageBody>
