{{page-title "Variables: " this.absolutePath}}
<Ui::PageHeader @title={{concat "/" this.absolutePath}} @breadcrumbs={{this.breadcrumbItems}}>
  <:actions>
    {{#if this.namespaceOptions}}
      <Ui::Select
        @label="Namespace"
        @options={{this.namespaceOptions}}
        @value={{this.namespaceSelection}}
        @onChange={{this.setNamespace}}
        class="w-auto"
        data-test-variable-namespace-filter
      />
    {{/if}}
    {{#if (can "write variable" path=(concat this.absolutePath "/") namespace=this.namespaceSelection)}}
      <Ui::Button
        @variant="primary"
        @icon="plus"
        @route="variables.new"
        @query={{hash path=(concat this.absolutePath "/")}}
        data-test-create-var
        {{keyboard-shortcut pattern=(array "n" "v") action=this.goToNewVariable label="Create Variable"}}
      >Create Variable</Ui::Button>
    {{else}}
      <Ui::Tooltip @text="You don’t have sufficient permissions">
        <Ui::Button @variant="primary" @icon="plus" @disabled={{true}} data-test-disabled-create-var>Create Variable</Ui::Button>
      </Ui::Tooltip>
    {{/if}}
  </:actions>
</Ui::PageHeader>
<Ui::PageBody>
  {{#if this.isForbidden}}
    <ForbiddenMessage />
  {{else if this.model.treeAtPath}}
    <VariablePaths @branch={{this.model.treeAtPath}} />
  {{else if (eq this.namespaceSelection "*")}}
    <Ui::EmptyState @icon="lock" @title="Path /{{this.absolutePath}} contains no variables" data-test-empty-variables-list>
      <p class="text-secondary">
        To get started,
        <LinkTo @route="variables.new" @query={{hash path=(concat this.absolutePath "/")}}>create a new variable here</LinkTo>,
        or
        <LinkTo @route="variables">go back to the Variables root directory</LinkTo>.
      </p>
    </Ui::EmptyState>
  {{else}}
    <Ui::EmptyState
      @icon="filter-off"
      @title="No Matches"
      @message="No paths or variables match the namespace {{this.namespaceSelection}}"
      data-test-no-matching-variables-list
    />
  {{/if}}
</Ui::PageBody>
