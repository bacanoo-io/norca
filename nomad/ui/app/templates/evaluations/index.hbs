{{page-title "Evaluations"}}
{{did-update this.notifyEvalChange this.currentEval}}
<Ui::PageHeader @pretitle="Operations" @title="Evaluations" @subtitle="The scheduler's decisions: what triggered them and how they ended">
  <:actions>
    <Ui::Button @icon="refresh" data-test-eval-refresh {{on "click" this.refresh}}>Refresh</Ui::Button>
  </:actions>
</Ui::PageHeader>
<Ui::PageBody>
  <Ui::DataTable
    @id="evaluations"
    @caption="Evaluations"
    @columns={{this.columns}}
    @rows={{@model}}
    @onRowClick={{this.openEvaluation}}
    @enumerate={{true}}
    data-test-eval-table
  >
    <:filters>
      <Ui::Input
        @type="search"
        @icon="search"
        @placeholder="Search evaluations..."
        @value={{this.searchTerm}}
        @onInput={{this.search}}
        aria-label="Search evaluations"
        data-test-evaluations-search
      />
      <Ui::Select
        @label="Namespace"
        @options={{this.namespaceSelectOptions}}
        @value={{this.qpNamespace}}
        @onChange={{fn this.setQueryParam "qpNamespace"}}
        class="w-auto"
        data-test-evaluation-namespace-facet
      />
      <Ui::Select
        @label="Status"
        @options={{this.statusSelectOptions}}
        @value={{or this.status ""}}
        @onChange={{fn this.setQueryParam "status"}}
        class="w-auto"
        data-test-evaluation-status-facet
      />
      <Ui::Select
        @label="Triggered by"
        @options={{this.triggeredBySelectOptions}}
        @value={{or this.triggeredBy ""}}
        @onChange={{fn this.setQueryParam "triggeredBy"}}
        class="w-auto"
        data-test-evaluation-triggered-by-facet
      />
      <Ui::Select
        @label="Type"
        @options={{this.typeSelectOptions}}
        @value={{or this.type ""}}
        @onChange={{fn this.setQueryParam "type"}}
        class="w-auto"
        data-test-evaluation-type-facet
      />
    </:filters>
    <:row as |evaluation r|>
      <r.Row
        @active={{eq this.currentEval evaluation.id}}
        data-test-evaluation={{evaluation.shortId}}
        data-eval-row
        data-side-panel-trigger
      >
        <r.Cell @key="id" class="font-monospace" data-test-id>{{evaluation.shortId}}</r.Cell>
        <r.Cell @key="resource" data-test-id>
          {{#if evaluation.hasJob}}
            <LinkTo
              data-test-evaluation-resource
              @model={{concat evaluation.plainJobId "@" evaluation.namespace}}
              @route="jobs.job"
            >{{evaluation.plainJobId}}</LinkTo>
          {{else}}
            <LinkTo
              data-test-evaluation-resource
              @model={{evaluation.nodeId}}
              @route="clients.client"
              class="font-monospace"
            >{{evaluation.shortNodeId}}</LinkTo>
          {{/if}}
        </r.Cell>
        <r.Cell @key="priority" class="tabular-nums" data-test-priority>{{evaluation.priority}}</r.Cell>
        <r.Cell @key="created" class="tabular-nums text-nowrap" data-test-create-time>{{format-month-ts evaluation.createTime}}</r.Cell>
        <r.Cell @key="triggeredBy" data-test-triggered-by>{{evaluation.triggeredBy}}</r.Cell>
        <r.Cell @key="status" class="text-nowrap" data-test-status>
          <Ui::StatusIndicator @status={{evaluation.status}} />
        </r.Cell>
        <r.Cell @key="placementFailures" data-test-blocked>
          {{#if (eq evaluation.status "blocked")}}
            N/A - In Progress
          {{else if evaluation.hasPlacementFailures}}
            True
          {{else}}
            False
          {{/if}}
        </r.Cell>
      </r.Row>
    </:row>
    <:empty>
      {{#if this.hasFiltersApplied}}
        <Ui::EmptyState
          @icon="filter-off"
          @title="No Matches"
          data-test-empty-evaluations-list
        >
          <p class="text-secondary" data-test-no-eval-match>
            No evaluations that match: <strong>{{this.noMatchText}}</strong>
            Change the filters to see more evaluations.
          </p>
        </Ui::EmptyState>
      {{else}}
        <Ui::EmptyState
          @icon="list-details"
          @title="No Evaluations"
          data-test-empty-evaluations-list
        >
          <p class="text-secondary" data-test-no-eval>
            There are no evaluations. The scheduler creates one whenever a job,
            a client or a deployment changes.
          </p>
        </Ui::EmptyState>
      {{/if}}
    </:empty>
    <:footer>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <label class="small text-secondary" for="evaluations-page-size">Per page</label>
        <Ui::Select
          @id="evaluations-page-size"
          @size="sm"
          @options={{this.pageSizeOptions}}
          @value={{this.pageSize}}
          @onChange={{this.changePageSize}}
          class="w-auto"
          data-test-per-page
        />
        <div class="d-flex gap-1 ms-auto">
          <Ui::Button
            @size="sm"
            @icon="chevron-left"
            @iconOnly={{true}}
            @label="Previous page"
            @disabled={{this.shouldDisablePrev}}
            data-test-eval-pagination-prev
            {{on "click" (fn this.onPrev this.lastToken)}}
          />
          <Ui::Button
            @size="sm"
            @icon="chevron-right"
            @iconOnly={{true}}
            @label="Next page"
            @disabled={{this.shouldDisableNext}}
            data-test-eval-pagination-next
            {{on "click" (fn this.onNext @model.meta.nextToken)}}
          />
        </div>
      </div>
    </:footer>
  </Ui::DataTable>
</Ui::PageBody>
<EvaluationSidebar::Detail
  @statechart={{this.statechart}}
  @fns={{hash
    closeSidebar=this.closeSidebar
    handleEvaluationClick=this.handleEvaluationClick
  }}
/>
