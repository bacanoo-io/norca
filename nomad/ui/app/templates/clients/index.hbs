{{page-title "Clients"}}
<Ui::PageHeader @title="Clients" @breadcrumbs={{array (hash label="Clients")}} />
<Ui::PageBody>
  {{#if this.isForbidden}}
    <ForbiddenMessage />
  {{else}}
    <Ui::DataTable
      @id="clients"
      @caption="Clients"
      @columns={{this.columns}}
      @rows={{this.sortedNodes}}
      @sortBy={{this.sortProperty}}
      @sortDescending={{this.sortDescending}}
      @onSort={{this.sort}}
      @pageSize={{this.pageSize}}
      @page={{this.currentPage}}
      @onPageChange={{this.setPage}}
      @onPageSizeChange={{this.setPageSize}}
      @onRowClick={{this.gotoNode}}
      @enumerate={{true}}
      @noun="clients"
      @viewState={{this.viewState}}
      @onApplyView={{this.applyView}}
    >
      <:filters>
        {{#if this.nodes.length}}
          <Ui::Input
            @type="search"
            @icon="search"
            @placeholder="Search clients..."
            @value={{this.searchTerm}}
            @onInput={{this.search}}
            aria-label="Search clients"
            data-test-clients-search
          />
        {{/if}}
        <Ui::FilterDropdown
          @label="State"
          @options={{this.optionsState}}
          @selection={{this.selectionState}}
          @onSelect={{fn this.setFilter "qpState"}}
          data-test-state-facet
        />
        <Ui::FilterDropdown
          @label="Node Pool"
          @options={{this.optionsNodePool}}
          @selection={{this.selectionNodePool}}
          @onSelect={{fn this.setFilter "qpNodePool"}}
          data-test-node-pool-facet
        />
        <Ui::FilterDropdown
          @label="Class"
          @options={{this.optionsClass}}
          @selection={{this.selectionClass}}
          @onSelect={{fn this.setFilter "qpClass"}}
          data-test-class-facet
        />
        <Ui::FilterDropdown
          @label="Datacenter"
          @options={{this.optionsDatacenter}}
          @selection={{this.selectionDatacenter}}
          @onSelect={{fn this.setFilter "qpDatacenter"}}
          data-test-datacenter-facet
        />
        <Ui::FilterDropdown
          @label="Version"
          @options={{this.optionsVersion}}
          @selection={{this.selectionVersion}}
          @onSelect={{fn this.setFilter "qpVersion"}}
          data-test-version-facet
        />
        <Ui::FilterDropdown
          @label="Volume"
          @options={{this.optionsVolume}}
          @selection={{this.selectionVolume}}
          @onSelect={{fn this.setFilter "qpVolume"}}
          data-test-volume-facet
        />
      </:filters>
      <:row as |node r|>
        <Clients::ListRow @node={{node}} @r={{r}} />
      </:row>
      <:empty>
        {{#if (eq this.nodes.length 0)}}
          <Ui::EmptyState
            @icon="server"
            @title="No Clients"
            @message="The cluster currently has no client nodes."
            data-test-empty-clients-list
          />
        {{else if (eq this.filteredNodes.length 0)}}
          <Ui::EmptyState
            @icon="filter-off"
            @title="No Matches"
            @message="No clients match your current filter selection."
            data-test-empty-clients-list
          />
        {{else}}
          <Ui::EmptyState
            @icon="filter-off"
            @title="No Matches"
            @message="No clients match the term {{this.searchTerm}}"
            data-test-empty-clients-list
          />
        {{/if}}
      </:empty>
    </Ui::DataTable>
  {{/if}}
</Ui::PageBody>
