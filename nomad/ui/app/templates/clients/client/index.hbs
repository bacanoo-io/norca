{{page-title "Client " (or this.model.name this.model.shortId)}}
<Clients::Header @client={{this.model}}>
  <Ui::Switch
    @switch={{true}}
    @label="Eligible"
    @checked={{this.model.isEligible}}
    @disabled={{or this.setEligibility.isRunning this.model.isDraining (cannot "write client")}}
    @onChange={{perform this.setEligibility}}
    title="Only eligible clients can receive allocations"
    class="mb-0 me-2"
    data-test-eligibility-toggle
  />
  {{#if this.model.isDraining}}
    <Ui::ConfirmButton
      @label="Stop Drain"
      @icon="player-stop"
      @message="Are you sure you want to stop this drain?"
      @confirmLabel="Yes, Stop Drain"
      @cancelLabel="Cancel"
      @isRunning={{this.stopDrain.isRunning}}
      @onConfirm={{perform this.stopDrain}}
      data-test-drain-stop
    />
  {{/if}}
  <Clients::DrainButton
    @client={{this.model}}
    @isDisabled={{cannot "write client"}}
    @onDrain={{this.drainNotify}}
    @onError={{this.setDrainError}}
  />
</Clients::Header>

<Ui::PageBody>
  <Clients::Tabs @client={{this.model}} />

  {{#if this.eligibilityError}}
    <Ui::Alert @tone="danger" @onDismiss={{fn (mut this.eligibilityError) ""}} class="mb-3" data-test-eligibility-error>
      <strong class="d-block" data-test-title>Eligibility Error</strong>
      <span data-test-message>{{this.eligibilityError}}</span>
    </Ui::Alert>
  {{/if}}
  {{#if this.stopDrainError}}
    <Ui::Alert @tone="danger" @onDismiss={{fn (mut this.stopDrainError) ""}} class="mb-3" data-test-stop-drain-error>
      <strong class="d-block" data-test-title>Stop Drain Error</strong>
      <span data-test-message>{{this.stopDrainError}}</span>
    </Ui::Alert>
  {{/if}}
  {{#if this.drainError}}
    <Ui::Alert @tone="danger" @onDismiss={{fn (mut this.drainError) ""}} class="mb-3" data-test-drain-error>
      <strong class="d-block" data-test-title>Drain Error</strong>
      <span data-test-message>{{this.drainError}}</span>
    </Ui::Alert>
  {{/if}}
  {{#if this.showDrainStoppedNotification}}
    <Ui::Alert @tone="info" @onDismiss={{fn (mut this.showDrainStoppedNotification) false}} class="mb-3" data-test-drain-stopped-notification>
      <strong class="d-block" data-test-title>Drain Stopped</strong>
      <span data-test-message>The drain has been stopped and the node has been set to ineligible.</span>
    </Ui::Alert>
  {{/if}}
  {{#if this.showDrainUpdateNotification}}
    <Ui::Alert @tone="info" @onDismiss={{fn (mut this.showDrainUpdateNotification) false}} class="mb-3" data-test-drain-updated-notification>
      <strong class="d-block" data-test-title>Drain Updated</strong>
      <span data-test-message>The new drain specification has been applied.</span>
    </Ui::Alert>
  {{/if}}
  {{#if this.showDrainNotification}}
    <Ui::Alert @tone="info" @onDismiss={{fn (mut this.showDrainNotification) false}} class="mb-3" data-test-drain-complete-notification>
      <strong class="d-block" data-test-title>Drain Complete</strong>
      <span data-test-message>Allocations have been drained and the node has been set to ineligible.</span>
    </Ui::Alert>
  {{/if}}

  <Ui::Card class="mb-3" data-test-client-details>
    <Ui::Datagrid as |g|>
      <g.Item @title="Status">
        <span data-test-status-definition>
          <Ui::StatusIndicator @status={{this.model.status}} />
        </span>
      </g.Item>
      <g.Item @title="Address"><span class="font-monospace" data-test-address-definition>{{this.model.httpAddr}}</span></g.Item>
      <g.Item @title="Datacenter"><span data-test-datacenter-definition>{{this.model.datacenter}}</span></g.Item>
      <g.Item @title="Node pool"><span data-test-node-pool>{{or this.model.nodePool "-"}}</span></g.Item>
      {{#if this.model.nodeClass}}
        <g.Item @title="Class"><span data-test-node-class>{{this.model.nodeClass}}</span></g.Item>
      {{/if}}
      <g.Item @title="Version">
        <span data-test-version-definition>
          {{#if this.model.norcaVersion}}Norca {{this.model.norcaVersion}}{{else}}Nomad {{this.model.version}}{{/if}}
        </span>
      </g.Item>
      <g.Item @title="Drivers">
        <span data-test-driver-health>
          {{#if this.model.unhealthyDrivers.length}}
            <Ui::Icon @name="alert-triangle" class="text-warning" />
            {{this.model.unhealthyDrivers.length}}
            of
            {{this.model.detectedDrivers.length}}
            {{pluralize "driver" this.model.detectedDrivers.length}}
            unhealthy
          {{else}}
            All healthy
          {{/if}}
        </span>
      </g.Item>
    </Ui::Datagrid>
  </Ui::Card>

  {{#if this.model.drainStrategy}}
    <Clients::DrainDetails @client={{this.model}} @onForce={{perform this.forceDrain}} @isForcing={{this.forceDrain.isRunning}} />
  {{/if}}

  <Ui::Card @title="Host resource utilization" @subtitle="All allocation and system processes aggregated" class="mb-3">
    <div class="row g-3">
      <div class="col-md-6">
        <PrimaryMetric::Node @node={{this.model}} @metric="cpu" />
      </div>
      <div class="col-md-6">
        <PrimaryMetric::Node @node={{this.model}} @metric="memory" />
      </div>
    </div>
  </Ui::Card>

  <h2 class="h3 mb-2">Allocations</h2>
  <Allocations::Table
    @id="client-allocations"
    @caption="Allocations on {{or this.model.name this.model.shortId}}"
    @context="node"
    @allocations={{this.sortedAllocations}}
    @presorted={{true}}
    @sortBy={{this.sortProperty}}
    @sortDescending={{this.sortDescending}}
    @onSort={{this.sort}}
    @pageSize={{this.pageSize}}
    @page={{this.currentPage}}
    @onPageChange={{this.setPage}}
    @onPageSizeChange={{this.setPageSize}}
    @activeTask={{this.activeTask}}
    @onSetActiveTask={{this.setActiveTaskQueryParam}}
    @viewState={{this.viewState}}
    @onApplyView={{this.applyView}}
    class="mb-3"
  >
    <:filters>
      <span class="d-inline-flex gap-1" role="group" aria-label="Allocations to show">
        <Ui::Button
          @size="sm"
          @variant={{if this.onlyPreemptions "secondary" "primary"}}
          aria-pressed={{if this.onlyPreemptions "false" "true"}}
          data-test-filter-all
          {{on "click" (fn this.setPreemptionFilter false)}}
        >{{this.model.allocations.length}}</Ui::Button>
        {{#if this.preemptions.length}}
          <Ui::Button
            @size="sm"
            @variant={{if this.onlyPreemptions "warning" "secondary"}}
            aria-pressed={{if this.onlyPreemptions "true" "false"}}
            data-test-filter-preemptions
            {{on "click" (fn this.setPreemptionFilter true)}}
          >{{this.preemptions.length}} {{pluralize "preemption" this.preemptions.length}}</Ui::Button>
        {{/if}}
      </span>
      <Ui::Input
        @type="search"
        @icon="search"
        @placeholder="Search allocations..."
        @value={{this.searchTerm}}
        @onInput={{this.search}}
        aria-label="Search allocations"
        data-test-allocations-search
      />
      <Ui::FilterDropdown
        @label="Namespace"
        @options={{this.optionsNamespace}}
        @selection={{this.selectionNamespace}}
        @onSelect={{fn this.setFilter "qpNamespace"}}
        data-test-allocation-namespace-facet
      />
      <Ui::FilterDropdown
        @label="Job"
        @options={{this.optionsJob}}
        @selection={{this.selectionJob}}
        @onSelect={{fn this.setFilter "qpJob"}}
        data-test-allocation-job-facet
      />
      <Ui::FilterDropdown
        @label="Status"
        @options={{this.optionsAllocationStatus}}
        @selection={{this.selectionStatus}}
        @onSelect={{fn this.setFilter "qpStatus"}}
        data-test-allocation-status-facet
      />
    </:filters>
    <:empty>
      {{#if (eq this.visibleAllocations.length 0)}}
        <Ui::EmptyState
          @icon="box"
          @title="No Allocations"
          @message="The node doesn't have any allocations."
          data-test-empty-allocations-list
        />
      {{else if this.searchTerm}}
        <Ui::EmptyState
          @icon="filter-off"
          @title="No Matches"
          @message="No allocations match the term {{this.searchTerm}}"
          data-test-empty-allocations-list
        />
      {{else}}
        <Ui::EmptyState
          @icon="filter-off"
          @title="No Matches"
          @message="No allocations match your current filter selection."
          data-test-empty-allocations-list
        />
      {{/if}}
    </:empty>
  </Allocations::Table>

  <h2 class="h3 mb-2">Client events</h2>
  <Ui::Table
    @caption="Client events"
    @columns={{this.eventColumns}}
    @rows={{this.sortedEvents}}
    @striped={{true}}
    class="mb-3"
    data-test-client-events
    as |event|
  >
    <td class="text-nowrap tabular-nums" data-test-client-event-time>{{format-ts event.time}}</td>
    <td data-test-client-event-subsystem>{{event.subsystem}}</td>
    <td data-test-client-event-message>
      {{#if event.message}}
        {{#if event.driver}}
          <Ui::Badge @color="secondary">{{event.driver}}</Ui::Badge>
        {{/if}}
        {{event.message}}
      {{else}}
        <em class="text-secondary">No message</em>
      {{/if}}
    </td>
  </Ui::Table>

  {{#if this.sortedHostVolumes.length}}
    <h2 class="h3 mb-2">Host volumes</h2>
    <Ui::Table
      @caption="Host volumes"
      @columns={{this.hostVolumeColumns}}
      @rows={{this.sortedHostVolumes}}
      @striped={{true}}
      class="mb-3"
      data-test-client-host-volumes
      as |volume|
    >
      <td data-test-name>{{volume.name}}</td>
      <td data-test-path><code>{{volume.path}}</code></td>
      <td data-test-permissions>{{if volume.readOnly "Read" "Read/Write"}}</td>
    </Ui::Table>
  {{/if}}

  <Clients::DriverList @drivers={{this.sortedDrivers}} class="mb-3" />

  <Ui::Card @title="Attributes" @flush={{true}} class="mb-3">
    <Ui::KeyValueTable @data={{this.model.attributes.structured}} @caption="Attributes of the client" data-test-attributes />
  </Ui::Card>

  <Ui::Card @title="Meta" @flush={{true}} class="mb-3">
    <:actions>
      {{#if (can "write client")}}
        <span data-test-add-dynamic-metadata>
          <Ui::Button
            @size="sm"
            @icon="plus"
            @variant={{if this.editingMetadata "secondary" "primary"}}
            aria-expanded={{if this.editingMetadata "true" "false"}}
            data-test-add-metadata-toggle
            {{on "click" this.toggleEditingMetadata}}
            {{keyboard-shortcut
              label="Add Dynamic Node Metadata"
              pattern=(array "m" "e" "t" "a")
              action=this.startEditingMetadata
            }}
          >Add new Dynamic Metadata</Ui::Button>
        </span>
      {{/if}}
    </:actions>
    <:default>
      {{#if (and (can "write client") this.editingMetadata)}}
        <form class="d-flex flex-wrap align-items-end gap-2 p-3" data-test-new-metadata-form {{on "submit" this.submitNewMetaData}}>
          <div>
            <label class="small text-secondary d-block" for="new-meta-key">Key</label>
            <Ui::Input @id="new-meta-key" @value={{this.newMetaData.key}} @onInput={{this.setNewMetaKey}} {{on "keyup" this.validateMetadata}} />
          </div>
          <div class="flex-fill">
            <label class="small text-secondary d-block" for="new-meta-value">Value</label>
            <Ui::Input
              @id="new-meta-value"
              @value={{this.newMetaData.value}}
              @onInput={{this.setNewMetaValue}}
              data-test-metadata-editor-value
              {{on "keyup" this.validateMetadata}}
            />
          </div>
          <Ui::Button
            @variant="primary"
            @type="submit"
            @disabled={{or (not this.newMetaData.key) (not this.newMetaData.value)}}
            data-test-new-metadata-button
          >Add {{this.newMetaData.key}} to node metadata</Ui::Button>
          <Ui::Button @variant="ghost" {{on "click" this.cancelNewMetaData}}>Cancel</Ui::Button>
        </form>
      {{/if}}
      {{#if this.hasMeta}}
        <Ui::KeyValueTable
          @data={{this.model.meta.structured}}
          @caption="Meta of the client"
          @editable={{can "write client"}}
          @onKVSave={{this.addDynamicMetaData}}
          data-test-meta
        />
      {{else}}
        <Ui::EmptyState
          @compact={{true}}
          @icon="list-details"
          @title="No Meta Attributes"
          @message="This client is configured with no meta attributes."
          data-test-empty-meta-message
        />
      {{/if}}
    </:default>
  </Ui::Card>
</Ui::PageBody>
