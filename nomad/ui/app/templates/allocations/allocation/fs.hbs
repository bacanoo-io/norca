{{page-title this.pathWithLeadingSlash " -  Allocation " this.allocation.shortId " filesystem"}}
<Allocations::Header @allocation={{this.allocation}} />
<Ui::PageBody>
  <Allocations::Tabs @allocation={{this.allocation}} />
  <Fs::Browser
    @model={{this.allocation}}
    @path={{this.path}}
    @stat={{this.stat}}
    @isFile={{this.isFile}}
    @directoryEntries={{this.directoryEntries}}
    @sortProperty={{this.sortProperty}}
    @sortDescending={{this.sortDescending}}
    @onSort={{this.sort}}
  />
</Ui::PageBody>
