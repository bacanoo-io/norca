{{page-title "Task " this.model.name}}
<Allocations::Header @allocation={{this.model.allocation}} @task={{this.model}}>
  {{#if this.model.isRunning}}
    <Exec::OpenButton
      @job={{this.model.task.taskGroup.job}}
      @taskGroup={{this.model.task.taskGroup}}
      @allocation={{this.model.allocation}}
      @task={{this.model.task}}
    />
    <Ui::ConfirmButton
      @label="Restart Task"
      @icon="refresh"
      @variant="warning"
      @idleVariant="secondary"
      @message="Are you sure? This will restart the task in-place."
      @confirmLabel="Yes, Restart Task"
      @cancelLabel="Cancel"
      @isRunning={{this.restartTask.isRunning}}
      @disabled={{this.restartTask.isRunning}}
      @onConfirm={{perform this.restartTask}}
      data-test-restart
    />
  {{/if}}
</Allocations::Header>

<Ui::PageBody>
  <Allocations::Tabs @allocation={{this.model.allocation}} @task={{this.model}} />

  {{#if this.error}}
    <Ui::Alert @tone="danger" @onDismiss={{action this.onDismiss}} class="mb-3" data-test-inline-error>
      <strong class="d-block" data-test-inline-error-title>{{this.error.title}}</strong>
      <span data-test-inline-error-body>{{this.error.description}}</span>
    </Ui::Alert>
  {{/if}}

  <Ui::Card class="mb-3" data-test-task-details>
    <Ui::Datagrid as |g|>
      <g.Item @title="Started at"><span data-test-started-at>{{format-ts this.model.startedAt}}</span></g.Item>
      {{#if this.model.finishedAt}}
        <g.Item @title="Finished at"><span data-test-finished-at>{{format-ts this.model.finishedAt}}</span></g.Item>
      {{/if}}
      <g.Item @title="Driver">{{this.model.task.driver}}</g.Item>
      <g.Item @title="Lifecycle"><span data-test-lifecycle>{{this.model.task.lifecycleName}}</span></g.Item>
      <g.Item @title="Namespace">{{this.model.allocation.job.namespace.name}}</g.Item>
      {{#if (and (can "list variables") this.model.task.pathLinkedVariable)}}
        <g.Item @title="Variables">
          <span data-test-task-stat="variables">
            <LinkTo @route="variables.variable" @model={{this.model.task.pathLinkedVariable.id}}>Variables</LinkTo>
          </span>
        </g.Item>
      {{/if}}
    </Ui::Datagrid>
  </Ui::Card>

  <Ui::Card @title="Resource utilization" class="mb-3" data-test-resource-utilization>
    {{#if this.model.isRunning}}
      <div class="row g-3">
        <div class="col-md-6">
          <PrimaryMetric::Task @taskState={{this.model}} @metric="cpu" />
        </div>
        <div class="col-md-6">
          <PrimaryMetric::Task @taskState={{this.model}} @metric="memory" />
        </div>
      </div>
    {{else}}
      <Ui::EmptyState
        @compact={{true}}
        @icon="activity"
        @title="Task isn't running"
        @message="Only running tasks utilize resources."
        data-test-resource-error
      />
    {{/if}}
  </Ui::Card>

  {{#if this.model.task.volumeMounts.length}}
    <h2 class="h3 mb-2">Volumes</h2>
    <Ui::Table
      @caption="Volumes of the task"
      @columns={{this.volumeColumns}}
      @rows={{this.model.task.volumeMounts}}
      class="mb-3"
      data-test-volumes
      as |volume|
    >
      <td data-test-volume-name>{{volume.volume}}</td>
      <td data-test-volume-destination><code>{{volume.destination}}</code></td>
      <td data-test-volume-permissions>{{if volume.readOnly "Read" "Read/Write"}}</td>
      <td data-test-volume-client-source>
        {{#if volume.isCSI}}
          <LinkTo
            @route="csi.volumes.volume"
            @model={{concat
              (format-volume-name
                source=volume.source
                isPerAlloc=volume.volumeDeclaration.perAlloc
                volumeExtension=this.model.allocation.volumeExtension
              )
              "@"
              volume.namespace.id
            }}
          >
            {{format-volume-name
              source=volume.source
              isPerAlloc=volume.volumeDeclaration.perAlloc
              volumeExtension=this.model.allocation.volumeExtension
            }}
          </LinkTo>
        {{else}}
          {{volume.source}}
        {{/if}}
      </td>
    </Ui::Table>
  {{/if}}

  <h2 class="h3 mb-2">Recent events</h2>
  <Ui::Table
    @caption="Recent events of the task"
    @columns={{this.eventColumns}}
    @rows={{reverse this.model.events}}
    @striped={{true}}
    data-test-task-events
    as |event|
  >
    <td class="text-nowrap tabular-nums" data-test-task-event-time>{{format-ts event.time}}</td>
    <td class="text-nowrap" data-test-task-event-type>{{event.type}}</td>
    <td data-test-task-event-message>
      {{#if event.message}}
        {{event.message}}
      {{else}}
        <em class="text-secondary">No message</em>
      {{/if}}
    </td>
  </Ui::Table>
</Ui::PageBody>
