{{page-title "Allocation " this.model.name}}
<Allocations::Header @allocation={{this.model}} @tab="overview">
  {{#if this.model.isRunning}}
    <Exec::OpenButton @job={{this.model.job}} @allocation={{this.model}} />
    <Ui::ConfirmButton
      @label="Stop Alloc"
      @icon="player-stop"
      @message="Are you sure? This will reschedule the allocation on a different client."
      @confirmLabel="Yes, Stop Alloc"
      @cancelLabel="Cancel Stop"
      @isRunning={{this.stopAllocation.isRunning}}
      @disabled={{or this.stopAllocation.isRunning this.restartAllocation.isRunning}}
      @onConfirm={{perform this.stopAllocation}}
      data-test-stop
    />
    <Ui::ConfirmButton
      @label="Restart Alloc"
      @icon="refresh"
      @variant="warning"
      @idleVariant="secondary"
      @message="Are you sure? This will restart the tasks that are currently running in-place."
      @confirmLabel="Yes, Restart Alloc"
      @cancelLabel="Cancel Restart"
      @isRunning={{this.restartAllocation.isRunning}}
      @disabled={{or this.stopAllocation.isRunning this.restartAllocation.isRunning}}
      @onConfirm={{perform this.restartAllocation}}
      data-test-restart
    />
    <Ui::ConfirmButton
      @label="Restart All Tasks"
      @icon="refresh"
      @variant="warning"
      @idleVariant="secondary"
      @message="Are you sure? This will restart all tasks in-place."
      @confirmLabel="Yes, Restart All Tasks"
      @cancelLabel="Cancel Restart"
      @isRunning={{this.restartAllocation.isRunning}}
      @disabled={{or this.stopAllocation.isRunning this.restartAllocation.isRunning}}
      @onConfirm={{perform this.restartAll}}
      data-test-restart-all
    />
  {{/if}}
</Allocations::Header>

<Ui::PageBody>
  <Allocations::Tabs @allocation={{this.model}} />

  {{#if this.error}}
    <Ui::Alert @tone="danger" @onDismiss={{action this.onDismiss}} class="mb-3" data-test-inline-error>
      <strong class="d-block" data-test-inline-error-title>{{this.error.title}}</strong>
      <span data-test-inline-error-body>{{this.error.description}}</span>
    </Ui::Alert>
  {{/if}}

  <Ui::Card class="mb-3" data-test-allocation-details>
    <Ui::Datagrid as |g|>
      <g.Item @title="Job">
        <LinkTo @route="jobs.job" @model={{format-job-id this.model.job.id}} data-test-job-link>{{this.model.job.name}}</LinkTo>
      </g.Item>
      <g.Item @title="Task group">
        <LinkTo @route="jobs.job.task-group" @models={{array (format-job-id this.model.job.id) this.model.taskGroupName}} data-test-task-group-link>
          {{this.model.taskGroupName}}
        </LinkTo>
      </g.Item>
      <g.Item @title="Client">
        <Ui::Tooltip @text={{this.model.node.name}}>
          <LinkTo @route="clients.client" @model={{this.model.node}} class="font-monospace" data-test-client-link>{{this.model.node.shortId}}</LinkTo>
        </Ui::Tooltip>
      </g.Item>
      <g.Item @title="Namespace">{{this.model.job.namespace.name}}</g.Item>
      <g.Item @title="Version">{{this.model.jobVersion}}</g.Item>
    </Ui::Datagrid>
  </Ui::Card>

  <Ui::Card @title="Resource utilization" class="mb-3" data-test-resource-utilization>
    {{#if this.model.isRunning}}
      <div class="row g-3">
        <div class="col-md-6">
          <PrimaryMetric::Allocation @allocation={{this.model}} @metric="cpu" />
        </div>
        <div class="col-md-6">
          <PrimaryMetric::Allocation @allocation={{this.model}} @metric="memory" />
        </div>
      </div>
    {{else}}
      <Ui::EmptyState
        @compact={{true}}
        @icon="activity"
        @title="Allocation isn't running"
        @message="Only running allocations utilize resources."
        data-test-resource-error
      />
    {{/if}}
  </Ui::Card>

  <LifecycleChart @taskStates={{this.model.states}} />

  <h2 class="h3 mb-2">Tasks</h2>
  <Ui::DataTable
    @id="allocation-tasks"
    @caption="Tasks of the allocation"
    @columns={{this.taskColumns}}
    @rows={{this.sortedStates}}
    @rowKey="name"
    @sortBy={{this.taskSortKey}}
    @sortDescending={{this.sortDescending}}
    @onSort={{this.sortTasks}}
    @onRowClick={{this.openTask}}
    @enumerate={{true}}
    class="mb-3"
  >
    <:row as |taskState r|>
      <Allocations::TaskStateRow @taskState={{taskState}} @r={{r}} />
    </:row>
    <:empty>
      <Ui::EmptyState
        @icon="list-details"
        @title="No tasks"
        @message="Allocations will not have tasks until they are in a running state."
        data-test-empty-tasks-list
      />
    </:empty>
  </Ui::DataTable>

  {{#if this.ports.length}}
    <h2 class="h3 mb-2">Ports</h2>
    <Ui::DataTable
      @id="allocation-ports"
      @caption="Ports of the allocation"
      @columns={{this.portColumns}}
      @rows={{this.ports}}
      @rowKey="label"
      @columnPicker={{false}}
      class="mb-3"
      data-test-allocation-ports
    >
      <:row as |port r|>
        <r.Row data-test-allocation-port>
          <r.Cell @key="name" data-test-allocation-port-name>{{port.label}}</r.Cell>
          <r.Cell @key="address" class="font-monospace" data-test-allocation-port-address>
            <a href="http://{{port.hostIp}}:{{port.value}}" target="_blank" rel="noopener noreferrer">{{port.hostIp}}:{{port.value}}</a>
          </r.Cell>
          <r.Cell @key="to" class="font-monospace" data-test-allocation-port-to>{{port.to}}</r.Cell>
        </r.Row>
      </:row>
    </Ui::DataTable>
  {{/if}}

  {{#if this.services.length}}
    <h2 class="h3 mb-2">Services</h2>
    <Ui::DataTable
      @id="allocation-services"
      @caption="Services of the allocation"
      @columns={{this.serviceColumns}}
      @rows={{this.servicesWithHealthChecks}}
      @rowKey="refID"
      @columnPicker={{false}}
      @onRowClick={{this.handleServiceClick}}
      @enumerate={{true}}
      class="mb-3"
      data-test-allocation-services
    >
      <:row as |service r|>
        <r.Row @active={{eq this.activeService service}} data-test-service data-side-panel-trigger>
          <r.Cell @key="provider">
            {{#if (eq service.provider "nomad")}}
              <Ui::Badge @color="green">native</Ui::Badge>
            {{else}}
              <Ui::Badge @color="purple">consul</Ui::Badge>
              {{#if service.connect}}<Ui::Badge @color="secondary" @icon="topology-star-3">connect</Ui::Badge>{{/if}}
            {{/if}}
          </r.Cell>
          <r.Cell @key="name" class="text-break" data-test-service-name>{{service.name}}</r.Cell>
          <r.Cell @key="port" data-test-service-port>{{service.portLabel}}</r.Cell>
          <r.Cell @key="tags" data-test-service-tags>
            {{#each service.tags as |tag|}}<Ui::Badge @color="secondary" class="me-1">{{tag}}</Ui::Badge>{{/each}}
            {{#each service.canary_tags as |tag|}}<Ui::Badge @color="orange" class="me-1">{{tag}}</Ui::Badge>{{/each}}
          </r.Cell>
          <r.Cell @key="health" data-test-service-health>
            {{#if (eq service.provider "nomad")}}
              <Allocations::CheckHealth @status={{service.mostRecentCheckStatus}} />
            {{/if}}
          </r.Cell>
        </r.Row>
      </:row>
    </Ui::DataTable>
  {{/if}}

  {{#if this.model.hasRescheduleEvents}}
    <Ui::Card @title="Reschedule events" class="mb-3" data-test-reschedule-events>
      <RescheduleEventTimeline @allocation={{this.model}} />
    </Ui::Card>
  {{/if}}

  {{#if this.model.wasPreempted}}
    <Ui::Card @title="Preempted by" class="mb-3" data-test-was-preempted>
      {{#if this.preempter}}
        <Ui::Datagrid as |g|>
          <g.Item @title="Status"><span data-test-allocation-status><Ui::StatusIndicator @status={{this.preempter.clientStatus}} /></span></g.Item>
          <g.Item @title="Allocation">
            <span data-test-allocation-name>{{this.preempter.name}}</span>
            <LinkTo @route="allocations.allocation" @model={{this.preempter}} class="font-monospace ms-1" data-test-allocation-id>{{this.preempter.shortId}}</LinkTo>
          </g.Item>
          <g.Item @title="Job"><LinkTo @route="jobs.job" @model={{this.preempter.job}} data-test-job-link>{{this.preempter.job.name}}</LinkTo></g.Item>
          <g.Item @title="Priority"><span data-test-job-priority>{{this.preempter.job.priority}}</span></g.Item>
          <g.Item @title="Client"><LinkTo @route="clients.client" @model={{this.preempter.node}} class="font-monospace" data-test-client-link>{{this.preempter.node.shortId}}</LinkTo></g.Item>
          <g.Item @title="Reserved CPU"><span data-test-allocation-cpu>{{format-scheduled-hertz this.preempter.resources.cpu}}</span></g.Item>
          <g.Item @title="Reserved memory"><span data-test-allocation-memory>{{format-scheduled-bytes this.preempter.resources.memory start="MiB"}}</span></g.Item>
        </Ui::Datagrid>
      {{else}}
        <Ui::EmptyState @compact={{true}} @title="Allocation is gone" @message="This allocation has been stopped and garbage collected." />
      {{/if}}
    </Ui::Card>
  {{/if}}

  {{#if (and this.model.preemptedAllocations.isFulfilled this.model.preemptedAllocations.length)}}
    <div class="mb-3" data-test-preemptions>
      <h2 class="h3 mb-2">Preempted allocations</h2>
      <Allocations::Table
        @id="allocation-preemptions"
        @caption="Allocations preempted by this allocation"
        @context="job"
        @allocations={{this.model.preemptedAllocations}}
        @columnPicker={{false}}
      />
    </div>
  {{/if}}
</Ui::PageBody>

{{#if this.activeService}}
  <Allocations::ServicePanel @service={{this.activeService}} @allocation={{this.model}} @onClose={{this.closeSidebar}} />
{{/if}}
