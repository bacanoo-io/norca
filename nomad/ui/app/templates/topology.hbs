{{page-title "Cluster Topology"}}
<PageLayout>
  <Ui::PageHeader @pretitle="Capacity" @title="Topology" @subtitle={{this.scopeLabel}}>
    <:actions>
      {{#if (cannot "list all jobs")}}
        <Ui::Badge @color="orange" title="Your ACL token may limit your ability to list all allocations" data-test-partial-view>
          Partial view
        </Ui::Badge>
      {{/if}}
      {{#unless this.isForbidden}}
        <Topology::LiveUpdates @onChange={{this.refresh}} />
      {{/unless}}
    </:actions>
  </Ui::PageHeader>
  <Ui::PageBody>
    {{#if this.isForbidden}}
      <ForbiddenMessage />
    {{else}}
      {{#if this.pre09Nodes}}
        <Ui::Alert
          @tone="warning"
          @title="Some Clients Were Filtered"
          @onDismiss={{this.dismissFilteredNodes}}
          class="mb-3"
          data-test-filtered-nodes-warning
        >
          <span data-test-message>
            {{this.pre09Nodes.length}}
            {{if (eq this.pre09Nodes.length 1) "client was" "clients were"}}
            filtered from the topology visualization. This is most likely due to the
            {{pluralize "client" this.pre09Nodes.length}}
            running a version older than Nomad 0.9, which does not report its resources.
            Upgrade the {{pluralize "client" this.pre09Nodes.length}} to include
            {{if (eq this.pre09Nodes.length 1) "it" "them"}}.
          </span>
        </Ui::Alert>
      {{/if}}
      <div class="row g-3">
        <div class="col-lg-4 col-xl-3">
          {{#if this.showPollingNotice}}
            <Ui::Alert
              @tone="info"
              @title="Updates on change"
              @onDismiss={{this.dismissPollingNotice}}
              class="mb-3"
              data-test-polling-notice
            >
              The topology depends on too much data to poll continuously. It reloads
              when the event stream reports a change of a client or an allocation.
            </Ui::Alert>
          {{/if}}
          <Ui::Card @title="Legend" class="mb-3" data-test-topology-legend>
            <h4 class="small text-secondary mb-1">Metrics</h4>
            <dl class="norca-topo-legend mb-3">
              <div><dt>M</dt><dd>Memory</dd></div>
              <div><dt>C</dt><dd>CPU</dd></div>
            </dl>
            <h4 class="small text-secondary mb-1">Allocation status</h4>
            <dl class="norca-topo-legend mb-0">
              <div>
                <dt><span class="norca-topo-swatch norca-topo-swatch-running" aria-hidden="true"></span></dt>
                <dd>Running</dd>
              </div>
              <div>
                <dt><span class="norca-topo-swatch norca-topo-swatch-pending" aria-hidden="true"></span></dt>
                <dd>Starting</dd>
              </div>
            </dl>
          </Ui::Card>
          <Ui::Card data-test-info-panel-title @title={{this.infoPanelTitle}}>
            <div data-test-info-panel>
              {{#if this.activeNode}}
                {{#let this.activeNode.node as |node|}}
                  <div class="norca-topo-metric">
                    <span class="norca-topo-metric-value" data-test-allocations>{{this.activeNode.allocations.length}}</span>
                    <span class="text-secondary">Allocations</span>
                  </div>
                  <Ui::Datagrid @compact={{true}} class="mb-3" as |g|>
                    <g.Item @title="Client">
                      <LinkTo data-test-client-link @route="clients.client" @model={{node}} class="font-monospace">{{node.shortId}}</LinkTo>
                    </g.Item>
                    <g.Item @title="Name"><span data-test-name>{{node.name}}</span></g.Item>
                    <g.Item @title="Address" @monospace={{true}}><span data-test-address>{{node.httpAddr}}</span></g.Item>
                    <g.Item @title="Status"><span data-test-status>{{node.status}}</span></g.Item>
                    <g.Item @title="Draining">
                      <span data-test-draining data-test-accented={{node.isDraining}}>
                        <Ui::StatusIndicator @tone={{if node.isDraining "info" "neutral"}} @label={{if node.isDraining "Yes" "No"}} />
                      </span>
                    </g.Item>
                    <g.Item @title="Eligible">
                      <span data-test-eligible data-test-accented={{not node.isEligible}}>
                        <Ui::StatusIndicator @tone={{if node.isEligible "neutral" "warning"}} @label={{if node.isEligible "Yes" "No"}} />
                      </span>
                    </g.Item>
                  </Ui::Datagrid>
                  <Topology::Utilization
                    @kind="memory"
                    @label="of memory"
                    @value={{this.nodeUtilization.totalMemoryFormatted}}
                    @units={{this.nodeUtilization.totalMemoryUnits}}
                    @percent={{this.nodeUtilization.reservedMemoryPercent}}
                    @reserved={{format-scheduled-bytes this.nodeUtilization.totalReservedMemory}}
                    @total={{format-scheduled-bytes this.nodeUtilization.totalMemory}}
                  />
                  <Topology::Utilization
                    @kind="cpu"
                    @label="of CPU"
                    @value={{this.nodeUtilization.totalCPU}}
                    @units="MHz"
                    @percent={{this.nodeUtilization.reservedCPUPercent}}
                    @reserved={{format-scheduled-hertz this.nodeUtilization.totalReservedCPU}}
                    @total={{format-scheduled-hertz this.nodeUtilization.totalCPU}}
                  />
                {{/let}}
              {{else if this.activeAllocation}}
                <Ui::Datagrid @compact={{true}} class="mb-3" as |g|>
                  <g.Item @title="Allocation">
                    <LinkTo data-test-id @route="allocations.allocation" @model={{this.activeAllocation}} class="font-monospace">
                      {{this.activeAllocation.shortId}}
                    </LinkTo>
                  </g.Item>
                  <g.Item @title="Sibling allocations"><span data-test-sibling-allocs>{{this.siblingAllocations.length}}</span></g.Item>
                  <g.Item @title="Unique client placements"><span data-test-unique-placements>{{this.uniqueActiveAllocationNodes.length}}</span></g.Item>
                  <g.Item @title="Job">
                    <LinkTo data-test-job @route="jobs.job" @model={{this.activeAllocation.job}}>{{this.activeAllocation.job.name}}</LinkTo>
                    <span class="text-secondary" data-test-task-group>/ {{this.activeAllocation.taskGroupName}}</span>
                  </g.Item>
                  <g.Item @title="Type">{{this.activeAllocation.job.type}}</g.Item>
                  <g.Item @title="Priority">{{this.activeAllocation.job.priority}}</g.Item>
                  <g.Item @title="Client">
                    <LinkTo data-test-client @route="clients.client" @model={{this.activeAllocation.node}} class="font-monospace">
                      {{this.activeAllocation.node.shortId}}
                    </LinkTo>
                  </g.Item>
                  <g.Item @title="Client name">{{this.activeAllocation.node.name}}</g.Item>
                  <g.Item @title="Client address" @monospace={{true}}>{{this.activeAllocation.node.httpAddr}}</g.Item>
                </Ui::Datagrid>
                <PrimaryMetric::Allocation @allocation={{this.activeAllocation}} @metric="memory" class="mb-3" />
                <PrimaryMetric::Allocation @allocation={{this.activeAllocation}} @metric="cpu" />
              {{else}}
                <div class="row g-2 mb-3 text-center">
                  <div class="col-4">
                    <div class="norca-topo-metric-value" data-test-node-count>{{this.model.nodes.length}}</div>
                    <div class="text-secondary small">Clients</div>
                  </div>
                  <div class="col-4">
                    <div class="norca-topo-metric-value" data-test-alloc-count>{{this.scheduledAllocations.length}}</div>
                    <div class="text-secondary small">Allocations</div>
                  </div>
                  <div class="col-4">
                    <div class="norca-topo-metric-value" data-test-node-pool-count>{{this.model.nodePools.length}}</div>
                    <div class="text-secondary small">Node Pools</div>
                  </div>
                </div>
                <Topology::Utilization
                  @kind="memory"
                  @label="of memory"
                  @value={{this.totalMemoryFormatted}}
                  @units={{this.totalMemoryUnits}}
                  @percent={{this.reservedMemoryPercent}}
                  @reserved={{format-bytes this.totalReservedMemory}}
                  @total={{format-bytes this.totalMemory}}
                />
                <Topology::Utilization
                  @kind="cpu"
                  @label="of CPU"
                  @value={{this.totalCPUFormatted}}
                  @units={{this.totalCPUUnits}}
                  @percent={{this.reservedCPUPercent}}
                  @reserved={{format-hertz this.totalReservedCPU}}
                  @total={{format-hertz this.totalCPU}}
                />
              {{/if}}
            </div>
          </Ui::Card>
        </div>
        <div class="col-lg-8 col-xl-9">
          <div class="d-flex flex-wrap gap-2 mb-3" data-test-topology-toolbar>
            {{#if this.model.nodes.length}}
              <Ui::Input
                @type="search"
                @icon="search"
                @placeholder="Search clients..."
                @value={{this.searchTerm}}
                @onInput={{this.search}}
                aria-label="Search clients"
                data-test-topology-search
              />
            {{/if}}
            <div class="d-flex flex-wrap gap-2 ms-auto">
              <Ui::FilterDropdown
                @label="Node Pool"
                @options={{this.optionsNodePool}}
                @selection={{this.selectionNodePool}}
                @onSelect={{fn this.setFacetQueryParam "qpNodePool"}}
                data-test-node-pool-facet
              />
              <Ui::FilterDropdown
                @label="Datacenter"
                @options={{this.optionsDatacenter}}
                @selection={{this.selectionDatacenter}}
                @onSelect={{fn this.setFacetQueryParam "qpDatacenter"}}
                data-test-datacenter-facet
              />
              <Ui::FilterDropdown
                @label="Class"
                @options={{this.optionsClass}}
                @selection={{this.selectionClass}}
                @onSelect={{fn this.setFacetQueryParam "qpClass"}}
                data-test-class-facet
              />
              <Ui::FilterDropdown
                @label="State"
                @options={{this.optionsState}}
                @selection={{this.selectionState}}
                @onSelect={{fn this.setFacetQueryParam "qpState"}}
                data-test-state-facet
              />
              <Ui::FilterDropdown
                @label="Version"
                @options={{this.optionsVersion}}
                @selection={{this.selectionVersion}}
                @onSelect={{fn this.setFacetQueryParam "qpVersion"}}
                data-test-version-facet
              />
            </div>
          </div>
          {{#if this.model.nodes.length}}
            <TopoViz
              @nodes={{this.filteredNodes}}
              @allocations={{this.model.allocations}}
              @onAllocationSelect={{this.setAllocation}}
              @onNodeSelect={{this.setNode}}
              @onDataError={{this.handleTopoVizDataError}}
              @filters={{hash
                search=this.searchTerm
                clientState=this.selectionState
                clientVersion=this.selectionVersion
              }}
            />
            {{#unless this.filteredNodes.length}}
              <Ui::Card>
                <Ui::EmptyState
                  @icon="filter-off"
                  @title="No Matches"
                  @message="No clients match the search or the filters. Change them to see the topology."
                  data-test-topology-no-matches
                />
              </Ui::Card>
            {{/unless}}
          {{else}}
            <Ui::Card>
              <Ui::EmptyState
                @icon="server-2"
                @title="No Clients"
                @message="The cluster has no client nodes yet. Start a client agent and it appears here with its allocations."
                data-test-topology-empty
              />
            </Ui::Card>
          {{/if}}
        </div>
      </div>
    {{/if}}
  </Ui::PageBody>
</PageLayout>
