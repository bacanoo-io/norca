{{page-title "Exec"}}
{{! A full-screen page outside the frame: it opens in its own window. }}
<div class="norca-exec" data-test-exec>
  <header class="norca-exec-header">
    <strong class="norca-exec-brand">Norca</strong>
    <dl class="norca-exec-context">
      {{#if this.system.shouldShowRegions}}
        <div>
          <dt>Region</dt>
          <dd data-test-region>{{this.model.region}}</dd>
        </div>
      {{/if}}
      {{#if this.system.shouldShowNamespaces}}
        <div>
          <dt>Namespace</dt>
          <dd data-test-namespace>{{this.model.namespace.id}}</dd>
        </div>
      {{/if}}
      <div>
        <dt>Job</dt>
        <dd data-test-job>{{this.model.name}}</dd>
      </div>
    </dl>
    <Ui::Icon @name="lock" @label="Exec session" class="ms-auto" />
  </header>

  {{#if (eq this.model.status "dead")}}
    <div class="norca-exec-body" data-test-exec-job-dead>
      <div class="norca-exec-tree"></div>
      <div class="norca-exec-message" data-test-exec-job-dead-message>
        Job <code>{{this.model.name}}</code> is dead and cannot host an exec session.
      </div>
    </div>
  {{else}}
    <div class="norca-exec-body">
      <nav class="norca-exec-tree" aria-labelledby="exec-tasks-heading">
        <h2 class="norca-exec-tree-heading" id="exec-tasks-heading">Tasks</h2>
        <ul class="list-unstyled mb-0">
          {{#each this.sortedTaskGroups as |taskGroup|}}
            <li data-test-task-group>
              <Exec::TaskGroupParent
                @taskGroup={{taskGroup}}
                @shouldOpenInNewWindow={{this.socketOpen}}
                @activeTaskName={{this.taskName}}
                @activeTaskGroupName={{this.taskGroupName}} />
            </li>
          {{/each}}
        </ul>
      </nav>
      <ExecTerminal @terminal={{this.terminal}} />
    </div>
  {{/if}}
</div>
