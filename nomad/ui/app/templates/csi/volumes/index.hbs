{{page-title "CSI Volumes"}}
<Ui::PageHeader @pretitle="Capacity" @title="Storage" @subtitle="CSI volumes and the plugins that provide them" />
<Ui::PageBody>
  <Storage::Tabs />
  {{#if this.isForbidden}}
    <ForbiddenMessage />
  {{else}}
    <Ui::DataTable
      @id="csi-volumes"
      @caption="CSI volumes"
      @columns={{this.columns}}
      @rows={{this.sortedVolumes}}
      @sortBy={{this.sortProperty}}
      @sortDescending={{this.sortDescending}}
      @onSort={{this.sort}}
      @pageSize={{this.pageSize}}
      @page={{this.currentPage}}
      @onPageChange={{this.setPage}}
      @onPageSizeChange={{this.setPageSize}}
      @onRowClick={{this.gotoVolume}}
      @enumerate={{true}}
      @noun="volumes"
      @viewState={{this.viewState}}
      @onApplyView={{this.applyView}}
    >
      <:filters>
        {{#if this.visibleVolumes.length}}
          <Ui::Input
            @type="search"
            @icon="search"
            @placeholder="Search volumes..."
            @value={{this.searchTerm}}
            @onInput={{this.search}}
            aria-label="Search volumes"
            data-test-volumes-search
          />
        {{/if}}
        {{#if this.system.shouldShowNamespaces}}
          <Ui::Select
            @label="Namespace"
            @options={{this.namespaceSelectOptions}}
            @value={{this.qpNamespace}}
            @onChange={{this.setNamespace}}
            class="w-auto"
            data-test-namespace-facet
          />
        {{/if}}
      </:filters>
      <:row as |volume r|>
        <r.Row data-test-volume-row={{volume.plainId}}>
          <r.Cell @key="name" data-test-volume-name>
            <LinkTo @route="csi.volumes.volume" @model={{volume.idWithNamespace}} title={{volume.plainId}}>{{volume.name}}</LinkTo>
          </r.Cell>
          <r.Cell @key="namespace" data-test-volume-namespace>{{volume.namespace.name}}</r.Cell>
          <r.Cell @key="schedulable" data-test-volume-schedulable>
            <Ui::StatusIndicator
              @tone={{if volume.schedulable "success" "danger"}}
              @label={{if volume.schedulable "Schedulable" "Unschedulable"}}
            />
          </r.Cell>
          <r.Cell @key="controllersHealthyProportion" data-test-volume-controller-health>
            <Storage::Health
              @nodeOnly={{not (or volume.controllerRequired (gt volume.controllersExpected 0))}}
              @healthy={{volume.controllersHealthy}}
              @expected={{volume.controllersExpected}}
            />
          </r.Cell>
          <r.Cell @key="nodesHealthyProportion" data-test-volume-node-health>
            <Storage::Health @healthy={{volume.nodesHealthy}} @expected={{volume.nodesExpected}} />
          </r.Cell>
          <r.Cell @key="provider" data-test-volume-provider>{{volume.provider}}</r.Cell>
          <r.Cell @key="allocations" class="tabular-nums" data-test-volume-allocations>{{volume.allocationCount}}</r.Cell>
        </r.Row>
      </:row>
      <:empty>
        {{#if (eq this.visibleVolumes.length 0)}}
          <Ui::EmptyState
            @icon="database"
            @title="No Volumes"
            @message="This namespace currently has no CSI volumes. Register a volume with a CSI plugin to see it here."
            data-test-empty-volumes-list
          />
        {{else}}
          <Ui::EmptyState
            @icon="filter-off"
            @title="No Matches"
            @message="No volumes match the term {{this.searchTerm}}. Change the search to see more volumes."
            data-test-empty-volumes-list
          />
        {{/if}}
      </:empty>
    </Ui::DataTable>
  {{/if}}
</Ui::PageBody>
