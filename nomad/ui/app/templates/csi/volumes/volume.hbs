{{page-title "CSI Volume " this.model.name}}
<Ui::PageHeader @breadcrumbs={{this.breadcrumbs}} data-test-volume-header>
  <:title><span data-test-title>{{this.model.name}}</span></:title>
  <:subtitle>
    <span class="d-inline-flex flex-wrap align-items-center gap-2">
      <span class="font-monospace">{{this.model.plainId}}</span>
      <Ui::CopyButton @text={{this.model.plainId}} @label="Copy the volume ID" />
    </span>
  </:subtitle>
</Ui::PageHeader>
<Ui::PageBody>
  <div class="row g-3 mb-3">
    <div class="col-lg-8">
      <Ui::Card @title="Volume details" data-test-volume-details>
        <Ui::Datagrid as |g|>
          <g.Item @title="Health">
            <span data-test-volume-health>
              <Ui::StatusIndicator
                @tone={{if this.model.schedulable "success" "danger"}}
                @label={{if this.model.schedulable "Schedulable" "Unschedulable"}}
              />
            </span>
          </g.Item>
          <g.Item @title="Provider"><span data-test-volume-provider>{{this.model.provider}}</span></g.Item>
          <g.Item @title="External ID" @monospace={{true}}><span data-test-volume-external-id>{{this.model.externalId}}</span></g.Item>
          {{#if this.system.shouldShowNamespaces}}
            <g.Item @title="Namespace"><span data-test-volume-namespace>{{this.model.namespace.name}}</span></g.Item>
          {{/if}}
          <g.Item @title="Plugin">
            {{#if this.model.plugin}}
              <LinkTo @route="csi.plugins.plugin" @model={{this.model.plugin.plainId}}>{{this.model.plugin.plainId}}</LinkTo>
            {{else}}
              {{this.model.pluginId}}
            {{/if}}
          </g.Item>
          <g.Item @title="Controller health">
            <Storage::Health
              @nodeOnly={{not (or this.model.controllerRequired (gt this.model.controllersExpected 0))}}
              @healthy={{this.model.controllersHealthy}}
              @expected={{this.model.controllersExpected}}
            />
          </g.Item>
          <g.Item @title="Node health">
            <Storage::Health @healthy={{this.model.nodesHealthy}} @expected={{this.model.nodesExpected}} />
          </g.Item>
        </Ui::Datagrid>
      </Ui::Card>
    </div>
    <div class="col-lg-4">
      <Ui::Card @title="Constraints" data-test-volume-constraints>
        <Ui::Datagrid as |g|>
          <g.Item @title="Access mode" @monospace={{true}}><span data-test-access-mode>{{this.model.accessMode}}</span></g.Item>
          <g.Item @title="Attachment mode" @monospace={{true}}><span data-test-attachment-mode>{{this.model.attachmentMode}}</span></g.Item>
        </Ui::Datagrid>
      </Ui::Card>
    </div>
  </div>

  <h2 class="h3 mb-2">Write allocations</h2>
  <div class="mb-3" data-test-write-allocations>
    <Allocations::Table
      @id="volume-write-allocations"
      @caption="Write allocations"
      @context="volume"
      @allocations={{this.model.writeAllocations}}
      @columnPicker={{false}}
    >
      <:empty>
        <Ui::EmptyState
          @icon="box"
          @title="No Write Allocations"
          @message="No allocations are depending on this volume for read/write access."
          data-test-empty-write-allocations
        />
      </:empty>
    </Allocations::Table>
  </div>

  <h2 class="h3 mb-2">Read allocations</h2>
  <div data-test-read-allocations>
    <Allocations::Table
      @id="volume-read-allocations"
      @caption="Read allocations"
      @context="volume"
      @allocations={{this.model.readAllocations}}
      @columnPicker={{false}}
    >
      <:empty>
        <Ui::EmptyState
          @icon="box"
          @title="No Read Allocations"
          @message="No allocations are depending on this volume for read-only access."
          data-test-empty-read-allocations
        />
      </:empty>
    </Allocations::Table>
  </div>
</Ui::PageBody>
