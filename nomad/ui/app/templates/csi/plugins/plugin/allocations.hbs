{{page-title "CSI Plugin " this.model.plainId " allocations"}}
<Storage::PluginHeader @plugin={{this.model}} @title="Allocations for {{this.model.plainId}}">
  <Storage::PluginAllocations
    @id="plugin-allocations"
    @caption="Allocations of {{this.model.plainId}}"
    @pluginAllocations={{this.sortedAllocations}}
    @sortBy={{this.sortProperty}}
    @sortDescending={{this.sortDescending}}
    @onSort={{this.sort}}
    @pageSize={{this.pageSize}}
    @page={{this.currentPage}}
    @onPageChange={{this.setPage}}
    @onPageSizeChange={{this.setPageSize}}
  >
    <:filters>
      <Ui::FilterDropdown
        @label="Health"
        @options={{this.optionsHealth}}
        @selection={{this.selectionHealth}}
        @onSelect={{fn this.setFilter "qpHealth"}}
        data-test-health-facet
      />
      <Ui::FilterDropdown
        @label="Type"
        @options={{this.optionsType}}
        @selection={{this.selectionType}}
        @onSelect={{fn this.setFilter "qpType"}}
        data-test-type-facet
      />
    </:filters>
    <:empty>
      {{#if (eq this.combinedAllocations.length 0)}}
        <Ui::EmptyState
          @icon="box"
          @title="No Allocations"
          @message="The plugin has no allocations."
          data-test-empty-list
        />
      {{else}}
        <Ui::EmptyState
          @icon="filter-off"
          @title="No Matches"
          @message="No allocations match your current filter selection."
          data-test-empty-list
        />
      {{/if}}
    </:empty>
  </Storage::PluginAllocations>
</Storage::PluginHeader>
