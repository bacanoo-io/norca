{{page-title "CSI Plugin " this.model.plainId}}
<Storage::PluginHeader @plugin={{this.model}}>
  <Ui::Card @title="Plugin details" class="mb-3" data-test-plugin-details>
    <Ui::Datagrid as |g|>
      {{#if this.model.controllerRequired}}
        <g.Item @title="Controller health">
          <span data-test-plugin-controller-health>
            {{format-percentage this.model.controllersHealthy total=this.model.controllersExpected}}
            ({{this.model.controllersHealthy}}/{{this.model.controllersExpected}})
          </span>
        </g.Item>
      {{/if}}
      <g.Item @title="Node health">
        <span data-test-plugin-node-health>
          {{format-percentage this.model.nodesHealthy total=this.model.nodesExpected}}
          ({{this.model.nodesHealthy}}/{{this.model.nodesExpected}})
        </span>
      </g.Item>
      <g.Item @title="Provider"><span data-test-plugin-provider>{{this.model.provider}}</span></g.Item>
    </Ui::Datagrid>
  </Ui::Card>

  <div class="row g-3 mb-3">
    {{#if this.model.controllerRequired}}
      <div class="col-md-6">
        <Storage::Availability
          @title="Controller Health"
          @healthy={{this.model.controllersHealthy}}
          @expected={{this.model.controllersExpected}}
          data-test-plugin-controller-availability
        />
      </div>
    {{/if}}
    <div class="col-md-6">
      <Storage::Availability
        @title="Node Health"
        @healthy={{this.model.nodesHealthy}}
        @expected={{this.model.nodesExpected}}
        data-test-plugin-node-availability
      />
    </div>
  </div>

  {{#if this.model.controllerRequired}}
    <div class="mb-3" data-test-controller-allocations>
      <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
        <h2 class="h3 mb-0">Controller allocations</h2>
        {{#if this.model.controllers}}
          <LinkTo
            @route="csi.plugins.plugin.allocations"
            @model={{this.model}}
            @query={{hash qpType=(qp-serialize (array "controller"))}}
            class="ms-auto"
            data-test-go-to-controller-allocations
          >
            View all {{this.model.controllers.length}} Controller {{pluralize "allocation" this.model.controllers.length}}
          </LinkTo>
        {{/if}}
      </div>
      <Storage::PluginAllocations
        @id="plugin-controller-allocations"
        @caption="Controller allocations"
        @pluginAllocations={{take 10 this.sortedControllers}}
      >
        <:empty>
          <Ui::EmptyState
            @icon="box"
            @title="No Controller Plugin Allocations"
            @message="No allocations are providing controller plugin service."
            data-test-empty-controller-allocations
          />
        </:empty>
      </Storage::PluginAllocations>
    </div>
  {{/if}}

  <div data-test-node-allocations>
    <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
      <h2 class="h3 mb-0">Node allocations</h2>
      {{#if this.model.nodes}}
        <LinkTo
          @route="csi.plugins.plugin.allocations"
          @model={{this.model}}
          @query={{hash qpType=(qp-serialize (array "node"))}}
          class="ms-auto"
          data-test-go-to-node-allocations
        >
          View all {{this.model.nodes.length}} Node {{pluralize "allocation" this.model.nodes.length}}
        </LinkTo>
      {{/if}}
    </div>
    <Storage::PluginAllocations
      @id="plugin-node-allocations"
      @caption="Node allocations"
      @pluginAllocations={{take 10 this.sortedNodes}}
    >
      <:empty>
        <Ui::EmptyState
          @icon="box"
          @title="No Node Plugin Allocations"
          @message="No allocations are providing node plugin service."
          data-test-empty-node-allocations
        />
      </:empty>
    </Storage::PluginAllocations>
  </div>
</Storage::PluginHeader>
