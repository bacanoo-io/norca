{{did-update this.onViewChange @view}}
{{did-insert this.establishKeyValues}}
<form class="norca-variable-form" autocomplete="off" data-test-variable-form {{on "submit" this.save}}>

  {{#if @model.isNew}}
    {{#unless this.isJobTemplateVariable}}
      <Ui::Alert @tone="info" class="mb-3" data-test-related-entities-hint>
        Prefix your path with <code>nomad/jobs</code> to automatically make your variable accessible to all jobs.
        Adding job name, group name, or task name will make your variable available to that specific job, group, or task.
        Format: <code>nomad/jobs/&lt;jobname&gt;</code>, <code>nomad/jobs/&lt;jobname&gt;/&lt;groupname&gt;</code>,
        <code>nomad/jobs/&lt;jobname&gt;/&lt;groupname&gt;/&lt;taskname&gt;</code>
      </Ui::Alert>
    {{/unless}}

    {{#if this.shouldShowLinkedEntities}}
      <VariableForm::RelatedEntities
        @new={{true}}
        @job={{@model.pathLinkedEntities.job}}
        @group={{@model.pathLinkedEntities.group}}
        @task={{@model.pathLinkedEntities.task}}
        @namespace={{or this.variableNamespace "default"}}
      />
    {{/if}}
  {{/if}}

  {{#if this.hasConflict}}
    <Ui::Alert @tone="danger" @title="Heads up! Your variable has a conflict." class="mb-3" data-test-variable-conflict>
      <p>This might be because someone else tried saving in the time since you've had it open.</p>
      {{#if this.conflictingVariable.modifyTime}}
        <Ui::Tooltip @text={{format-ts this.conflictingVariable.modifyTime}}>
          <span tabindex="0">{{moment-from-now this.conflictingVariable.modifyTime}}</span>
        </Ui::Tooltip>
      {{/if}}
      {{#if this.conflictingVariable.items}}
        <Ui::CodeBlock @code={{stringify-object this.conflictingVariable.items whitespace=2}} @label="The conflicting variable" class="my-2" />
      {{else}}
        <p>Your ACL token limits your ability to see further details about the conflicting variable.</p>
      {{/if}}
      <div class="d-flex flex-wrap gap-2 mt-2">
        <Ui::Button data-test-refresh-button {{on "click" this.refresh}}>Refresh your browser</Ui::Button>
        <Ui::Button @variant="danger" data-test-overwrite-button {{on "click" this.saveWithOverwrite}}>Overwrite anyway</Ui::Button>
      </div>
    </Ui::Alert>
  {{/if}}

  <div class="row g-3 mb-3">
    <div class="col">
      <Ui::Field @label="Path" class="mb-0" as |f|>
        <Ui::Input
          @id={{f.id}}
          @value={{this.path}}
          @placeholder="nomad/jobs/my-job/my-group/my-task"
          @invalid={{if this.duplicatePathWarning true false}}
          @disabled={{not @model.isNew}}
          @onInput={{this.setPath}}
          data-test-path-input
          {{autofocus}}
        />
      </Ui::Field>
      {{#if this.duplicatePathWarning}}
        <p class="text-danger small mt-1 mb-0" data-test-duplicate-path-error>
          There is already a variable located at {{this.path}}.
          Please choose a different path, or
          <LinkTo
            @route="variables.variable.edit"
            @model={{concat this.duplicatePathWarning.path "@" (or this.variableNamespace "default")}}
          >edit the existing variable</LinkTo>.
        </p>
      {{/if}}
      {{#if this.isJobTemplateVariable}}
        <p class="small text-secondary d-flex flex-wrap align-items-center gap-1 mt-1 mb-0" data-test-job-template-hint>
          Use this variable to generate job templates with
          <code>nomad job init -template={{this.jobTemplateName}}</code>
          <Ui::CopyButton @text="nomad job init -template={{this.jobTemplateName}}" @label="Copy the command" />
        </p>
      {{/if}}
    </div>
    <VariableForm::NamespaceFilter
      @data={{hash
        disabled=(not @model.isNew)
        selection=this.variableNamespace
        namespaceOptions=this.namespaceOptions
      }}
      @fns={{hash
        onSelect=this.setNamespace
        setNamespaceOptions=this.setNamespaceOptions
      }}
    />
  </div>

  {{#if this.isJobTemplateVariable}}
    <VariableForm::JobTemplateEditor
      @keyValues={{this.keyValues}}
      @updateKeyValue={{this.updateKeyValue}}
    />
  {{else if (eq this.view "json")}}
    <div class="mb-3" data-test-json-editor-wrapper>
      <Ui::CodeEditor
        @label="Items as JSON"
        @language="json"
        @value={{this.JSONItems}}
        @onChange={{this.updateCode}}
        @invalid={{if this.JSONError true false}}
        @onSubmit={{this.save}}
        data-test-json-editor
      />
      {{#if this.JSONError}}
        <p class="text-danger small mt-1 mb-0" data-test-json-error>{{this.JSONError}}</p>
      {{/if}}
    </div>
  {{else}}
    <div class="mb-3" data-test-kv-rows>
      {{#each this.keyValues as |entry iter|}}
        <div class="row g-2 align-items-end mb-2" data-test-kv-row>
          <div class="col-md-4">
            <Ui::Field @label="Key" class="mb-0" as |f|>
              <Ui::Input
                @id={{f.id}}
                @value={{entry.key}}
                @onInput={{fn this.setKey entry}}
                data-test-var-key
                {{autofocus ignore=(eq iter 0)}}
              />
            </Ui::Field>
          </div>
          <VariableForm::InputGroup @entry={{entry}} @index={{iter}} />
          <div class="col-auto">
            <Ui::Button
              @variant="ghost"
              @icon="trash"
              @disabled={{eq this.keyValues.length 1}}
              data-test-delete-row
              {{on "click" (fn this.deleteRow entry)}}
            >Delete</Ui::Button>
          </div>
          {{#each-in entry.warnings as |k v|}}
            <div class="col-12 text-warning small" data-test-key-value-error={{k}}>{{v}}</div>
          {{/each-in}}
        </div>
      {{/each}}
    </div>
  {{/if}}

  <div class="d-flex flex-wrap gap-2">
    {{#unless this.isJSONView}}
      {{#unless this.isJobTemplateVariable}}
        <Ui::Button
          @icon="plus"
          @disabled={{not (and this.keyValues.lastObject.key this.keyValues.lastObject.value)}}
          data-test-add-kv
          {{on "click" this.appendRow}}
        >Add More</Ui::Button>
      {{/unless}}
    {{/unless}}
    <Ui::Button
      @variant="primary"
      @type="submit"
      @disabled={{this.shouldDisableSave}}
      data-test-submit-var
    >Save {{pluralize "Variable" this.keyValues.length}}</Ui::Button>
  </div>
</form>
