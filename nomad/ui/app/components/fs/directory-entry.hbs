<td class="w-66">
  <Fs::Link @allocation={{this.allocation}} @taskState={{this.taskState}} @path={{this.pathToEntry}}>
    {{#if this.entry.IsDir}}
      <Ui::Icon @name="folder" class="me-1" data-test-icon="folder" />
    {{else}}
      <Ui::Icon @name="file-text" class="me-1" data-test-icon="file" />
    {{/if}}
    <span data-test-name>{{this.entry.Name}}</span>
  </Fs::Link>
</td>
<td class="text-end tabular-nums" data-test-size>{{#unless this.entry.IsDir}}{{format-bytes this.entry.Size}}{{/unless}}</td>
<td class="text-end text-nowrap" title={{format-ts this.entry.ModTime}} data-test-last-modified>{{moment-from this.entry.ModTime interval=1000}}</td>
