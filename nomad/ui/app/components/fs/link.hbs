{{#if this.taskState}}
  {{#if this.path}}
    <LinkTo @route="allocations.allocation.task.fs" @models={{array this.allocation this.taskState this.path}}>{{yield}}</LinkTo>
  {{else}}
    <LinkTo @route="allocations.allocation.task.fs-root" @models={{array this.allocation this.taskState}}>{{yield}}</LinkTo>
  {{/if}}
{{else}}
  {{#if this.path}}
    <LinkTo @route="allocations.allocation.fs" @models={{array this.allocation this.path}}>{{yield}}</LinkTo>
  {{else}}
    <LinkTo @route="allocations.allocation.fs-root" @model={{this.allocation}}>{{yield}}</LinkTo>
  {{/if}}
{{/if}}
