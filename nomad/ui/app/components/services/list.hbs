<div data-test-services {{this.setup this.scopedRegions this.namespace}}>
  <Ui::PageHeader @pretitle="Services and networking" @title="Services" @subtitle={{this.scopeLabel}}>
    <:actions>
      <Ui::Button @route="network" @icon="shield-lock">Intentions and network rules</Ui::Button>
    </:actions>
  </Ui::PageHeader>

  <Ui::PageBody>
    {{#if this.isLoading}}
      <Ui::Card><Ui::Spinner @showLabel={{true}} @label="Loading the service catalog" /></Ui::Card>
    {{else}}
      {{#each this.errors as |r|}}
        <Ui::Alert @tone="danger" @title="The services of {{or r.region 'the local region'}} could not be loaded" class="mb-3">{{r.error}}</Ui::Alert>
      {{/each}}

      <div class="row row-cards mb-3">
        <div class="col-sm-6 col-lg-3">
          <Ui::Stat @id="services" @label="Services" @value={{this.totals.services}} @hint="in the native catalog" @color="blue" />
        </div>
        <div class="col-sm-6 col-lg-3">
          <Ui::Stat @id="passing" @label="Passing instances" @value={{this.totals.passing}} @hint={{concat "of " this.totals.instances " instances"}} @color="green" />
        </div>
        <div class="col-sm-6 col-lg-3">
          <Ui::Stat @id="excluded" @label="Left out of discovery" @value={{this.totals.excluded}} @hint="not ready or critical" @color={{if this.totals.excluded "orange" "secondary"}} />
        </div>
        <div class="col-sm-6 col-lg-3">
          <Ui::Card @size="sm" data-test-mtls-root>
            <div class="fw-medium">mTLS</div>
            {{#if this.activeRoot}}
              <div class="text-secondary small">Trust domain <span class="font-monospace">{{this.roots.TrustDomain}}</span>, root valid until {{format-ts this.activeRoot.NotAfter short=true}}</div>
            {{else}}
              <div class="text-secondary small">Native mTLS is not enabled in this region.</div>
            {{/if}}
          </Ui::Card>
        </div>
      </div>

      <Ui::DataTable
        @id="service-catalog"
        @caption="Services"
        @columns={{this.columns}}
        @rows={{this.tableRows}}
        @sortBy={{this.list.sortBy}}
        @sortDescending={{this.list.sortDescending}}
        @onSort={{this.list.sort}}
        @pageSize={{this.list.pageSize}}
        @page={{this.list.page}}
        @onPageChange={{this.list.setPage}}
        @onPageSizeChange={{this.list.setPageSize}}
        @noun="services"
        @viewState={{this.list.viewState}}
        @onApplyView={{this.list.applyView}}
        @emptyMessage={{if this.list.searchTerm "No service matches the search." "No service is registered. Services of jobs whose service provider is nomad appear here with the health of their instances."}}
        data-test-service-catalog
      >
        <:filters>
          <Ui::Input
            @type="search"
            @icon="search"
            @placeholder="Search by name or tag..."
            @value={{this.list.searchTerm}}
            @onInput={{this.list.search}}
            aria-label="Search services"
            data-test-service-filter
          />
        </:filters>
        <:row as |row r|>
          <r.Row data-test-service-row={{row.key}}>
            <r.Cell @key="name">
              <LinkTo @route="services.service" @model={{row.name}} @query={{hash namespace=row.namespace}} data-test-service-link={{row.name}}>{{row.name}}</LinkTo>
              {{#if row.external}}<Ui::Badge class="ms-1">external</Ui::Badge>{{/if}}
            </r.Cell>
            <r.Cell @key="namespace">{{row.namespace}}</r.Cell>
            {{#each row.cells as |cell|}}
              <r.Cell @key={{cell.key}} data-test-service-health>
                {{#if cell.health}}
                  <Ui::StatusIndicator @tone={{cell.health.tone}} @label={{concat cell.health.passing "/" cell.health.total}} />
                  {{#if (not-eq cell.health.discoverable cell.health.total)}}<div class="small text-warning">{{cell.health.excluded}} left out</div>{{/if}}
                {{else}}
                  <span class="text-secondary">–</span>
                {{/if}}
              </r.Cell>
            {{/each}}
            <r.Cell @key="tags">
              {{#each row.tags as |tag|}}<Ui::Badge class="me-1">{{tag}}</Ui::Badge>{{/each}}
            </r.Cell>
            <r.Cell @key="mtls">{{or row.mtls "–"}}</r.Cell>
          </r.Row>
        </:row>
      </Ui::DataTable>
      <p class="text-secondary small mt-3">
        The DNS interface and the Consul-compatible API run on each client agent; their state is not reported to the servers.
      </p>
    {{/if}}
  </Ui::PageBody>
</div>
