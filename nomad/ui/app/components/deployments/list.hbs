<div data-test-deployments {{this.setup this.scopedRegions this.namespace}}>
  <Ui::PageHeader @pretitle="Workloads" @title="Deployments" @subtitle={{this.scopeLabel}} />

  <Ui::PageBody>
    {{#if this.isLoading}}
      <Ui::Card><Ui::Spinner @showLabel={{true}} @label="Loading the deployments" /></Ui::Card>
    {{else}}
      {{#each this.errors as |r|}}
        <Ui::Alert @tone="danger" @title="The deployments of {{or r.region 'the local region'}} could not be loaded" class="mb-3">{{r.error}}</Ui::Alert>
      {{/each}}

      {{#each this.rollouts as |rollout|}}
        <Ui::Card @title={{concat "In progress: " rollout.job " v" rollout.version " (multiregion)"}} class="mb-3" data-test-rollout-card={{rollout.job}}>
          <Deployments::Rollout
            @job={{rollout.job}}
            @namespace={{rollout.namespace}}
            @version={{rollout.version}}
            @homeRegion={{rollout.homeRegion}}
            @onChange={{this.refresh}}
          />
        </Ui::Card>
      {{/each}}

      <Ui::DataTable
        @id="deployments"
        @caption={{if this.showAll "All deployments" "Active deployments"}}
        @columns={{this.columns}}
        @rows={{this.tableRows}}
        @sortBy={{this.list.sortBy}}
        @sortDescending={{this.list.sortDescending}}
        @onSort={{this.list.sort}}
        @pageSize={{this.list.pageSize}}
        @page={{this.list.page}}
        @onPageChange={{this.list.setPage}}
        @onPageSizeChange={{this.list.setPageSize}}
        @noun="deployments"
        @viewState={{this.list.viewState}}
        @onApplyView={{this.list.applyView}}
        @emptyMessage={{if this.list.searchTerm "No deployment matches the search." (if this.showAll "No deployment yet. Service jobs with an update block create a deployment on every new version." "No deployment in progress. Turn on Show finished to see the recent ones.")}}
        data-test-deployment-list
      >
        <:filters>
          <Ui::Input
            @type="search"
            @icon="search"
            @placeholder="Search deployments..."
            @value={{this.list.searchTerm}}
            @onInput={{this.list.search}}
            aria-label="Search deployments"
            data-test-deployment-search
          />
          <Ui::Switch @switch={{true}} @label="Show finished" @checked={{this.showAll}} @onChange={{this.setShowAll}} class="mb-0" data-test-show-all />
        </:filters>
        <:row as |d r|>
          <r.Row data-test-deployment-row={{d.ID}}>
            <r.Cell @key="JobID">
              <LinkTo @route="deployments.deployment" @model={{d.ID}} @query={{hash region=(or d.region null)}} data-test-deployment-link={{d.JobID}}>{{d.JobID}}</LinkTo>
              {{#if d.IsMultiregion}}<Ui::Badge @color="azure" class="ms-1">multiregion</Ui::Badge>{{/if}}
            </r.Cell>
            <r.Cell @key="JobVersion">v{{d.JobVersion}}</r.Cell>
            <r.Cell @key="region"><span class="norca-region">{{d.region}}</span></r.Cell>
            <r.Cell @key="Status"><Ui::StatusIndicator @status={{d.Status}} data-test-deployment-status /></r.Cell>
            <r.Cell @key="progress.healthy" class="w-25">
              <div class="small text-secondary">{{d.progress.healthy}} of {{d.progress.desired}}</div>
              <Ui::StackedBar @label={{concat "Deployment of " d.JobID}} @segments={{d.progress.segments}} />
            </r.Cell>
            <r.Cell @key="StatusDescription">{{d.StatusDescription}}</r.Cell>
          </r.Row>
        </:row>
      </Ui::DataTable>
    {{/if}}
  </Ui::PageBody>
</div>
