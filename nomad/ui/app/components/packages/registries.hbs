<div {{this.setup}} data-test-pack-registries>
  {{#if this.loadError}}
    <Ui::Alert @tone="danger" @title="The registries could not be loaded" class="mb-3" data-test-registries-error>{{this.loadError}}</Ui::Alert>
  {{/if}}

  <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
    <p class="text-secondary mb-0">
      The servers fetch a registry when it is saved or synced, and its packs appear in the catalog.
    </p>
    <Ui::Button @variant="primary" @icon="plus" {{on "click" this.openAdd}} data-test-btn-add-registry>Add registry</Ui::Button>
  </div>

  {{#if this.isLoading}}
    <Ui::Card><Ui::Spinner @showLabel={{true}} @label="Loading the registries" /></Ui::Card>
  {{else if (not this.rows.length)}}
    <Ui::Card>
      <Ui::EmptyState @icon="database" @title="No pack registry" @message="Add an OCI or Git registry, a server directory or bundle, or the built-in packs." data-test-registries-empty>
        <Ui::Button @variant="primary" @icon="plus" {{on "click" this.openAdd}}>Add registry</Ui::Button>
      </Ui::EmptyState>
    </Ui::Card>
  {{else}}
    <Ui::Card @flush={{true}}>
      <Ui::Table
        @caption="Pack registries"
        @columns={{array
          (hash key="name" label="Name")
          (hash key="source" label="Source")
          (hash key="phase" label="Status")
          (hash key="packs" label="Packs")
          (hash key="lastSync" label="Synced")
          (hash key="actions" label="")
        }}
        @rows={{this.rows}}
        data-test-registries-table
        as |row|
      >
        <td data-test-registry-row={{row.name}}>
          <div class="fw-bold">{{row.name}}</div>
          <div class="small text-secondary">{{row.type}}</div>
        </td>
        <td>
          <span class="font-monospace small">{{row.source}}</span>
          {{#if row.ref}}<span class="small text-secondary"> @ {{row.ref}}</span>{{/if}}
          {{#if row.keys}}<div class="small text-secondary">{{row.keys}} trusted {{if (eq row.keys 1) "key" "keys"}}</div>{{/if}}
        </td>
        <td data-test-registry-phase>
          <Ui::StatusIndicator @tone={{row.phaseTone}} @label={{row.phase}} />
          {{#if (eq row.phase "Error")}}<div class="small text-danger mt-1">{{row.message}}</div>{{/if}}
        </td>
        <td data-test-registry-packs>{{row.packs}}</td>
        <td class="text-secondary" title={{row.lastSyncTitle}} data-test-registry-synced>
          {{row.lastSync}}
          {{#if row.lastGoodSync}}<div class="small">packs of {{row.lastGoodSync}}</div>{{/if}}
          {{#if row.nextSync}}<div class="small" data-test-registry-next-sync>next {{row.nextSync}}</div>{{/if}}
        </td>
        <td class="text-end text-nowrap">
          <Ui::Button @size="sm" @icon="refresh" @isLoading={{eq this.syncing row.name}} {{on "click" (fn this.sync row)}} data-test-btn-sync={{row.name}}>Sync</Ui::Button>
          <Ui::Button @size="sm" @icon="pencil" @iconOnly={{true}} @label="Edit {{row.name}}" {{on "click" (fn this.openEdit row.registry)}} data-test-btn-edit={{row.name}} />
          <Ui::Button @size="sm" @variant="outline-danger" @icon="trash" @iconOnly={{true}} @label="Remove {{row.name}}" {{on "click" (fn this.askDelete row)}} data-test-btn-delete={{row.name}} />
        </td>
      </Ui::Table>
    </Ui::Card>
  {{/if}}

  {{#if this.editing}}
    <Ui::Modal @title={{if this.editing.isNew "Add pack registry" (concat "Edit " this.formName)}} @size="lg" @onClose={{this.closeEdit}} data-test-registry-modal>
      {{#if this.formError}}
        <Ui::Alert @tone="danger" class="mb-3" data-test-registry-form-error>{{this.formError}}</Ui::Alert>
      {{/if}}
      <div class="d-flex justify-content-end mb-2">
        <Ui::Button @size="sm" @icon="package" {{on "click" this.presetBuiltin}} data-test-btn-preset-builtin>Built-in packs</Ui::Button>
      </div>
      <div class="row g-3">
        <div class="col-md-6">
          <Ui::Field @label="Name" @required={{true}} @help="Lowercase letters, digits and dashes." as |f|>
            <Ui::Input @id={{f.id}} @value={{this.formName}} @onInput={{this.setName}} @disabled={{not this.editing.isNew}} data-test-input-reg-name />
          </Ui::Field>
        </div>
        <div class="col-md-6">
          <Ui::Field @label="Type" as |f|>
            <Ui::Select @id={{f.id}} @value={{this.formType}} @options={{this.types}} @onChange={{this.setType}} data-test-select-reg-type />
          </Ui::Field>
        </div>
      </div>
      <Ui::Field @label="Source" @required={{true}} @help={{this.typeInfo.help}} as |f|>
        <Ui::Input @id={{f.id}} @value={{this.formSource}} @onInput={{this.setSource}} @placeholder={{this.typeInfo.placeholder}} @monospace={{true}} data-test-input-reg-source />
      </Ui::Field>
      {{#if (or (eq this.formType "oci") (eq this.formType "git"))}}
        <Ui::Field @label="Reference" @help="The tag or branch to fetch; latest when empty." as |f|>
          <Ui::Input @id={{f.id}} @value={{this.formRef}} @onInput={{this.setRef}} @placeholder="latest" data-test-input-reg-ref />
        </Ui::Field>
      {{/if}}
      <Ui::Field @label="Sync" @help="The servers fetch the registry again on this schedule; Sync on the list fetches it now." as |f|>
        <Ui::Select @id={{f.id}} @value={{this.formInterval}} @options={{this.intervalOptions}} @onChange={{this.setInterval}} data-test-select-reg-interval />
      </Ui::Field>
      <Ui::Field @label="Trusted keys" @help="Public keys that sign the packs, separated by blank lines. With keys, unsigned packs or packs signed by other keys cannot be installed." as |f|>
        <Ui::Input @id={{f.id}} @multiline={{true}} @monospace={{true}} @rows={{5}} @value={{this.formKeys}} @onInput={{this.setKeys}} @placeholder="-----BEGIN PUBLIC KEY-----" data-test-input-reg-keys />
      </Ui::Field>
      <div class="d-flex justify-content-end gap-2 pt-3 border-top">
        <Ui::Button @variant="ghost" {{on "click" this.closeEdit}} data-test-btn-cancel-registry>Cancel</Ui::Button>
        <Ui::Button @variant="primary" @icon="check" @isLoading={{this.isSaving}} {{on "click" this.save}} data-test-btn-save-registry>
          {{if this.editing.isNew "Add and sync" "Save and sync"}}
        </Ui::Button>
      </div>
    </Ui::Modal>
  {{/if}}

  {{#if this.toDelete}}
    <Ui::Confirm
      @title="Remove {{this.toDelete.name}}?"
      @confirmLabel="Remove"
      @confirmIcon="trash"
      @tone="danger"
      @isRunning={{this.isDeleting}}
      @onConfirm={{this.confirmDelete}}
      @onClose={{this.cancelDelete}}
      data-test-registry-delete-confirm
    >
      Its packs leave the catalog. The releases installed from it keep running; upgrading them from the UI needs the registry again.
    </Ui::Confirm>
  {{/if}}
</div>
