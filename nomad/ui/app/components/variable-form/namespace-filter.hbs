<Trigger @do={{this.fetchNamespaces}} @onSuccess={{this.formatAndSetNamespaces}} as |trigger|>
  {{did-insert trigger.fns.do}}
  {{! No-op on Error, no loading behavior }}
  {{#if (and trigger.data.isSuccess trigger.data.result @data.namespaceOptions)}}
    <div class="col-md-3">
      <Ui::Field @label="Namespace" class="mb-0" as |f|>
        <Ui::Select
          @id={{f.id}}
          @disabled={{@data.disabled}}
          @options={{@data.namespaceOptions}}
          @value={{@data.selection}}
          @onChange={{@fns.onSelect}}
          data-test-variable-namespace-filter
        />
      </Ui::Field>
    </div>
  {{/if}}
</Trigger>
