<Ui::Alert @tone="info" class="mb-3" data-test-related-entities>
  This variable {{#if @new}}will be{{else}}is{{/if}} accessible by
  {{#if @task}}
    task <strong>{{@task}}</strong> in group
    <LinkTo @route="jobs.job.task-group" @models={{array (concat @job "@" @namespace) @group}}>{{@group}}</LinkTo>
  {{else if @group}}
    group <LinkTo @route="jobs.job.task-group" @models={{array (concat @job "@" @namespace) @group}}>{{@group}}</LinkTo>
  {{else if @job}}
    job <LinkTo @route="jobs.job" @model={{concat @job "@" @namespace}}>{{@job}}</LinkTo>
  {{else}}
    all nomad jobs in this namespace
  {{/if}}
</Ui::Alert>
