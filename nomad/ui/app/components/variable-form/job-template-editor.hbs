{{did-insert this.establishKeyValues}}
<Ui::Field @label="Description" as |f|>
  <Ui::Input @id={{f.id}} @value={{this.description}} @onInput={{this.updateDescription}} data-test-template-description />
</Ui::Field>
<div class="mb-3">
  <span class="d-block fw-medium mb-2" id="job-template-label">Job Template</span>
  <Ui::CodeEditor
    @label="Job Template"
    @language="hcl"
    @value={{this.template}}
    @onChange={{this.updateTemplate}}
    aria-labelledby="job-template-label"
    data-test-template-json
  />
</div>
