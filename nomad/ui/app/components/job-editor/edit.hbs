<Ui::Card @title="Job definition" class="mb-3">
  <:actions>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <Ui::Switch
        @switch={{true}}
        @label="Word wrap"
        @checked={{@data.shouldWrap}}
        @onChange={{@fns.onToggleWrap}}
        class="mb-0"
        {{keyboard-shortcut label="Toggle word wrap" action=(action @fns.onToggleWrap) pattern=(array "w" "w") menuLevel=true}}
      />
      {{#if @data.cancelable}}
        <JobEditor::ViewSelect @data={{@data}} @fns={{@fns}} />
        <Ui::Button @size="sm" @variant="ghost" data-test-cancel-editing {{on "click" @fns.onCancel}}>Cancel</Ui::Button>
      {{/if}}
    </div>
  </:actions>
  <:default>
    <Ui::CodeEditor
      @label="Job definition"
      @language={{if (eq @data.format "json") "json" "hcl"}}
      @value={{@data.job._newDefinition}}
      @onChange={{@fns.onUpdate}}
      @wrap={{@data.shouldWrap}}
      @autofocus={{true}}
      @minHeight="28rem"
      data-test-editor
    />
  </:default>
</Ui::Card>

{{#if (eq @data.view "job-spec")}}
  <Ui::Card @title="HCL variable values" class="mb-3">
    <Ui::CodeEditor
      @label="HCL variables for the job spec"
      @language="hcl"
      @value={{@data.job._newDefinitionVariables}}
      @onChange={{@fns.onUpdateVariables}}
      @wrap={{@data.shouldWrap}}
      @minHeight="6rem"
      data-test-variable-editor
    />
  </Ui::Card>
{{/if}}

<div class="d-flex flex-wrap gap-2 norca-sticky-actions">
  <Ui::Button
    @variant="primary"
    @icon="file-diff"
    @disabled={{or @fns.onPlan.isRunning (not @data.job._newDefinition)}}
    @isLoading={{@fns.onPlan.isRunning}}
    data-test-plan
    {{on "click" (perform @fns.onPlan)}}
  >Plan</Ui::Button>
  {{#if @data.job.isNew}}
    <Ui::Button @route="jobs.run.templates.new" @icon="template" data-test-save-as-template {{on "click" @fns.onSaveAs}}>
      Save as template
    </Ui::Button>
  {{/if}}
  <Ui::Button @icon="download" data-test-save-as-file {{on "click" @fns.onSaveFile}}>Save as .nomad.hcl</Ui::Button>
</div>
