<form class="norca-acl-form" autocomplete="off" novalidate {{on "submit" (perform this.save)}} data-test-token-editor>
  <Ui::Card class="mb-3">
    <Ui::Field @label="Token name" as |f|>
      <Ui::Input @id={{f.id}} @value={{this.tokenRecord.name}} @onInput={{this.updateName}} data-test-token-name-input />
    </Ui::Field>

    {{#unless this.tokenRecord.isNew}}
      <div class="row g-3">
        <div class="col-md-6">
          <Ui::Field @label="Accessor ID" @help="Public identifier of the token, used to look it up or delete it." as |f|>
            <div class="d-flex align-items-center gap-1">
              <Ui::Input @id={{f.id}} @value={{this.tokenRecord.accessor}} @readonly={{true}} @monospace={{true}} @describedBy={{f.describedBy}} data-test-token-accessor />
              <Ui::CopyButton @text={{this.tokenRecord.accessor}} @label="Copy the accessor ID" />
            </div>
          </Ui::Field>
        </div>
        <div class="col-md-6">
          <Ui::Field @label="Secret ID" @help="Used to authenticate requests. Keep it private." as |f|>
            <div class="d-flex align-items-center gap-1">
              <Ui::Input @id={{f.id}} @value={{this.tokenRecord.secret}} @readonly={{true}} @monospace={{true}} @describedBy={{f.describedBy}} data-test-token-secret />
              <Ui::CopyButton @text={{this.tokenRecord.secret}} @label="Copy the secret ID" />
            </div>
          </Ui::Field>
        </div>
      </div>
    {{/unless}}

    <Ui::RadioGroup
      @label="Token type"
      @help="Management tokens have every permission. Client tokens get their permissions from the roles and policies linked below."
      @value={{this.tokenRecord.type}}
      @onChange={{this.updateType}}
      as |g|
    >
      <g.Option @value="client" @label="Client" data-test-token-type="client" />
      <g.Option @value="management" @label="Management" data-test-token-type="management" />
    </Ui::RadioGroup>

    <Ui::Switch
      @label="Global token"
      @help={{if this.tokenRecord.isNew "Replicate the token to every federated region." "Whether a token is global can only be chosen when it is created."}}
      @checked={{this.tokenRecord.global}}
      @disabled={{not this.tokenRecord.isNew}}
      @onChange={{this.toggleGlobal}}
      class="mb-3"
      data-test-token-global
    />

    {{#if this.tokenRecord.isNew}}
      <Ui::RadioGroup @label="Expires" @value={{this.expiration}} @onChange={{this.setExpiration}} data-test-token-expiration as |g|>
        {{#each this.expirationOptions as |option|}}
          <g.Option @value={{option.value}} @label={{option.label}} />
        {{/each}}
      </Ui::RadioGroup>
      {{#if (eq this.expiration "custom")}}
        <Ui::Field @label="Expiration time" @help="In your local time zone. The server limits how far in the future a token may expire." as |f|>
          <Ui::Input
            @id={{f.id}}
            @type="datetime-local"
            @value={{this.customExpiration}}
            @describedBy={{f.describedBy}}
            @onInput={{this.updateCustomExpiration}}
            min={{this.minExpiration}}
            class="w-auto"
            data-test-token-expiration-time-input
          />
        </Ui::Field>
      {{/if}}
    {{else}}
      <p class="mb-0 {{if this.tokenRecord.isExpired 'text-danger'}}" data-test-token-expiration>
        {{#if this.tokenRecord.expirationTime}}
          {{#if this.tokenRecord.isExpired}}
            Token expired {{moment-from-now this.tokenRecord.expirationTime interval=1000}}
          {{else}}
            Token expires {{moment-from-now this.tokenRecord.expirationTime interval=1000}}
          {{/if}}
        {{else}}
          Token does not expire
        {{/if}}
      </p>
    {{/if}}
  </Ui::Card>

  {{#if this.isClientToken}}
    <h2 class="h3 mb-2">Roles</h2>
    {{#if this.availableRoles.length}}
      <Ui::Table @caption="Roles to link" @columns={{this.roleColumns}} @rows={{this.availableRoles}} class="mb-3" data-test-token-roles as |role|>
        <td class="w-1">
          <Ui::Checkbox @checked={{includes role.id this.selectedRoleIds}} @onChange={{fn this.toggleRole role}} aria-label="Link role {{role.name}}" />
        </td>
        <td data-test-role-name>{{role.name}}</td>
        <td>{{role.description}}</td>
        <td>
          {{#each role.policies as |policy|}}
            <Ui::Badge @color="secondary" class="me-1">{{policy.name}}</Ui::Badge>
          {{else}}
            <span class="text-secondary">No Policies</span>
          {{/each}}
        </td>
      </Ui::Table>
    {{else}}
      <p class="text-secondary" data-test-token-no-roles>No roles exist yet.</p>
    {{/if}}

    <h2 class="h3 mb-2">Policies</h2>
    {{#if this.availablePolicies.length}}
      <Ui::Table @caption="Policies to link" @columns={{this.policyColumns}} @rows={{this.availablePolicies}} class="mb-3" data-test-token-policies as |policy|>
        <td class="w-1">
          <Ui::Checkbox @checked={{includes policy.id this.selectedPolicyIds}} @onChange={{fn this.togglePolicy policy}} aria-label="Link policy {{policy.name}}" />
        </td>
        <td data-test-policy-name>{{policy.name}}</td>
        <td>{{policy.description}}</td>
      </Ui::Table>
    {{else}}
      <p class="text-secondary" data-test-token-no-policies>No policies exist yet.</p>
    {{/if}}
  {{/if}}

  <div class="d-flex flex-wrap gap-2">
    <Ui::Button @variant="primary" @type="submit" @disabled={{this.save.isRunning}} @isLoading={{this.save.isRunning}} data-test-token-save>
      {{if this.tokenRecord.isNew "Create Token" "Save Token"}}
    </Ui::Button>
    <Ui::Button @variant="ghost" @route="access-control.tokens" data-test-token-cancel>Cancel</Ui::Button>
  </div>
</form>
