<div
  class="norca-code-editor {{if @invalid 'is-invalid'}} {{if @readOnly 'is-read-only'}}"
  style={{this.style}}
  data-test-code-editor
  {{this.setup
    value=@value
    language=@language
    readOnly=@readOnly
    wrap=@wrap
    errorLines=@errorLines
  }}
  ...attributes
></div>
