<svg
  xmlns="http://www.w3.org/2000/svg"
  class="icon {{this.sizeClass}}"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={{if @label "img"}}
  aria-label={{@label}}
  aria-hidden={{if @label "false" "true"}}
  focusable="false"
  data-test-icon={{@name}}
  ...attributes
>{{this.content}}</svg>
