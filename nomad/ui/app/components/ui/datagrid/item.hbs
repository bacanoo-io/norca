<div class="datagrid-item" data-test-datagrid-item={{@title}} ...attributes>
  <div class="datagrid-title" data-test-datagrid-title>{{@title}}</div>
  <div class="datagrid-content {{if (or @monospace @mono) 'font-monospace'}}" data-test-datagrid-content data-test-datagrid-value>{{yield}}</div>
</div>
