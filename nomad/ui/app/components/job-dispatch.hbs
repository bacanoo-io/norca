{{#if this.errors}}
  <Ui::Alert @tone="danger" class="mb-3" data-test-dispatch-error>
    <strong class="d-block" data-test-parse-error-title>Dispatch Error</strong>
    <ul class="mb-0 ps-3">
      {{#each this.errors as |error|}}
        <li>{{error}}</li>
      {{/each}}
    </ul>
  </Ui::Alert>
{{/if}}

<form action="#" onsubmit="return false" data-test-dispatch-form>
  <Ui::Card @title="Dispatch an instance of '{{@job.name}}'" class="mb-3">
    {{#each this.metaFields as |meta|}}
      <div class="row">
        <div class="col-lg-6" data-test-meta-field={{if meta.required "required" "optional"}}>
          <Ui::Field
            @label={{meta.title}}
            @required={{meta.required}}
            @id={{meta.name}}
            @error={{if meta.error (concat meta.title " is required")}}
            @help={{concat (if meta.required "Required" "Optional") " meta parameter " meta.name}}
            as |f|
          >
            <span class="visually-hidden" aria-hidden="true" data-test-meta-field-label>{{meta.title}} {{#if meta.required}}*{{/if}}</span>
            <Ui::Input
              @id={{f.id}}
              @describedBy={{f.describedBy}}
              @invalid={{f.invalid}}
              @required={{meta.required}}
              @value={{meta.value}}
              @onInput={{fn (mut meta.value)}}
              data-test-meta-field-input
            />
          </Ui::Field>
        </div>
      </div>
    {{else}}
      <p class="text-secondary" data-test-no-meta-fields>The job takes no meta parameters.</p>
    {{/each}}

    <h3 class="h4 mt-2" data-test-payload-head>Payload {{#if this.payloadRequired}}*{{/if}}</h3>
    {{#if this.hasPayload}}
      <Ui::CodeEditor
        @label="Payload"
        @language="text"
        @value={{this.payload}}
        @onChange={{fn (mut this.payload)}}
        @invalid={{this.payloadHasError}}
        @minHeight="10rem"
        data-test-payload-editor
      />
    {{else}}
      <Ui::EmptyState
        @compact={{true}}
        @title="Payload disabled"
        @message="The parameterized block of the job does not allow a payload."
        data-test-empty-payload-message
      />
    {{/if}}
  </Ui::Card>

  <div class="d-flex gap-2">
    <Ui::Button @variant="primary" @icon="send" data-test-dispatch-button {{on "click" (action "dispatch")}}>Dispatch</Ui::Button>
    <Ui::Button @variant="ghost" data-test-cancel-button {{on "click" (action "cancel")}}>Cancel</Ui::Button>
  </div>
</form>
