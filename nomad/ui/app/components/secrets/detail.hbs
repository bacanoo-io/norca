<div data-test-secret-detail {{this.setup this.region this.namespace @path}}>
  <Ui::PageHeader @pretitle="Secrets" @title={{@path}}>
    <:subtitle>
      {{#if this.state}}
        <Ui::StatusIndicator @tone={{this.state.tone}} @label={{this.state.label}} data-test-secret-state />
      {{/if}}
      <span class="ms-2">namespace {{this.namespace}}</span>
    </:subtitle>
    <:actions>
      <Ui::Button @route="secrets">All secrets</Ui::Button>
      {{#if (and this.secret this.canDestroy)}}
        <Ui::Button @variant="outline-danger" @icon="trash" data-test-destroy-secret {{on "click" (fn this.ask "destroy" 0)}}>Destroy</Ui::Button>
      {{/if}}
      {{#if (and this.secret this.canWrite)}}
        <Ui::Button @icon="pencil" data-test-edit-secret-meta {{on "click" this.openMeta}}>Edit metadata</Ui::Button>
        <Ui::Button @variant="primary" @icon="plus" data-test-new-secret-version {{on "click" this.openWrite}}>New version</Ui::Button>
      {{/if}}
    </:actions>
  </Ui::PageHeader>

  <Ui::PageBody>
    {{#if this.isLoading}}
      <Ui::Card><Ui::Spinner @showLabel={{true}} @label="Loading the secret" /></Ui::Card>
    {{else if this.loadError}}
      <Ui::Card>
        <Ui::EmptyState @icon="lock" @title="Secret not available" @message={{this.loadError}} data-test-secret-error>
          <Ui::Button @route="secrets">All secrets</Ui::Button>
        </Ui::EmptyState>
      </Ui::Card>
    {{else}}
      {{#if this.secret.Deleted}}
        <Ui::Alert @tone="warning" class="mb-3" data-test-secret-deleted>
          The current version is deleted: tasks cannot read the secret. Undelete it below, or write a new version.
        </Ui::Alert>
      {{/if}}
      {{#if this.expired}}
        <Ui::Alert @tone="danger" class="mb-3" data-test-secret-expired>
          The value expired. Write a new version and update the expiry in the metadata.
        </Ui::Alert>
      {{/if}}
      <div class="row row-cards">
        <div class="col-lg-5">
          <Ui::Card @title="Metadata" @subtitle="Never secret; visible to everyone who may list the path">
            <Ui::Datagrid @items={{this.metadata}} data-test-secret-metadata />
            {{#if this.labels.length}}
              <h4 class="mt-3">Labels</h4>
              {{#each this.labels as |label|}}<Ui::Badge class="me-1">{{label}}</Ui::Badge>{{/each}}
            {{/if}}
          </Ui::Card>
        </div>
        <div class="col-lg-7">
          <Ui::Card @title="Value" @subtitle={{if this.revealed (concat "Version " this.revealed.Version)}} data-test-secret-value-card>
            {{#if this.revealed.readable}}
              <Secrets::Reveal @secret={{this.secret}} @version={{this.revealed.Version}} @region={{this.region}} @canRead={{this.canRead}} />
            {{else if this.revealed}}
              <p class="text-secondary mb-0">Version {{this.revealed.Version}} is {{this.revealed.state}}: its value cannot be read.</p>
            {{/if}}
          </Ui::Card>
          <Ui::Card @title="Used by" @subtitle="Jobs of the namespace that reference the path" @flush={{true}} class="mt-3" data-test-secret-jobs>
            {{#if this.referencesError}}
              <div class="p-3"><p class="text-secondary mb-0">{{this.referencesError}}</p></div>
            {{else if (not this.references)}}
              <div class="p-3"><Ui::Spinner @showLabel={{true}} @label="Looking for jobs that use the secret" /></div>
            {{else}}
              <Ui::Table
                @inCard={{true}}
                @caption="Jobs that reference the secret"
                @columns={{array (hash key="job" label="Job") (hash key="how" label="Reference")}}
                @rows={{this.references.references}}
                @emptyMessage="No job of the namespace references this path in a secret block, a secret_access binding or a template."
                as |j|
              >
                <td data-test-secret-job={{j.id}}>
                  <LinkTo @route="jobs.job.index" @model={{concat j.id "@" j.namespace}}>{{j.name}}</LinkTo>
                </td>
                <td>
                  {{#each j.refs as |ref|}}
                    <div><span class="text-secondary">{{ref.where}}:</span> <span class="font-monospace">{{ref.how}}</span></div>
                  {{/each}}
                </td>
              </Ui::Table>
              {{#if this.referencesNote}}
                <div class="px-3 pb-3"><p class="text-secondary small mb-0">{{this.referencesNote}}</p></div>
              {{/if}}
            {{/if}}
          </Ui::Card>
        </div>
      </div>

      <Ui::Card @title="Versions" @subtitle="Metadata and keyed value hash of each kept version" @flush={{true}} class="mt-3" data-test-secret-versions>
        <Ui::Table
          @inCard={{true}}
          @caption="Versions"
          @columns={{array
            (hash key="version" label="Version")
            (hash key="created" label="Created")
            (hash key="state" label="State")
            (hash key="hash" label="Value hash")
            (hash key="actions" label="Actions")
          }}
          @rows={{this.versions}}
          @emptyMessage="No versions are kept."
          as |v|
        >
          <td class="tabular-nums" data-test-secret-version-row={{v.Version}}>v{{v.Version}}</td>
          <td>{{v.created}}</td>
          <td><Ui::StatusIndicator @tone={{v.tone}} @label={{v.state}} /></td>
          <td class="font-monospace" title={{v.ValueHash}}>{{or v.hash "–"}}</td>
          <td>
            <div class="d-flex flex-wrap gap-1">
              {{#if (and v.readable (not-eq v.Version this.revealed.Version))}}
                <Ui::Button @size="sm" @variant="ghost" @icon="eye" data-test-show-version={{v.Version}} {{on "click" (fn this.showVersion v.Version)}}>Show</Ui::Button>
              {{/if}}
              {{#if (and v.canRestore this.canRead this.canWrite)}}
                <Ui::Button @size="sm" @variant="ghost" @icon="history" data-test-restore-version={{v.Version}} {{on "click" (fn this.ask "restore" v.Version)}}>Restore</Ui::Button>
              {{/if}}
              {{#if this.canWrite}}
                {{#if v.readable}}
                  <Ui::Button @size="sm" @variant="ghost" data-test-delete-version={{v.Version}} {{on "click" (fn this.ask "delete" v.Version)}}>Delete</Ui::Button>
                {{else if (and v.Deleted (not v.Destroyed))}}
                  <Ui::Button @size="sm" @variant="ghost" data-test-undelete-version={{v.Version}} {{on "click" (fn this.ask "undelete" v.Version)}}>Undelete</Ui::Button>
                {{/if}}
              {{/if}}
              {{#if (and this.canDestroy (not v.Destroyed))}}
                <Ui::Button @size="sm" @variant="ghost" data-test-destroy-version={{v.Version}} {{on "click" (fn this.ask "destroy" v.Version)}}>Destroy</Ui::Button>
              {{/if}}
            </div>
          </td>
        </Ui::Table>
      </Ui::Card>

      {{#if this.canAudit}}
        <Ui::Card @title="Recent access" @subtitle="SecretAccess audit records still buffered by the servers, and new ones" @flush={{true}} class="mt-3" data-test-secret-access>
          <Ui::Table
            @inCard={{true}}
            @caption="Recent access"
            @columns={{array (hash key="when" label="When") (hash key="op" label="Operation") (hash key="who" label="By") (hash key="result" label="Result")}}
            @rows={{this.accessRows}}
            @emptyMessage="No access seen since the servers' event buffer starts. The audit file of each server has the complete trail."
            as |a|
          >
            <td>{{a.when}}</td>
            <td>{{a.operation}}{{#if a.version}} v{{a.version}}{{/if}}</td>
            <td>{{a.who}}</td>
            <td><Ui::StatusIndicator @tone={{a.tone}} @label={{or a.result "ok"}} /></td>
          </Ui::Table>
        </Ui::Card>
      {{/if}}
    {{/if}}
  </Ui::PageBody>

  {{#if this.writing}}
    <Secrets::ValueForm @secret={{this.secret}} @region={{this.region}} @onSaved={{this.written}} @onClose={{this.closeWrite}} />
  {{/if}}

  {{#if this.editingMeta}}
    <Secrets::MetaEditor @secret={{this.secret}} @region={{this.region}} @onSaved={{this.metaSaved}} @onClose={{this.closeMeta}} />
  {{/if}}

  {{#if this.pending}}
    <Ui::Confirm
      @title={{this.pending.title}}
      @tone={{or this.pending.tone "danger"}}
      @confirmLabel={{this.pending.label}}
      @typedValue={{this.pending.typed}}
      @onConfirm={{this.runPending}}
      @onClose={{this.closePending}}
      @isRunning={{this.isRunning}}
      @error={{this.pendingError}}
      data-test-secret-confirm
    >
      <p class="mb-0">{{this.pending.text}}</p>
    </Ui::Confirm>
  {{/if}}
</div>
