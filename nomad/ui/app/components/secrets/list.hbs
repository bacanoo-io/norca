<div data-test-secrets {{this.setup this.region this.namespace}}>
  <Ui::PageHeader @pretitle="Configuration" @title="Secrets" @subtitle={{this.scopeLabel}}>
    <:actions>
      {{#if this.canCreate}}
        <Ui::Button @variant="primary" @icon="plus" data-test-new-secret {{on "click" this.openCreate}}>New secret</Ui::Button>
      {{/if}}
    </:actions>
  </Ui::PageHeader>

  <Ui::PageBody>
    {{#if this.isLoading}}
      <Ui::Card><Ui::Spinner @showLabel={{true}} @label="Loading the secrets" /></Ui::Card>
    {{else if this.error}}
      <Ui::Alert @tone="warning" @title="The secrets could not be loaded" data-test-secrets-error>{{this.error}}</Ui::Alert>
    {{else}}
      <p class="text-secondary">
        The built-in secret store keeps versioned values encrypted with the keyring. This page shows paths and
        metadata only; a value is shown on its page after an explicit Reveal, which the servers audit.
      </p>
      <Ui::DataTable
        @id="secrets"
        @caption="Secrets"
        @columns={{this.columns}}
        @rows={{this.tableRows}}
        @sortBy={{this.list.sortBy}}
        @sortDescending={{this.list.sortDescending}}
        @onSort={{this.list.sort}}
        @pageSize={{this.list.pageSize}}
        @page={{this.list.page}}
        @onPageChange={{this.list.setPage}}
        @onPageSizeChange={{this.list.setPageSize}}
        @noun="secrets"
        @viewState={{this.list.viewState}}
        @onApplyView={{this.list.applyView}}
        @emptyMessage={{if this.list.searchTerm "No secret matches the search." "No secrets in scope. Create one with New secret, norca secret put, or import Variables or Vault KV with norca secret import."}}
        data-test-secret-list
      >
        <:filters>
          <Ui::Input
            @type="search"
            @icon="search"
            @placeholder="Search secrets..."
            @value={{this.list.searchTerm}}
            @onInput={{this.list.search}}
            aria-label="Search secrets"
            data-test-secret-search
          />
        </:filters>
        <:row as |s r|>
          <r.Row data-test-secret-row={{s.Path}}>
            <r.Cell @key="Path">
              <LinkTo @route="secrets.secret" @model={{s.Path}} @query={{hash namespace=(or s.Namespace "default")}} class="font-monospace" data-test-secret-link={{s.Path}}>{{s.Path}}</LinkTo>
              {{#if s.Description}}<div class="small text-secondary">{{s.Description}}</div>{{/if}}
            </r.Cell>
            <r.Cell @key="Namespace">{{s.Namespace}}</r.Cell>
            <r.Cell @key="CurrentVersion" class="tabular-nums" data-test-secret-version>v{{s.CurrentVersion}}</r.Cell>
            <r.Cell @key="state" data-test-secret-state>
              <Ui::StatusIndicator @tone={{s.stateTone}} @label={{s.state}} />
              {{#if s.expiring}}<Ui::Badge @color="red" class="ms-1">{{s.expiring}}</Ui::Badge>{{/if}}
            </r.Cell>
            <r.Cell @key="Owner">{{or s.Owner "–"}}</r.Cell>
            <r.Cell @key="ModifyTime" title={{s.created}}>{{s.updated}}</r.Cell>
            <r.Cell @key="lastAccess" data-test-secret-last-access>
              {{#if s.access}}
                {{s.access.when}}
                <div class="small text-secondary">{{s.access.what}}</div>
              {{else}}
                <span class="text-secondary">{{if this.canAudit "none seen" "needs operator read"}}</span>
              {{/if}}
            </r.Cell>
          </r.Row>
        </:row>
      </Ui::DataTable>
      {{#if this.canAudit}}
        <p class="text-secondary small mt-2" data-test-secret-audit-note>
          Last access comes from the SecretAccess audit records the servers still buffer and those that arrive while
          the page is open. The complete trail is in the audit file of each server.
        </p>
      {{/if}}
      <Secrets::SealStatus @region={{this.region}} class="mt-3" />
    {{/if}}
  </Ui::PageBody>

  {{#if this.creating}}
    <Secrets::ValueForm @namespace={{this.targetNamespace}} @region={{this.region}} @onSaved={{this.created}} @onClose={{this.closeCreate}} />
  {{/if}}
</div>
