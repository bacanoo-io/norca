<Ui::Modal @title={{this.title}} @size="lg" @onClose={{this.close}} data-test-secret-form>
  <:default>
    <form id="secret-value-form" {{on "submit" this.submit}}>
      {{#if this.isNew}}
        <div class="row">
          <div class="col-md-4">
            <Ui::Field @label="Namespace" @required={{true}} as |f|>
              <Ui::Input @id={{f.id}} @value={{this.namespace}} @onInput={{this.setNamespace}} @monospace={{true}} data-test-secret-namespace />
            </Ui::Field>
          </div>
          <div class="col-md-8">
            <Ui::Field @label="Path" @required={{true}} @error={{this.pathError}} @help="For example prod/db/postgres" as |f|>
              <Ui::Input @id={{f.id}} @describedBy={{f.describedBy}} @invalid={{f.invalid}} @value={{this.path}} @onInput={{this.setPath}} @monospace={{true}} data-test-secret-path />
            </Ui::Field>
          </div>
        </div>
        <div class="row">
          <div class="col-md-8">
            <Ui::Field @label="Description" as |f|>
              <Ui::Input @id={{f.id}} @value={{this.description}} @onInput={{this.setDescription}} data-test-secret-description />
            </Ui::Field>
          </div>
          <div class="col-md-4">
            <Ui::Field @label="Owner" as |f|>
              <Ui::Input @id={{f.id}} @value={{this.owner}} @onInput={{this.setOwner}} data-test-secret-owner />
            </Ui::Field>
          </div>
        </div>
      {{else}}
        <p class="text-secondary">
          A write creates version {{this.nextVersion}} with exactly these items; the values of the current
          version are not shown unless you fill them in.
        </p>
      {{/if}}

      <fieldset>
        <legend class="fw-medium fs-4 mb-2">Items</legend>
        {{#each this.itemRows key="id" as |row|}}
          <div class="d-flex flex-wrap align-items-start gap-2 mb-2" data-test-secret-item>
            <div class="norca-secret-key">
              <label class="visually-hidden" for="secret-key-{{row.id}}">Key of item {{row.n}}</label>
              <Ui::Input @id={{concat "secret-key-" row.id}} @value={{row.key}} @onInput={{fn this.setKey row}} @placeholder="key" @monospace={{true}} data-test-secret-item-key />
            </div>
            <div class="flex-fill">
              <label class="visually-hidden" for="secret-value-{{row.id}}">Value of item {{row.n}}</label>
              <Ui::Input @id={{concat "secret-value-" row.id}} @type={{this.valueType}} @value={{row.value}} @onInput={{fn this.setValue row}} @placeholder="value" @monospace={{true}} @autocomplete="new-password" data-test-secret-item-value />
            </div>
            <Ui::Button @variant="ghost" @icon="trash" @iconOnly={{true}} @label={{concat "Remove item " row.n}} data-test-secret-item-remove {{on "click" (fn this.removeRow row)}} />
          </div>
        {{/each}}
        <div class="d-flex flex-wrap gap-2">
          <Ui::Button @size="sm" @icon="plus" data-test-secret-item-add {{on "click" this.addRow}}>Add item</Ui::Button>
          <Ui::Button @size="sm" @variant="ghost" @icon={{if this.showValues "eye-off" "eye"}} data-test-secret-toggle-values {{on "click" this.toggleValues}}>{{if this.showValues "Hide values" "Show values"}}</Ui::Button>
          {{#if this.canFill}}
            <Ui::Button @size="sm" @variant="ghost" @icon="history" @isLoading={{this.isFilling}} data-test-secret-fill {{on "click" this.fillCurrent}}>Fill in the current values</Ui::Button>
          {{/if}}
        </div>
        {{#if this.canFill}}
          <p class="text-secondary small mt-1 mb-0">Filling in reads the current value; the servers audit the read.</p>
        {{/if}}
      </fieldset>

      {{#if (and this.submitted this.problems.length)}}
        <Ui::Alert @tone="warning" class="mt-3 mb-0" data-test-secret-form-problems>
          {{#each this.problems as |p|}}<div>{{p}}</div>{{/each}}
        </Ui::Alert>
      {{/if}}
      {{#if this.error}}
        <Ui::Alert @tone="danger" class="mt-3 mb-0" data-test-secret-form-error>{{this.error}}</Ui::Alert>
      {{/if}}
    </form>
  </:default>
  <:footer>
    <Ui::Button @disabled={{this.isSaving}} data-test-secret-form-cancel {{on "click" this.close}}>Cancel</Ui::Button>
    <Ui::Button @variant="primary" @type="submit" form="secret-value-form" @icon="device-floppy" @isLoading={{this.isSaving}} data-test-secret-form-submit>{{if this.isNew "Create secret" "Write version"}}</Ui::Button>
  </:footer>
</Ui::Modal>
