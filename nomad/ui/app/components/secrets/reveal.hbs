<div data-test-secret-reveal ...attributes>
  {{#if this.items}}
    <Ui::Table
      @caption={{concat "Value of " this.versionLabel}}
      @columns={{array (hash key="key" label="Item" class="w-33") (hash key="value" label="Value")}}
      @rows={{this.rows}}
      class="mb-2"
      data-test-secret-values
      as |row|
    >
      <td class="font-monospace" data-test-secret-value-key>{{row.key}}</td>
      <td>
        <span class="d-flex align-items-center gap-1">
          <span class="font-monospace norca-secret-value" data-test-secret-value>{{row.value}}</span>
          <Ui::CopyButton @text={{row.value}} @label={{concat "Copy the value of " row.key}} class="ms-auto" />
        </span>
      </td>
    </Ui::Table>
    <Ui::Button @size="sm" @icon="eye-off" data-test-secret-hide {{on "click" this.hide}}>Hide</Ui::Button>
  {{else}}
    <div class="d-flex flex-wrap align-items-center gap-2">
      {{#if @canRead}}
        <Ui::Button @size="sm" @icon="eye" @isLoading={{this.isLoading}} data-test-secret-reveal-button {{on "click" this.reveal}}>Reveal {{this.versionLabel}}</Ui::Button>
        <span class="text-secondary small">The read is audited with your token.</span>
      {{else}}
        <span class="text-secondary" data-test-secret-reveal-denied>Revealing values needs read-secret on this path.</span>
      {{/if}}
    </div>
  {{/if}}
  {{#if this.error}}
    <Ui::Alert @tone="danger" class="mt-2 mb-0" data-test-secret-reveal-error>{{this.error}}</Ui::Alert>
  {{/if}}
</div>
