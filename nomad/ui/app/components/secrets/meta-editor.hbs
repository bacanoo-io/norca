<Ui::Modal @title={{concat "Metadata of " @secret.Path}} @size="lg" @onClose={{@onClose}} data-test-secret-meta-editor>
  <p class="text-secondary">
    Description, owner and labels are free text. ExpiresAt is an RFC 3339 time, RotateEvery a duration in
    nanoseconds (both are reminders; nothing rotates automatically), MaxVersions the number of versions kept.
  </p>
  <Ui::Editor
    @label={{concat "Metadata of " @secret.Path}}
    @language="json"
    @schema={{this.schema}}
    @value={{this.text}}
    @onChange={{this.setText}}
    @original={{this.original}}
    @onSubmit={{this.submit}}
    @submitLabel="Save metadata"
    @permission="write secrets at this path"
    @onCancel={{@onClose}}
    @minHeight="14rem"
    @autofocus={{true}}
  />
</Ui::Modal>
