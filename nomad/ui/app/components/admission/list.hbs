<div data-test-admission {{this.setup this.region}}>
  <Ui::PageHeader @pretitle="Configuration" @title="Admission policies" @subtitle={{or this.region "Local region"}} />

  <Ui::PageBody>
    {{#if this.isLoading}}
      <Ui::Card><Ui::Spinner @showLabel={{true}} @label="Loading the admission policies" /></Ui::Card>
    {{else if this.error}}
      <Ui::Alert @tone="warning" @title="The admission policies could not be loaded" data-test-admission-error>{{this.error}}</Ui::Alert>
    {{else}}
      <div class="row row-cards">
        <div class="col-lg-8">
          <Ui::Card @flush={{true}} @title="Policies" data-test-admission-policies>
            <Ui::Table
              @inCard={{true}}
              @caption="Admission policies"
              @columns={{array
                (hash key="name" label="Policy")
                (hash key="action" label="Action")
                (hash key="match" label="Applies to")
                (hash key="rules" label="Rules")
              }}
              @rows={{this.rows}}
              @emptyMessage="No admission policy. Add one with the admission-policy API or CLI to deny or warn about job, Variables and release writes."
              as |p|
            >
              <td>
                <LinkTo @route="admission.policy" @model={{p.Name}} data-test-admission-link={{p.Name}}>{{p.Name}}</LinkTo>
                {{#if p.Description}}<div class="small text-secondary">{{p.Description}}</div>{{/if}}
              </td>
              <td><Ui::Badge @color={{if (eq p.Action "warn") "orange" "red"}} data-test-admission-action>{{or p.Action "deny"}}</Ui::Badge></td>
              <td>{{p.match}}</td>
              <td>{{p.rules}}{{#if p.keys}}, {{p.keys}} trusted keys{{/if}}{{#if p.SchemaFrom}}, schema{{/if}}</td>
            </Ui::Table>
          </Ui::Card>
          <Ui::Card @flush={{true}} @title="Webhooks" @subtitle="From the server configuration" class="mt-3" data-test-admission-webhooks>
            {{#if this.webhooks}}
              <Ui::Table
                @inCard={{true}}
                @caption="Admission webhooks"
                @columns={{array (hash key="name" label="Webhook") (hash key="mode" label="Mode") (hash key="url" label="URL") (hash key="failure" label="On failure")}}
                @rows={{this.webhooks}}
                @emptyMessage="No admission webhook is configured on this server."
                as |w|
              >
                <td>{{w.Name}}</td>
                <td>{{w.Mode}}</td>
                <td class="font-monospace text-break">{{w.URL}}</td>
                <td>{{w.FailurePolicy}}</td>
              </Ui::Table>
            {{else}}
              <p class="text-secondary p-3 mb-0">The webhooks are part of the admission block of the server configuration; reading them needs agent read.</p>
            {{/if}}
          </Ui::Card>
        </div>
        <div class="col-lg-4">
          <Ui::Card @title="Denials" @subtitle="Seen while this page is open" data-test-admission-denials>
            {{#if this.denials.length}}
              <Ui::Timeline @items={{this.denials}} @simple={{true}} />
            {{else}}
              <Ui::EmptyState @compact={{true}} @icon="shield-check" @title="No denials yet" @message="Denied job and Variables writes appear here as they happen. Warnings of warn-mode policies are returned to the submitter only." />
            {{/if}}
          </Ui::Card>
        </div>
      </div>
    {{/if}}
  </Ui::PageBody>
</div>
