<a data-test-image-link href={{this.src}} target="_blank" rel="noopener noreferrer" class="d-inline-block">
  <img data-test-image src={{this.src}} alt={{or this.alt this.fileName}} title={{this.fileName}} class="norca-image-file" onload={{action this.updateImageMeta}} />
</a>
<figcaption class="small text-secondary mt-2">
  <strong class="text-body" data-test-file-name>{{this.fileName}}</strong>
  {{#if (and this.width this.height)}}
    <span data-test-file-stats>({{this.width}}px &times; {{this.height}}px{{#if this.size}}, {{format-bytes this.size}}{{/if}})</span>
  {{/if}}
</figcaption>
