<div
  class="norca-alloc-status-block {{unless this.countToShow 'norca-rest-only'}}"
  style={{html-safe (concat "width: " @width "px")}}
>
  {{#if this.countToShow}}
    <div class="norca-alloc-blocks">
      {{#each (range 0 this.countToShow) as |i|}}
        <JobStatus::IndividualAllocation
          @allocation={{get @allocs i}}
          @status={{@status}}
          @health={{@health}}
          @canary={{@canary}}
          @steady={{@steady}}
        />
      {{/each}}
    </div>
  {{/if}}
  {{#if this.remaining}}
    {{#if (not (eq @status "unplaced"))}}
      <LinkTo
        @route="jobs.job.allocations"
        @model={{@allocs.0.job}}
        @query={{hash status=(concat '["' @status '"]') version=(concat "[" @allocs.0.jobVersion "]")}}
        class="norca-alloc norca-alloc-rest norca-alloc-{{@status}} norca-alloc-{{@health}} norca-alloc-{{@canary}}"
        aria-label="View all {{@count}} {{@status}} allocations"
      >
        <JobStatus::AllocationRest @count={{this.remaining}} @plus={{this.countToShow}} @status={{@status}} @health={{@health}} @canary={{@canary}} @steady={{@steady}} />
      </LinkTo>
    {{else}}
      <span class="norca-alloc norca-alloc-rest norca-alloc-{{@status}} norca-alloc-{{@health}} norca-alloc-{{@canary}}">
        <JobStatus::AllocationRest @count={{this.remaining}} @plus={{this.countToShow}} @status={{@status}} @health={{@health}} @canary={{@canary}} @steady={{@steady}} />
      </span>
    {{/if}}
  {{/if}}
</div>
