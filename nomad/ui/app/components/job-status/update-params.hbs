<Trigger @onError={{action this.onError}} @do={{this.fetchJobDefinition}} as |trigger|>
  {{did-insert trigger.fns.do}}

  <div class="norca-update-params" data-test-update-params>
    <h4 class="h3">Update parameters</h4>
    {{#if (and trigger.data.isSuccess (not trigger.data.isError))}}
      <ul class="norca-update-params-list" tabindex="0" aria-label="Update parameters of the task groups">
        {{#each this.updateParamGroups as |group|}}
          <li>
            <span class="fw-medium">Group "{{group.name}}"</span>
            <ul>
              {{#each-in group.update as |k v|}}
                <li class="font-monospace">
                  <span class="text-primary">{{k}}</span> = <span>{{v}}</span>
                </li>
              {{/each-in}}
            </ul>
          </li>
        {{/each}}
      </ul>
    {{/if}}
    {{#if trigger.data.isBusy}}
      <Ui::Spinner @showLabel={{true}} @label="Loading parameters" />
    {{/if}}
    {{#if trigger.data.isError}}
      <p class="text-danger">Error loading parameters</p>
    {{/if}}
  </div>
</Trigger>
