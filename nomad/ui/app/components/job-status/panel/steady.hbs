<Ui::Card
  class="mb-3 norca-job-status norca-job-status-steady {{if (eq @statusMode 'historical') 'norca-job-status-historical' 'norca-job-status-current'}}"
  data-test-job-status-panel
  data-test-status-mode={{@statusMode}}
>
  <:actions>
    <div class="d-flex flex-wrap align-items-center gap-2 w-100">
      <h2 class="h3 m-0 d-inline-flex align-items-center gap-2">
        Status
        <Ui::Badge @color={{this.currentStatusColor}} @solid={{true}} data-test-job-status-badge>{{this.currentStatus.label}}</Ui::Badge>
      </h2>
      <span class="ms-auto d-inline-flex gap-1" role="group" aria-label="Status view">
        <Ui::Button
          @size="sm"
          @variant={{if (eq @statusMode "current") "primary" "secondary"}}
          aria-pressed={{if (eq @statusMode "current") "true" "false"}}
          data-test-status-mode-current
          {{on "click" (fn (optional @setStatusMode) "current")}}
        >Current</Ui::Button>
        <Ui::Button
          @size="sm"
          @variant={{if (eq @statusMode "historical") "primary" "secondary"}}
          aria-pressed={{if (eq @statusMode "historical") "true" "false"}}
          data-test-status-mode-historical
          {{on "click" (fn (optional @setStatusMode) "historical")}}
        >Historical</Ui::Button>
      </span>
    </div>
  </:actions>
  <:default>
    {{#if (eq @statusMode "historical")}}
      <Jobs::AllocationSummary @summary={{@job.summary}} @job={{@job}} />
    {{else}}
      <h3 class="h2 mb-3 norca-running-allocs-title">
        {{#if this.allAllocsComplete}}
          All allocations have completed successfully
        {{else}}
          <strong>
            {{@job.runningAllocs ~}}
            {{#unless this.atMostOneAllocPerNode ~}}
              {{#if (eq @job.type "batch") ~}}
                /{{this.totalNonCompletedAllocs}}
              {{else ~}}
                /{{this.totalAllocs}}
              {{/if}}
            {{/unless}}
          </strong>
          {{#if (eq @job.type "batch") ~}}Remaining{{/if}}
          {{pluralize "Allocation" @job.runningAllocs}} Running
        {{/if}}
      </h3>
      <JobStatus::AllocationStatusRow @allocBlocks={{this.allocBlocks}} @steady={{true}} />

      <div class="norca-legend-and-summary {{if @job.latestDeployment 'norca-has-latest-deployment'}}">
        <ul class="norca-alloc-legend" aria-label="Allocation states">
          {{#each this.allocTypes as |type|}}
            {{#let (get (get (get (get this.allocBlocks type.label) "healthy") "nonCanary") "length") as |count|}}
              <li class="norca-legend-item {{if (eq count 0) 'norca-legend-faded'}}">
                {{#if (and (not (eq type.label "unplaced")) count)}}
                  <LinkTo
                    @route="jobs.job.allocations"
                    @model={{@job}}
                    @query={{hash status=(concat '["' type.label '"]') version=(concat "[" (map-by "version" this.versions) "]")}}
                    class="norca-legend-link"
                  >
                    <span class="norca-alloc norca-alloc-{{type.label}}" aria-hidden="true"></span>
                    <span class="norca-legend-count">{{count}} {{capitalize type.label}}</span>
                  </LinkTo>
                {{else}}
                  <span class="norca-legend-link">
                    <span class="norca-alloc norca-alloc-{{type.label}}" aria-hidden="true"></span>
                    <span class="norca-legend-count">{{count}} {{capitalize type.label}}</span>
                  </span>
                {{/if}}
              </li>
            {{/let}}
          {{/each}}
        </ul>

        <JobStatus::FailedOrLost
          @rescheduledAllocs={{this.rescheduledAllocs}}
          @restartedAllocs={{this.restartedAllocs}}
          @job={{@job}}
          @supportsRescheduling={{this.supportsRescheduling}}
        />

        <section class="norca-versions">
          <h4 class="h4">Versions</h4>
          <ul>
            {{#each this.versions as |versionObj|}}
              <li>
                <LinkTo
                  data-version={{versionObj.version}}
                  @route="jobs.job.allocations"
                  @model={{@job}}
                  @query={{hash version=(concat "[" versionObj.version "]") status=(concat '["running", "pending", "failed"]')}}
                >
                  <Ui::Badge @color="secondary">{{if (eq versionObj.version "unknown") "unknown" (concat "v" versionObj.version)}}</Ui::Badge>
                  <Ui::Badge @color="blue" @solid={{true}}>{{versionObj.allocations.length}}</Ui::Badge>
                  <span class="visually-hidden">{{pluralize "allocation" versionObj.allocations.length}}</span>
                </LinkTo>
              </li>
            {{/each}}
          </ul>
        </section>

        {{#if @job.latestDeployment}}
          <JobStatus::LatestDeployment @job={{@job}} />
        {{/if}}
      </div>

      {{#if this.latestVersionAllocations.length}}
        <div class="mt-4">
          <JobStatus::DeploymentHistory
            @title="Allocation History"
            @allocations={{this.latestVersionAllocations}}
            @isHidden={{true}}
          />
        </div>
      {{/if}}
    {{/if}}
  </:default>
</Ui::Card>
