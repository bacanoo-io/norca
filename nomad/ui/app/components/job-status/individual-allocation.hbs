{{#if (eq @status "unplaced")}}
  <span
    class="norca-alloc norca-alloc-{{@status}} norca-alloc-{{@health}} norca-alloc-{{@canary}}"
    role="img"
    aria-label="Unplaced allocation"
  ></span>
{{else}}
  <Ui::Tooltip @text={{get @allocation "shortId"}} @below={{true}}>
    <LinkTo
      @route="allocations.allocation"
      @model={{@allocation.id}}
      class="norca-alloc norca-alloc-{{@status}} norca-alloc-{{@health}} norca-alloc-{{@canary}}"
      aria-label="Allocation {{get @allocation 'shortId'}}, {{@status}}"
    >
      {{#unless @steady}}
        {{#if (eq @canary "canary")}}
          <span class="norca-alloc-canary-indicator"></span>
        {{/if}}
        {{#if (eq @status "running")}}
          <span class="norca-alloc-health-indicator">
            {{#if (eq @health "healthy")}}
              <Ui::Icon @name="check" @size="sm" />
            {{else if (eq @health "unhealthy")}}
              <Ui::Icon @name="x" @size="sm" />
            {{else}}
              <Ui::Icon @name="loader-2" @size="sm" />
            {{/if}}
          </span>
        {{/if}}
      {{/unless}}
    </LinkTo>
  </Ui::Tooltip>
{{/if}}
