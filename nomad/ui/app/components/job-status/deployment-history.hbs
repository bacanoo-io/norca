<div class="norca-deployment-history" data-test-deployment-history>
  <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <h4 class="h3 m-0">
      <Ui::Button
        @variant="ghost"
        @icon={{if this.isHidden "chevron-down" "chevron-up"}}
        aria-expanded={{if this.isHidden "false" "true"}}
        data-test-history-toggle
        {{on "click" (fn (mut this.isHidden) (not this.isHidden))}}
      >{{or @title "Deployment History"}}</Ui::Button>
    </h4>
    {{#unless this.isHidden}}
      <Ui::Input
        @icon="search"
        @type="search"
        @placeholder="Search events..."
        @value={{this.searchTerm}}
        @onInput={{fn (mut this.searchTerm)}}
        aria-label="Search events"
        class="ms-auto"
        data-test-history-search
      />
    {{/unless}}
  </div>
  {{#unless this.isHidden}}
    <ol class="norca-history-list">
      {{#each this.history as |deployment-log|}}
        <li class="norca-history-item {{if (eq deployment-log.exitCode 1) 'norca-history-error'}}">
          <LinkTo @route="allocations.allocation" @model={{deployment-log.state.allocation.id}} class="font-monospace">{{deployment-log.state.allocation.shortId}}</LinkTo>
          <span class="flex-fill"><strong>{{deployment-log.type}}:</strong> {{deployment-log.message}}</span>
          <span class="text-secondary tabular-nums">{{format-ts deployment-log.time}}</span>
        </li>
      {{else}}
        {{#if this.errorState}}
          <li class="norca-history-item">Error loading deployment history</li>
        {{else if this.deploymentAllocations.length}}
          {{#if this.searchTerm}}
            <li class="norca-history-item" data-test-history-search-no-match>No events match {{this.searchTerm}}</li>
          {{else}}
            <li class="norca-history-item">No deployment events yet</li>
          {{/if}}
        {{else}}
          <li class="norca-history-item">Loading deployment events</li>
        {{/if}}
      {{/each}}
    </ol>
  {{/unless}}
</div>
