<section class="norca-latest-deployment">
  <h4 class="h4">
    <LinkTo @route="jobs.job.deployments" @model={{@job}}>
      Latest Deployment
      <Ui::Icon @name="arrow-right" @size="sm" />
    </LinkTo>
  </h4>
  <Ui::StatusIndicator @status={{this.status}} @label={{capitalize this.status}} />
  <p class="m-0">{{this.healthyAllocs}}/{{this.desiredTotal}} Healthy</p>
</section>
