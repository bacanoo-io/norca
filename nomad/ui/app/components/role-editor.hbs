<form class="acl-form role-editor" autocomplete="off" novalidate {{on "submit" (perform this.save)}} data-test-role-editor>
  <div class="acl-form-row">
    <Hds::Form::TextInput::Field
      @isRequired={{true}}
      @value={{this.role.name}}
      {{on "input" this.updateName}}
      data-test-role-name-input
      as |F|
    >
      <F.Label>Role name</F.Label>
      <F.HelperText>Letters, numbers and dashes, up to 128 characters.</F.HelperText>
    </Hds::Form::TextInput::Field>
  </div>

  <div class="acl-form-row">
    <Hds::Form::TextInput::Field
      @isOptional={{true}}
      @value={{this.role.description}}
      {{on "input" this.updateDescription}}
      data-test-role-description-input
      as |F|
    >
      <F.Label>Description</F.Label>
    </Hds::Form::TextInput::Field>
  </div>

  <div class="acl-form-row">
    <h3 class="title is-5">Policies</h3>
    <p class="acl-explainer">Tokens linked to this role get the permissions of every policy selected here.</p>
    {{#if this.availablePolicies.length}}
      <Hds::Table
        class="acl-table"
        @model={{this.availablePolicies}}
        @columns={{this.policyColumns}}
        @sortBy="name"
        @density="short"
        data-test-role-policies
      >
        <:body as |B|>
          <B.Tr>
            <B.Td>
              <input
                type="checkbox"
                class="hds-form-checkbox"
                aria-label="Link policy {{B.data.name}}"
                checked={{includes B.data.id this.selectedPolicyIds}}
                {{on "change" (fn this.togglePolicy B.data)}}
              />
            </B.Td>
            <B.Td data-test-policy-name>{{B.data.name}}</B.Td>
            <B.Td>{{B.data.description}}</B.Td>
          </B.Tr>
        </:body>
      </Hds::Table>
    {{else}}
      <p class="empty-message-body" data-test-role-no-policies>
        No policies exist yet. A role needs at least one policy.
      </p>
    {{/if}}
  </div>

  <footer class="acl-form-footer">
    <Hds::ButtonSet>
      {{#if (can "write role")}}
        <Hds::Button
          @text={{if this.role.isNew "Create Role" "Save Role"}}
          type="submit"
          disabled={{this.save.isRunning}}
          data-test-save-role
        />
      {{/if}}
      <Hds::Button
        @text="Cancel"
        @color="secondary"
        @route="access-control.roles"
        data-test-role-cancel
      />
    </Hds::ButtonSet>
  </footer>
</form>
