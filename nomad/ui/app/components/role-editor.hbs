<form class="norca-acl-form" autocomplete="off" novalidate {{on "submit" (perform this.save)}} data-test-role-editor>
  <Ui::Card class="mb-3">
    <Ui::Field @label="Role name" @required={{true}} @help="Letters, numbers and dashes, up to 128 characters." as |f|>
      <Ui::Input @id={{f.id}} @value={{this.role.name}} @required={{true}} @describedBy={{f.describedBy}} @onInput={{this.updateName}} data-test-role-name-input />
    </Ui::Field>
    <Ui::Field @label="Description (optional)" class="mb-0" as |f|>
      <Ui::Input @id={{f.id}} @value={{this.role.description}} @onInput={{this.updateDescription}} data-test-role-description-input />
    </Ui::Field>
  </Ui::Card>

  <h2 class="h3 mb-1">Policies</h2>
  <p class="text-secondary">Tokens linked to this role get the permissions of every policy selected here.</p>
  {{#if this.availablePolicies.length}}
    <Ui::Table @caption="Policies of the role" @columns={{this.policyColumns}} @rows={{this.availablePolicies}} class="mb-3" data-test-role-policies as |policy|>
      <td class="w-1">
        <Ui::Checkbox @checked={{includes policy.id this.selectedPolicyIds}} @onChange={{fn this.togglePolicy policy}} aria-label="Link policy {{policy.name}}" />
      </td>
      <td data-test-policy-name>{{policy.name}}</td>
      <td>{{policy.description}}</td>
    </Ui::Table>
  {{else}}
    <p class="text-secondary" data-test-role-no-policies>No policies exist yet. A role needs at least one policy.</p>
  {{/if}}

  <div class="d-flex flex-wrap gap-2">
    {{#if (can "write role")}}
      <Ui::Button @variant="primary" @type="submit" @disabled={{this.save.isRunning}} @isLoading={{this.save.isRunning}} data-test-save-role>
        {{if this.role.isNew "Create Role" "Save Role"}}
      </Ui::Button>
    {{/if}}
    <Ui::Button @variant="ghost" @route="access-control.roles" data-test-role-cancel>Cancel</Ui::Button>
  </div>
</form>
