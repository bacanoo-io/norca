{{#if this.keyboard.shortcutsVisible}}
  {{keyboard-commands (array this.escapeCommand)}}
  <Ui::Modal
    @title="Keyboard Shortcuts"
    @size="lg"
    @onClose={{this.hide}}
    aria-label="Keyboard shortcuts"
    data-test-keyboard-shortcuts
    {{on-click-outside this.hide}}
  >
    <:default>
      <p class="text-secondary">Click a key pattern to re-bind it to a shortcut of your choosing.</p>
      <ul class="list-unstyled mb-0 norca-shortcuts">
        {{#each this.commands as |command|}}
          <li class="norca-shortcut" data-test-command-label={{command.label}}>
            <strong>{{command.label}}</strong>
            <span class="d-flex align-items-center gap-2 ms-auto">
              {{#if command.recording}}
                <span class="text-secondary small">Recording; ESC to cancel.</span>
              {{else if command.custom}}
                <Ui::Button
                  @size="sm"
                  @variant="ghost"
                  data-test-reset-to-default
                  {{on "click" (fn this.keyboard.resetCommandToDefault command)}}
                >reset to default</Ui::Button>
              {{/if}}
              <button
                data-test-rebinder
                class="norca-shortcut-keys"
                disabled={{or (not command.rebindable) command.recording}}
                type="button"
                aria-label="Re-bind {{command.label}}"
                {{on "click" (fn this.keyboard.rebindCommand command)}}
              >
                {{#each command.pattern as |key|}}
                  <kbd>{{clean-keycommand key}}</kbd>
                {{/each}}
              </button>
            </span>
          </li>
        {{/each}}
      </ul>
    </:default>
    <:footer>
      <Ui::Switch
        @switch={{true}}
        @label="Keyboard shortcuts {{if this.keyboard.enabled 'enabled' 'disabled'}}"
        @checked={{this.keyboard.enabled}}
        @onChange={{this.toggleListener}}
        class="me-auto mb-0"
        data-test-enable-shortcuts-toggle
        data-test-enabled={{this.keyboard.enabled}}
      />
    </:footer>
  </Ui::Modal>
{{/if}}

{{#if (and this.keyboard.enabled this.keyboard.displayHints)}}
  {{#each this.hints as |hint|}}
    <span
      {{did-insert (fn this.tetherToElement hint.element hint)}}
      {{will-destroy (fn this.untetherFromElement hint)}}
      data-test-keyboard-hint
      data-shortcut={{hint.pattern}}
      class="norca-keyboard-hint {{if hint.menuLevel "norca-keyboard-hint-menu"}}"
      aria-hidden="true"
    >
      {{#each hint.pattern as |key|}}
        <span>{{key}}</span>
      {{/each}}
    </span>
  {{/each}}
{{/if}}
