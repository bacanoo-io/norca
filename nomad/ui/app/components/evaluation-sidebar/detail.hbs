{{#let this.currentEvalDetail as |evaluation|}}
  {{#if this.isSideBarOpen}}
    <Ui::SidePanel
      @onClose={{this.closeSidebar}}
      data-test-eval-detail
      data-test-eval-detail-is-open="true"
    >
      <:title>
        {{#if this.isSuccess}}
          <span class="d-inline-flex align-items-center gap-2" data-test-eval-detail-header>
            <span class="font-monospace" data-test-title>{{evaluation.shortId}}</span>
            <Ui::StatusIndicator @status={{evaluation.status}} />
          </span>
        {{else if this.isError}}
          <span data-test-eval-detail-header>Evaluation</span>
        {{else}}
          Evaluation
        {{/if}}
      </:title>
      <:default>
        {{#if this.isLoading}}
          <div data-test-eval-loading class="py-4 text-center">
            <Ui::Spinner @showLabel={{true}} @label="Loading the evaluation" />
          </div>
        {{/if}}
        {{#if this.isError}}
          <Ui::EmptyState
            @icon="alert-triangle"
            @title="Not Found"
            data-test-eval-error
          >
            <p class="text-secondary" data-test-error-message>
              The requested evaluation could not be found. You may not be authorized to view this evaluation,
              it may have been garbage collected, or the ID is invalid.
            </p>
          </Ui::EmptyState>
        {{/if}}
        {{#if this.isSuccess}}
          <Ui::Card @title="Evaluation details" class="mb-3" data-test-eval-details>
            <Ui::Datagrid as |g|>
              <g.Item @title="Job">
                <LinkTo
                  data-test-evaluation-job
                  @model={{concat evaluation.plainJobId "@" evaluation.namespace}}
                  @route="jobs.job"
                >{{evaluation.plainJobId}}</LinkTo>
              </g.Item>
              <g.Item @title="Triggered by">{{evaluation.triggeredBy}}</g.Item>
              <g.Item @title="Priority">{{evaluation.priority}}</g.Item>
              <g.Item @title="Created">{{format-month-ts evaluation.createTime}}</g.Item>
              <g.Item @title="Placement failure">{{evaluation.hasPlacementFailures}}</g.Item>
            </Ui::Datagrid>
          </Ui::Card>

          {{#if evaluation.failedTGAllocs}}
            <Ui::Card @title="Placement failures" class="mb-3" data-test-eval-placement-failures>
              {{#each evaluation.failedTGAllocs as |placementFailure|}}
                <PlacementFailure @failedTGAlloc={{placementFailure}} />
              {{/each}}
            </Ui::Card>
          {{/if}}

          {{#if this.descendentsMap}}
            <EvaluationSidebar::RelatedEvaluations
              @fns={{hash
                handleResize=this.handleResize
                handleEvaluationClick=@fns.handleEvaluationClick
              }}
              @data={{hash
                width=this.width
                height=this.height
                parentEvaluation=this.parentEvaluation
                descendentsMap=this.descendentsMap
                activeEvaluationID=this.currentEvalDetail.id
              }}
            />
          {{else}}
            <Ui::Card @title="Related evaluations" class="mb-3">
              <p class="text-secondary mb-0" data-test-eval-error data-test-error-message>
                The related evaluations cannot be visualized.
              </p>
            </Ui::Card>
          {{/if}}

          <Ui::Card @title="Evaluation response" data-test-eval-response>
            <Ui::CodeBlock @code={{stringify-object evaluation}} @label="Evaluation response" @copy={{true}} data-test-json-viewer />
          </Ui::Card>
        {{/if}}
      </:default>
    </Ui::SidePanel>
  {{/if}}
{{/let}}
