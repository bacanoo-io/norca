<Providers::ActorsRelationships as |actors|>
  <div
    class="norca-related-eval {{if (eq @eval.id @activeEvaluationID) "norca-related-eval-active"}}"
    data-eval={{@eval.id}}
    ...attributes
    {{did-insert (fn actors.fns.registerActor @eval)}}
    {{will-destroy (fn actors.fns.deregisterActor @eval)}}
  >
    {{#if (eq @eval.id @activeEvaluationID)}}
      <span class="font-monospace" aria-current="true" data-test-rel-eval={{@eval.id}}>
        {{@eval.shortId}}
      </span>
    {{else}}
      <button type="button" class="norca-related-eval-link font-monospace" data-test-rel-eval={{@eval.id}} {{on "click" @onClick}}>
        {{@eval.shortId}}
      </button>
    {{/if}}
    <Ui::StatusIndicator @status={{@eval.status}} class="small" />
  </div>
</Providers::ActorsRelationships>
