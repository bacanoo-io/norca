<Ui::Card @title="Related evaluations" class="mb-3">
  <div class="norca-related-evals" data-test-eval-container>
    <div class="norca-related-evals-content" {{on-resize @fns.handleResize}}>
      {{#if (and @data.width @data.height)}}
        <Providers::ActorsRelationships as |actors|>
          <svg
            width={{@data.width}}
            height="100%"
            class="norca-related-evals-links"
            aria-hidden="true"
            {{did-update actors.fns.recalcCurves @data.width}}
          >
            {{#each actors.data.relationships as |r|}}
              <path d={{r.d}} class="norca-related-evals-link"></path>
              <circle cx={{r.sx}} cy={{r.sy}} r="4" class="norca-related-evals-end"></circle>
              <circle cx={{r.ex}} cy={{r.ey}} r="4" class="norca-related-evals-end"></circle>
            {{/each}}
          </svg>
        </Providers::ActorsRelationships>
      {{/if}}
      <div>
        <EvaluationSidebar::EvaluationActor
          @eval={{@data.parentEvaluation}}
          @activeEvaluationID={{@data.activeEvaluationID}}
          @onClick={{fn @fns.handleEvaluationClick @data.parentEvaluation}}
        />
      </div>
      {{#each @data.descendentsMap as |evals|}}
        <div class="norca-related-evals-column">
          {{#each evals as |eval|}}
            <EvaluationSidebar::EvaluationActor
              @eval={{eval.data}}
              @activeEvaluationID={{@data.activeEvaluationID}}
              @onClick={{fn @fns.handleEvaluationClick eval.data}}
            />
          {{/each}}
        </div>
      {{/each}}
    </div>
  </div>
</Ui::Card>
