<Ui::Card @title="Driver status" @flush={{true}} data-test-driver-status ...attributes>
  <Ui::ListGroup @flush={{true}} as |list|>
    {{#each @drivers as |driver|}}
      <list.Item>
        <div class="row align-items-center g-2 {{unless driver.detected 'text-secondary'}}" data-test-accordion-head>
          <div class="col-6 col-md-2 fw-medium">
            <span data-test-name>{{driver.name}}</span>
          </div>
          <div class="col-6 col-md-2">
            {{#if driver.detected}}
              <span data-test-health={{driver.healthClass}}>
                <Ui::StatusIndicator @status={{if driver.healthy "healthy" "failed"}} @label={{if driver.healthy "Healthy" "Unhealthy"}} />
              </span>
            {{/if}}
          </div>
          <div class="col-6 col-md-3">
            <span class="text-secondary">Detected</span>
            <span data-test-detected>{{if driver.detected "Yes" "No"}}</span>
          </div>
          <div class="col-6 col-md-3">
            <span class="text-secondary">Last updated</span>
            <Ui::Tooltip @text={{format-ts driver.updateTime}}>
              <span tabindex="0" data-test-last-updated>{{moment-from-now driver.updateTime interval=1000}}</span>
            </Ui::Tooltip>
          </div>
          <div class="col-12 col-md-2 text-end">
            {{#if driver.detected}}
              <Ui::Button
                @size="sm"
                @variant="ghost"
                @icon={{if (this.isExpanded driver) "chevron-up" "chevron-down"}}
                aria-expanded={{if (this.isExpanded driver) "true" "false"}}
                aria-label="{{if (this.isExpanded driver) 'Hide' 'Show'}} the details of {{driver.name}}"
                data-test-accordion-toggle
                {{on "click" (fn this.toggle driver)}}
              >details</Ui::Button>
            {{/if}}
          </div>
        </div>
        {{#if (this.isExpanded driver)}}
          <div class="mt-3" data-test-accordion-body>
            <p class="text-secondary" data-test-health-description>{{driver.healthDescription}}</p>
            <div data-test-driver-attributes>
              <h3 class="h4 mb-2">{{capitalize driver.name}} attributes</h3>
              {{#if driver.attributes.structured}}
                <Ui::KeyValueTable @data={{driver.attributesShort}} @caption="Attributes of the {{driver.name}} driver" />
              {{else}}
                <Ui::EmptyState @compact={{true}} @title="No Driver Attributes" />
              {{/if}}
            </div>
          </div>
        {{/if}}
      </list.Item>
    {{/each}}
  </Ui::ListGroup>
</Ui::Card>
