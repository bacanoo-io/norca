  The drain strategy of a draining client and the progress of the drain.
~}}
<Ui::Card @title="Drain strategy" class="mb-3" data-test-drain-details>
  <:actions>
    {{#unless @client.drainStrategy.isForced}}
      <Ui::ConfirmButton
        @label="Force Drain"
        @icon="alert-triangle"
        @variant="warning"
        @idleVariant="warning"
        @message="Are you sure you want to force drain?"
        @confirmLabel="Yes, Force Drain"
        @cancelLabel="Cancel"
        @isRunning={{@isForcing}}
        @onConfirm={{@onForce}}
        data-test-force
      />
    {{/unless}}
  </:actions>
  <:default>
    <Ui::Datagrid class="mb-3" as |g|>
      {{#unless @client.drainStrategy.hasNoDeadline}}
        <g.Item @title="Duration">
          {{#if @client.drainStrategy.isForced}}
            <span data-test-duration>--</span>
          {{else}}
            <Ui::Tooltip @text={{format-duration @client.drainStrategy.deadline}}>
              <span tabindex="0" aria-label={{format-duration @client.drainStrategy.deadline}} data-test-duration>
                {{format-duration @client.drainStrategy.deadline}}
              </span>
            </Ui::Tooltip>
          {{/if}}
        </g.Item>
      {{/unless}}
      <g.Item @title={{if @client.drainStrategy.hasNoDeadline "Deadline" "Remaining"}}>
        {{#if @client.drainStrategy.hasNoDeadline}}
          <span data-test-deadline>No deadline</span>
        {{else if @client.drainStrategy.isForced}}
          <span data-test-deadline>--</span>
        {{else}}
          <Ui::Tooltip @text={{format-ts @client.drainStrategy.forceDeadline}}>
            <span tabindex="0" aria-label={{format-ts @client.drainStrategy.forceDeadline}} data-test-deadline>
              {{moment-from-now @client.drainStrategy.forceDeadline interval=1000 hideAffix=true}}
            </span>
          </Ui::Tooltip>
        {{/if}}
      </g.Item>
      <g.Item @title="Force drain">
        <span data-test-force-drain-text>
          {{#if @client.drainStrategy.isForced}}
            <Ui::Icon @name="alert-triangle" class="text-warning" /> Yes
          {{else}}
            No
          {{/if}}
        </span>
      </g.Item>
      <g.Item @title="Drain system jobs">
        <span data-test-drain-system-jobs-text>{{if @client.drainStrategy.ignoreSystemJobs "No" "Yes"}}</span>
      </g.Item>
    </Ui::Datagrid>
    <div class="row g-3 align-items-center">
      <div class="col-auto">
        <Ui::Stat @label="Complete" @value={{@client.completeAllocations.length}} @color="green" data-test-complete-count />
      </div>
      <div class="col-auto">
        <Ui::Stat @label="Migrating" @value={{@client.migratingAllocations.length}} @color="blue" data-test-migrating-count />
      </div>
      <div class="col-auto">
        <Ui::Stat @label="Remaining" @value={{@client.runningAllocations.length}} data-test-remaining-count />
      </div>
      <div class="col">
        <h3 class="h4 mb-1">Status</h3>
        {{#if @client.lastMigrateTime}}
          <p class="mb-0" data-test-status>
            {{moment-to-now @client.lastMigrateTime interval=1000 hideAffix=true}}
            since an allocation was successfully migrated.
          </p>
        {{else}}
          <p class="mb-0" data-test-status>No allocations migrated.</p>
        {{/if}}
      </div>
    </div>
  </:default>
</Ui::Card>
