{{#let (cannot "exec allocation" namespace=this.job.namespaceName) as |cannotExec|}}
  <Ui::Button
    @icon="terminal-2"
    @disabled={{cannotExec}}
    title={{if cannotExec "You don’t have permission to exec"}}
    aria-label={{if cannotExec "You don’t have permission to exec"}}
    data-test-exec-button
    {{on "click" (action "open")}}
    {{keyboard-shortcut
      label="Exec"
      pattern=(array "e" "x" "e" "c")
      action=(action "open")
    }}
  >Exec</Ui::Button>
{{/let}}
