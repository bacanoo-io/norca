<span class="norca-exec-task-label">
  {{#if this.active}}
    <span class="norca-exec-task-active" role="img" aria-label="Current task" data-test-task-active></span>
  {{/if}}
  {{this.task.name}}
</span>
{{#if this.shouldOpenInNewWindow}}
  <Ui::Icon @name="external-link" @label="Open in a new window" class="norca-exec-task-open" />
{{/if}}
