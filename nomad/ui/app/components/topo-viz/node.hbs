<div data-test-topo-viz-node class="norca-topo-node {{unless this.allocations.length "norca-topo-node-empty"}}" {{did-insert this.reloadNode}}>
  {{#unless @isDense}}
    <p data-test-label class="norca-topo-node-label small mb-1">
      {{#if @node.node.isDraining}}
        <span data-test-status-icon aria-label="Client is draining" title="Client is draining"><Ui::Icon @name="clock" @size="sm" class="text-info" /></span>
      {{else if (not @node.node.isEligible)}}
        <span data-test-status-icon aria-label="Client is ineligible" title="Client is ineligible"><Ui::Icon @name="lock" @size="sm" class="text-warning" /></span>
      {{/if}}
      <strong title="Node name"><LinkTo @route="clients.client" @model={{@node.node.id}}>{{@node.node.name}}</LinkTo></strong>
      <span class="ms-2" title="Number of allocations">{{this.count}} Allocs</span>
      <span class="ms-2 text-secondary" title="Node pool">{{@node.node.nodePool}}</span>
      <span class="ms-2 text-secondary">
        <span title="Node memory">{{format-scheduled-bytes @node.memory start="MiB"}}</span>,
        <span title="Node CPU">{{format-scheduled-hertz @node.cpu}}</span>
      </span>
      <span class="ms-2 text-secondary" title="Node status">{{@node.node.status}}</span>
      {{#if @node.node.norcaVersion}}
        <span class="ms-2 text-secondary" title="Norca version, Nomad API {{@node.node.version}} compatible">Norca {{@node.node.norcaVersion}}</span>
      {{else}}
        <span class="ms-2 text-secondary" title="Nomad version (the client predates Norca)">Nomad {{@node.node.version}}</span>
      {{/if}}
    </p>
  {{/unless}}
  {{! template-lint-disable no-invalid-interactive no-down-event-binding }}
  <svg
    data-test-topo-node-svg
    class="norca-topo-chart"
    height="{{this.totalHeight}}px"
    role="group"
    aria-label="Allocations on {{@node.node.name}}"
    {{did-insert this.render}}
    {{did-update this.updateRender}}
    {{window-resize this.render}}
    {{on "mouseout" this.allocationBlur}}>
    <defs>
      <clipPath id="{{this.maskId}}">
        <rect x="0" y="0" width="{{this.dimensionsWidth}}px" height="{{this.maskHeight}}px" rx="2px" ry="2px" />
      </clipPath>
    </defs>
    {{#if @isDense}}
      <rect
        data-test-node-background
        class="norca-topo-node-background norca-topo-interactive {{if @node.isSelected "norca-topo-selected"}}"
        width="100%"
        height="{{this.totalHeight}}px"
        rx="2px"
        ry="2px"
        tabindex="0"
        role="button"
        aria-pressed={{if @node.isSelected "true" "false"}}
        aria-label="Client {{@node.node.name}}"
        {{on "click" this.selectNode}}
        {{on "keydown" this.nodeKeydown}} />
    {{else}}
      <rect
        data-test-node-background
        class="norca-topo-node-background {{if @node.isSelected "norca-topo-selected"}}"
        width="100%"
        height="{{this.totalHeight}}px"
        rx="2px"
        ry="2px"
        {{on "click" this.selectNode}} />
    {{/if}}
    {{#if this.allocations.length}}
      <g
        class="norca-topo-dimensions {{if this.activeAllocation "norca-topo-dimensions-active"}}"
        transform="translate({{this.paddingLeft}},{{this.padding}})"
        width="{{this.dimensionsWidth}}px"
        height="{{this.maskHeight}}px"
        pointer-events="all"
        {{on "mouseleave" this.clearHighlight}}
      >
        <g class="norca-topo-memory">
          {{#if this.data.memoryLabel}}
            <text class="norca-topo-axis-label" aria-hidden="true" transform="translate({{this.data.memoryLabel.x}},{{this.data.memoryLabel.y}})">M</text>
          {{/if}}
          {{#if this.data.memoryRemainder}}
            <rect
              class="norca-topo-free"
              x="{{this.data.memoryRemainder.x}}px"
              width="{{this.data.memoryRemainder.width}}px"
              height="{{this.height}}px" />
          {{/if}}
          {{#each this.data.memory key="allocation.id" as |memory|}}
            {{! The memory bar is the keyboard target of an allocation; its CPU bar mirrors it. }}
            <g
              data-test-memory-rect="{{memory.allocation.allocation.id}}"
              class="norca-topo-bar norca-topo-{{memory.className}} {{if (eq this.activeAllocation memory.allocation) "norca-topo-active"}} {{if memory.allocation.isSelected "norca-topo-selected"}}"
              clip-path="url(#{{this.maskId}})"
              data-allocation-id="{{memory.allocation.allocation.id}}"
              tabindex="0"
              role="button"
              aria-pressed={{if memory.allocation.isSelected "true" "false"}}
              aria-label="Allocation {{memory.allocation.allocation.shortId}} of {{memory.allocation.allocation.job.name}}/{{memory.allocation.allocation.taskGroupName}}, {{memory.allocation.allocation.clientStatus}}"
              {{on "mouseenter" (fn this.highlightAllocation memory.allocation)}}
              {{on "focus" (fn this.highlightAllocation memory.allocation)}}
              {{on "blur" this.allocationBlur}}
              {{on "click" (fn this.selectAllocation memory.allocation)}}
              {{on "keydown" (fn this.allocationKeydown memory.allocation)}}>
              <rect
                width="{{memory.width}}px"
                height="{{if memory.allocation.isSelected this.selectedHeight this.height}}px"
                x="{{memory.x}}px"
                y="{{if memory.allocation.isSelected 0.5 0}}px"
                class="norca-topo-layer-0" />
              {{#if (or (eq memory.className "starting") (eq memory.className "pending"))}}
                <rect
                  width="{{memory.width}}px"
                  height="{{if memory.allocation.isSelected this.selectedHeight this.height}}px"
                  x="{{memory.x}}px"
                  y="{{if memory.allocation.isSelected 0.5 0}}px"
                  class="norca-topo-layer-1" />
              {{/if}}
            </g>
          {{/each}}
        </g>
        <g class="norca-topo-cpu">
          {{#if this.data.cpuLabel}}
            <text class="norca-topo-axis-label" aria-hidden="true" transform="translate({{this.data.cpuLabel.x}},{{this.data.cpuLabel.y}})">C</text>
          {{/if}}
          {{#if this.data.cpuRemainder}}
            <rect
              class="norca-topo-free"
              x="{{this.data.cpuRemainder.x}}px"
              y="{{this.yOffset}}px"
              width="{{this.data.cpuRemainder.width}}px"
              height="{{this.height}}px" />
          {{/if}}
          {{#each this.data.cpu key="allocation.id" as |cpu|}}
            <g
              data-test-cpu-rect="{{cpu.allocation.allocation.id}}"
              class="norca-topo-bar norca-topo-{{cpu.className}} {{if (eq this.activeAllocation cpu.allocation) "norca-topo-active"}} {{if cpu.allocation.isSelected "norca-topo-selected"}}"
              clip-path="url(#{{this.maskId}})"
              data-allocation-id="{{cpu.allocation.allocation.id}}"
              aria-hidden="true"
              {{on "mouseenter" (fn this.highlightAllocation cpu.allocation)}}
              {{on "click" (fn this.selectAllocation cpu.allocation)}}>
              <rect
                width="{{cpu.width}}px"
                height="{{if cpu.allocation.isSelected this.selectedHeight this.height}}px"
                x="{{cpu.x}}px"
                y="{{if cpu.allocation.isSelected this.selectedYOffset this.yOffset}}px"
                class="norca-topo-layer-0" />
              {{#if (or (eq cpu.className "starting") (eq cpu.className "pending"))}}
                <rect
                  width="{{cpu.width}}px"
                  height="{{if cpu.allocation.isSelected this.selectedHeight this.height}}px"
                  x="{{cpu.x}}px"
                  y="{{if cpu.allocation.isSelected this.selectedYOffset this.yOffset}}px"
                  class="norca-topo-layer-1" />
              {{/if}}
            </g>
          {{/each}}
        </g>
      </g>
    {{else}}
      <g class="norca-topo-empty-text"><text data-test-empty-message>Empty Client</text></g>
    {{/if}}
  </svg>
</div>
