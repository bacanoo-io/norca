~}}
<Ui::Card @title="Child jobs" class="mb-3" data-test-job-summary>
  {{#if @job.summary.totalChildren}}
    <Ui::Distribution
      @label="Child jobs"
      @data={{this.summaryData}}
      data-test-children-status-bar
    />
  {{else}}
    <p class="text-secondary m-0" data-test-no-children>No child jobs yet.</p>
  {{/if}}
</Ui::Card>

<div class="mb-3" data-test-job-launches>
  <h2 class="h3 mb-2">Job launches</h2>
  <Ui::DataTable
    @id="job-children"
    @caption="Job launches"
    @columns={{this.columns}}
    @rows={{this.sortedChildren}}
    @sortBy={{this.sortBy}}
    @sortDescending={{this.sortDescending}}
    @onSort={{this.sort}}
    @pageSize={{this.userSettings.pageSize}}
    @page={{this.page}}
    @onPageChange={{this.setPage}}
    @onPageSizeChange={{this.setPageSize}}
    @onRowClick={{this.gotoJob}}
    @enumerate={{true}}
    @noun="launches"
  >
    <:row as |child r|>
      <r.Row data-test-job-row={{child.plainId}}>
        <r.Cell @key="name" data-test-job-name>
          <LinkTo @route="jobs.job.index" @model={{child.idWithNamespace}}>{{child.name}}</LinkTo>
        </r.Cell>
        <r.Cell @key="submitTime" class="tabular-nums" data-test-job-submit-time>{{format-month-ts child.submitTime}}</r.Cell>
        <r.Cell @key="status" data-test-job-status><Ui::StatusIndicator @status={{child.status}} /></r.Cell>
        <r.Cell @key="groups" data-test-job-task-groups>{{or child.taskGroupCount "--"}}</r.Cell>
        <r.Cell @key="summary" class="w-25" data-test-job-allocations>
          <Jobs::AllocationSummary @summary={{child.summary}} @job={{child}} @compact={{true}} @noLegend={{true}} />
        </r.Cell>
      </r.Row>
    </:row>
    <:empty>
      <Ui::EmptyState
        @icon="clock"
        @title="No job launches"
        @message={{if @job.parameterized "Dispatch the job to start a launch." "The next launch starts at the next time of the schedule, or force a launch now."}}
        data-test-empty-children
      />
    </:empty>
  </Ui::DataTable>
</div>
