{
  "name": "nomad-ui",
  "version": "0.0.0",
  "description": "The web ui for Nomad, by HashiCorp.",
  "repository": "",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "precommit": "lint-staged",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel \"lint:!(fix)\"",
    "lint:fix": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember server",
    "test": "npm-run-all lint test:*",
    "exam": "percy exec -- ember exam --split=4 --parallel",
    "exam:parallel": "percy exec --parallel -- ember exam",
    "percy": "percy",
    "test:ember": "percy exec -- ember test",
    "local:qunitdom": "ember test --server --query=dockcontainer",
    "local:exam": "ember exam --server --load-balance --parallel=4",
    "seedless-test": "USE_PERCY=false ember test",
    "postinstall": "patch-package"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "{app,tests,config,lib,mirage,stories}/**/*.js": [
      "prettier --write"
    ],
    "app/styles/**/*.*": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@ember/optional-features": "^2.2.0",
    "@ember/test-helpers": "^4.0.4",
    "@glint/template": "~1.7.0",
    "@percy/cli": "^1.6.1",
    "@percy/ember": "^3.0.0",
    "@tabler/icons": "3.49.0",
    "axe-core": "^4.10.2",
    "babel-eslint": "^10.1.0",
    "broccoli-asset-rev": "^3.0.0",
    "broccoli-funnel": "^3.0.8",
    "broccoli-plugin": "^4.0.7",
    "ember-a11y-testing": "^7.1.2",
    "ember-auto-import": "^2.10.0",
    "ember-cli": "~6.12.0",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-dependency-checker": "^3.3.3",
    "ember-cli-deprecation-workflow": "^3.4.0",
    "ember-cli-htmlbars": "^6.3.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-mirage": "^3.0.4",
    "ember-cli-page-object": "^2.3.2",
    "ember-cli-sass": "^11.0.1",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-exam": "^9.1.0",
    "ember-qunit": "^8.1.1",
    "ember-template-lint": "^3.15.0",
    "ember-test-selectors": "^7.1.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-ember": "^10.5.9",
    "eslint-plugin-ember-a11y-testing": "a11y-tool-sandbox/eslint-plugin-ember-a11y-testing#ca31c9698c7cb105f1c9761d98fcaca7d6874459",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-qunit": "^6.2.0",
    "faker": "^4.1.0",
    "glob": "^7.2.0",
    "http-proxy": "^1.1.6",
