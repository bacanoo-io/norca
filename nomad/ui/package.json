    "patch-package": "8.0.1",
    "postcss": "^8.5.6",
    "pretender": "^3.0.1",
    "prettier": "^2.5.1",
    "qunit": "^2.24.1",
    "qunit-dom": "^3.4.0",
    "sass": "^1.83.0",
    "sinon": "^19.0.2",
    "testem": "^3.15.2",
    "testem-multi-reporter": "^1.2.0",
    "webpack": "^5.97.1"
  },
  "engines": {
    "node": ">= 20"
  },
  "ember": {
    "edition": "octane"
  },
  "private": true,
