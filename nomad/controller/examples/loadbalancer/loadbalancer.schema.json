{
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "required": ["service", "port"],
      "additionalProperties": false,
      "properties": {
        "service":     {"type": "string", "minLength": 1},
        "class":       {"type": "string", "minLength": 1, "default": "nomad"},
        "port":        {"type": "integer", "minimum": 1, "maximum": 65535},
        "internal":    {"type": "boolean", "default": false},
        "replicas":    {"type": "integer", "minimum": 1, "maximum": 16, "default": 1},
        "datacenters": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": ["*"]}
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "observedGeneration": {"type": "integer", "minimum": 0},
        "observedSpecHash":   {"type": "string"},
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "status"],
            "properties": {
              "type":               {"type": "string"},
              "status":             {"enum": ["True", "False", "Unknown"]},
              "reason":             {"type": "string"},
              "message":            {"type": "string"},
              "lastTransitionTime": {"type": "string"}
            }
          }
        },
        "class":     {"type": "string"},
        "addresses": {"type": "array", "items": {"type": "string"}},
        "targets":   {"type": "array", "items": {"type": "string"}},
        "resource":  {"type": "string"}
      }
    }
  }
}
