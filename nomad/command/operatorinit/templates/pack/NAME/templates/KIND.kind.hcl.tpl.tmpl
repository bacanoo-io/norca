kind "<% .Kind %>" {
  group       = "<% .Group %>"
  description = "TODO: describe what a <% .Kind %> is"
  namespaced  = <% .Namespaced %>
  version     = 1
  schema      = <<EOT
[[ template "schema" . ]]
EOT

  rule {
    expression = "!has(oldSelf) || self.spec.replicas <= oldSelf.spec.replicas + 10"
    message    = "replicas can grow by at most 10 at a time."
  }

  columns {
    column "Replicas" { path = "spec.replicas" }
    column "Ready" { path = "status.conditions[?type=='Ready'].status" }
  }

  limits {
    write_rate               = 50
    identity_write_rate      = 20
    max_watches_per_identity = 16
  }
}
