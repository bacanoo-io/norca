package main

import (
	"os"
	"testing"

	"github.com/hashicorp/nomad/api"
	"github.com/hashicorp/nomad/controller"
	"github.com/hashicorp/nomad/controller/envtest"
)

// TestEnvtest_Lifecycle runs the controller against a real dev agent started
// from the norca binary (NORCA_BINARY or norca on the PATH): the servers
// validate the objects against the kind's schema and rules, fill in the
// defaults and keep the finalizer. It is skipped with -short and without a
// binary.
func TestEnvtest_Lifecycle(t *testing.T) {
	agent := envtest.StartT(t, envtest.Options{})
	client := agent.Client

	schema, err := os.ReadFile("<% .KindLower %>.schema.json")
	if err != nil {
		t.Fatal(err)
	}
	if _, _, err := client.ObjectKinds().Register(&api.ObjectKind{
		Group: Kind.Group, Kind: Kind.Kind, Namespaced: <% .Namespaced %>, Schema: string(schema),
	}, nil, nil); err != nil {
		t.Fatal(err)
	}
	startController(t, controller.NewBackend(client))

	obj := &api.CustomObject{Group: Kind.Group, Kind: Kind.Kind, Name: "sample", Spec: map[string]any{"replicas": 2}}
	if _, _, err := client.Objects().Apply(obj, nil, nil); err != nil {
		t.Fatal(err)
	}
	get := func() *api.CustomObject {
		co, _, err := client.Objects().Get(Kind.Group, Kind.Kind, "sample", nil)
		if err != nil {
			return nil
		}
		return co
	}
	waitFor(t, "ready", func() bool {
		co := get()
		// The schema's default message was filled in by the servers.
		return co != nil && co.Spec["message"] == "hello" && status(t, co).IsTrue(controller.ConditionReady)
	})

	if _, _, err := client.Objects().Delete(Kind.Group, Kind.Kind, "sample", nil, nil); err != nil {
		t.Fatal(err)
	}
	waitFor(t, "deletion", func() bool { return get() == nil })
}
