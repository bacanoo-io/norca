{
  "$comment": "SPDX-FileCopyrightText: 2026 Norca contributors; SPDX-License-Identifier: MPL-2.0",
  "type": "object",
  "properties": {
    "job_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
    "namespace": {"type": "string"},
    "region": {"type": "string"},
    "datacenters": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "count": {"type": "integer", "minimum": 0, "maximum": 20},
    "team": {"type": "string"},
    "image": {"type": "string", "minLength": 1, "not": {"pattern": ":latest$"}},
    "network_mode": {"enum": ["bridge", "host"]},
    "cpu": {"type": "integer", "minimum": 20},
    "memory": {"type": "integer", "minimum": 16},
    "secrets_enabled": {"type": "boolean"},
    "startup_timeout": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"},
    "disruption_max_unavailable": {"type": "string", "pattern": "^([0-9]+%?)?$"},
    "separate_scope": {"type": "string"},
    "separate_required": {"type": "boolean"},
    "discovery_prefer": {"enum": ["", "none", "zone", "datacenter", "region"]},
    "discovery_failover": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scaling_enabled": {"type": "boolean"},
    "scaling_min": {"type": "integer", "minimum": 0},
    "scaling_max": {"type": "integer", "minimum": 1, "maximum": 20},
    "scaling_cpu_target": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
    "mtls_sidecar": {"type": "boolean"},
    "multiregion": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "count"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "multiregion_max_parallel": {"type": "integer", "minimum": 0},
    "multiregion_on_failure": {"enum": ["fail_all", "fail_local"]}
  }
}
