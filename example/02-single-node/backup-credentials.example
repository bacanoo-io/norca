#
# S3 credentials of the backup destination, in the AWS shared credentials
# format. Install as /etc/norca.d/backup-credentials, readable only by the
# user of the agent (chmod 600). With the MinIO job of this example these
# are the MinIO root credentials stored in the secret minio/root.
[default]
aws_access_key_id     = CHANGE_ME
aws_secret_access_key = CHANGE_ME
