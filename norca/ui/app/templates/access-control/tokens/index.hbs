{{page-title "Tokens"}}
<Access::Header @title="Tokens">
  {{#if (can "write token")}}
    <Ui::Button @variant="primary" @icon="plus" @route="access-control.tokens.new" data-test-create-token>Create Token</Ui::Button>
  {{else}}
    <Ui::Tooltip @text="You don’t have sufficient permissions">
      <Ui::Button @variant="primary" @icon="plus" @disabled={{true}} data-test-disabled-create-token>Create Token</Ui::Button>
    </Ui::Tooltip>
  {{/if}}
</Access::Header>
<Ui::PageBody>
  <Access::Tabs />
  <p class="text-secondary">
    Tokens authenticate requests to Norca. Client tokens get their permissions from linked roles and policies;
    management tokens can do everything.
  </p>
  <Ui::DataTable
    @id="access-tokens"
    @caption="Tokens"
    @columns={{this.columns}}
    @rows={{this.rows}}
    @sortBy={{this.list.sortBy}}
    @sortDescending={{this.list.sortDescending}}
    @onSort={{this.list.sort}}
    @pageSize={{this.list.pageSize}}
    @page={{this.list.page}}
    @onPageChange={{this.list.setPage}}
    @onPageSizeChange={{this.list.setPageSize}}
    @noun="tokens"
    @viewState={{this.list.viewState}}
    @onApplyView={{this.list.applyView}}
  >
    <:filters>
      <Ui::Input
        @type="search"
        @icon="search"
        @placeholder="Search tokens..."
        @value={{this.list.searchTerm}}
        @onInput={{this.list.search}}
        aria-label="Search tokens"
        data-test-tokens-search
      />
      <Ui::FilterDropdown
        @label="Type"
        @options={{this.typeOptions}}
        @selection={{or this.list.selections.type (array)}}
        @onSelect={{fn this.list.setFilter "type"}}
        data-test-token-type-facet
      />
    </:filters>
    <:row as |token r|>
      {{#let (eq token.id this.selfTokenId) as |isOwnToken|}}
        <r.Row data-test-token-row>
          <r.Cell @key="name">
            <span data-test-token-name={{token.name}}>
              {{~#if isOwnToken~}}
                {{token.name}}
              {{~else~}}
                <LinkTo @route="access-control.tokens.token" @model={{token.id}}>{{token.name}}</LinkTo>
              {{~/if~}}
            </span>
            {{#if isOwnToken}}
              <Ui::Badge @color="azure" class="ms-1" data-test-own-token-badge>Your token</Ui::Badge>
            {{/if}}
          </r.Cell>
          <r.Cell @key="type" data-test-token-type={{token.type}}>{{token.type}}</r.Cell>
          <r.Cell @key="createTime" class="text-nowrap" data-test-token-create-time>
            {{#if token.createTime}}
              <Ui::Tooltip @text={{format-ts token.createTime}}>
                <span tabindex="0">{{moment-from-now token.createTime}}</span>
              </Ui::Tooltip>
            {{/if}}
          </r.Cell>
          <r.Cell @key="expirationTime" class="text-nowrap {{if token.isExpired 'text-danger'}}" data-test-token-expiration-time>
            {{#if token.expirationTime}}{{moment-from-now token.expirationTime interval=1000}}{{else}}Never{{/if}}
          </r.Cell>
          <r.Cell @key="roles" data-test-token-roles>
            <Access::LinkList @items={{token.roles}} @route="access-control.roles.role" @idKey="id" @permission="read role" @empty="No Roles" />
          </r.Cell>
          <r.Cell @key="policies" data-test-token-policies>
            <Access::LinkList @items={{token.policies}} @route="access-control.policies.policy" @idKey="name" @permission="read policy" @empty="No Policies" />
          </r.Cell>
          <r.Cell @key="actions" class="text-end" data-test-delete-token>
            <Ui::ConfirmButton
              @label="Delete"
              @icon="trash"
              @size="sm"
              @message="Delete the token {{token.name}}?"
              @confirmLabel="Yes, delete"
              @disabled={{or isOwnToken this.deleteToken.isRunning}}
              @disabledReason={{if isOwnToken "You cannot delete the token you are signed in with"}}
              @isRunning={{this.deleteToken.isRunning}}
              @onConfirm={{perform this.deleteToken token}}
            />
          </r.Cell>
        </r.Row>
      {{/let}}
    </:row>
    <:empty>
      {{#if this.tokens.length}}
        <Ui::EmptyState @icon="filter-off" @title="No Matches" @message="No tokens match the search and the filters." data-test-empty-tokens-list />
      {{else}}
        <Ui::EmptyState @icon="key" @title="No Tokens" data-test-empty-tokens-list />
      {{/if}}
    </:empty>
  </Ui::DataTable>
</Ui::PageBody>
