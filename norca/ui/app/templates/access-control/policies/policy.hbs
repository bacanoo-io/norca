{{page-title "Policy"}}
<Access::Header
  @title={{this.policy.name}}
  @trail={{array (hash label="Policies" route="access-control.policies" id="access-control.policies") (hash label=this.policy.name)}}
>
  {{#if (can "destroy policy")}}
    <Ui::ConfirmButton
      @label="Delete Policy"
      @icon="trash"
      @message="Delete the policy {{this.policy.name}}?"
      @confirmLabel="Yes, delete"
      @isRunning={{this.deletePolicy.isRunning}}
      @onConfirm={{perform this.deletePolicy}}
      data-test-delete-policy
    />
  {{/if}}
</Access::Header>
<Ui::PageBody>
  <PolicyEditor @policy={{this.policy}} />

  {{#if (can "list token")}}
    <h2 class="h3 mt-4 mb-2">Tokens</h2>

    {{#if (can "write token")}}
      <div class="row row-cards mb-3">
        <div class="col-md-6">
          <Ui::Card @title="Create a test token" class="h-100">
            <p class="text-secondary">Create a test token that expires in 10 minutes for testing purposes.</p>
            <Ui::Button @icon="key" data-test-create-test-token {{on "click" (perform this.createTestToken)}}>Create Test Token</Ui::Button>
          </Ui::Card>
        </div>
        <div class="col-md-6">
          <Ui::Card @title="Create tokens from the Norca CLI" class="h-100">
            <p class="text-secondary">When you're ready to create more tokens, you can do so via the CLI with the following:</p>
            <Ui::CodeBlock @code={{this.newTokenString}} @copy={{true}} @label="The command" data-test-copy-button />
          </Ui::Card>
        </div>
      </div>
    {{/if}}

    {{#if this.tokens.length}}
      <Ui::Table @caption="Tokens using {{this.policy.name}}" @columns={{this.tokenColumns}} @rows={{this.tokens}} @rowTestId="policy-token-row" as |token|>
        <td data-test-token-name={{token.name}}>
          <Ui::Tooltip @text={{token.id}}>
            <span tabindex="0">{{token.name}}</span>
          </Ui::Tooltip>
        </td>
        <td class="text-nowrap">{{moment-from-now token.createTime interval=1000}}</td>
        <td class="text-nowrap">
          {{#if token.expirationTime}}
            <Ui::Tooltip @text={{token.expirationTime}}>
              <span tabindex="0" class={{if token.isExpired "text-danger"}} data-test-token-expiration-time>{{moment-from-now token.expirationTime interval=1000}}</span>
            </Ui::Tooltip>
          {{else}}
            <span>Never</span>
          {{/if}}
        </td>
        {{#if (can "destroy token")}}
          <td class="text-end">
            <Ui::ConfirmButton
              @label="Delete Token"
              @icon="trash"
              @size="sm"
              @message="Delete the token {{token.name}}?"
              @confirmLabel="Yes, delete"
              @isRunning={{this.deleteToken.isRunning}}
              @onConfirm={{perform this.deleteToken token}}
              data-test-delete-token-button
            />
          </td>
        {{/if}}
      </Ui::Table>
    {{else}}
      <Ui::EmptyState @compact={{true}} @icon="key" @title="No Tokens" @message="No tokens are using this policy." data-test-empty-policy-tokens />
    {{/if}}
  {{/if}}
</Ui::PageBody>
