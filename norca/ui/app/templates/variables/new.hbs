{{page-title "New Variable"}}
<Ui::PageHeader @title="Create a Variable" @breadcrumbs={{array (hash label="Variables" route="variables.index" id="variables.index") (hash label="New")}}>
  <:actions>
    <Ui::Switch
      @switch={{true}}
      @label="JSON"
      @checked={{eq this.view "json"}}
      @onChange={{this.toggleView}}
      class="mb-0"
      data-test-memory-toggle
    />
  </:actions>
</Ui::PageHeader>
<Ui::PageBody>
  <VariableForm @model={{this.model}} @path={{this.path}} @existingVariables={{this.existingVariables}} @view={{this.view}} />
</Ui::PageBody>
