{{page-title "Variables"}}
<Ui::PageHeader @title="Variables" @breadcrumbs={{array (hash label="Variables")}}>
  <:actions>
    {{#if this.namespaceOptions}}
      <Ui::Select
        @label="Namespace"
        @options={{this.namespaceOptions}}
        @value={{this.namespaceSelection}}
        @onChange={{this.setNamespace}}
        class="w-auto"
        data-test-variable-namespace-filter
      />
    {{/if}}
    {{#if (can "write variable" path="*" namespace=this.namespaceSelection)}}
      <Ui::Button
        @variant="primary"
        @icon="plus"
        @route="variables.new"
        data-test-create-var
        {{keyboard-shortcut pattern=(array "n" "v") action=this.goToNewVariable label="Create Variable"}}
      >Create Variable</Ui::Button>
    {{else}}
      <Ui::Tooltip @text="You don’t have sufficient permissions">
        <Ui::Button @variant="primary" @icon="plus" @disabled={{true}} data-test-disabled-create-var>Create Variable</Ui::Button>
      </Ui::Tooltip>
    {{/if}}
  </:actions>
</Ui::PageHeader>
<Ui::PageBody>
  {{#if this.isForbidden}}
    <ForbiddenMessage />
  {{else if this.hasVariables}}
    <VariablePaths @branch={{this.root}} />
  {{else if (eq this.namespaceSelection "*")}}
    <Ui::EmptyState @icon="lock" @title="No Variables" data-test-empty-variables-list>
      {{#if (can "write variable" path="*" namespace=this.namespaceSelection)}}
        <p class="text-secondary">Get started by <LinkTo @route="variables.new">creating a new variable</LinkTo></p>
      {{/if}}
    </Ui::EmptyState>
  {{else}}
    <Ui::EmptyState
      @icon="filter-off"
      @title="No Matches"
      @message="No paths or variables match the namespace {{this.namespaceSelection}}"
      data-test-no-matching-variables-list
    />
  {{/if}}
</Ui::PageBody>
