{{page-title @model.backupId " - Backups"}}
<PageLayout>
  <Backups::Detail
    @backupId={{@model.backupId}}
    @tab={{this.tab}}
    @type={{this.type}}
    @job={{this.job}}
    @against={{this.against}}
    @onTabChange={{this.setTab}}
    @onParamsChange={{this.setParams}}
  />
</PageLayout>
