{{page-title "CSI Plugins"}}
<Ui::PageHeader @pretitle="Capacity" @title="Storage" @subtitle="CSI volumes and the plugins that provide them" />
<Ui::PageBody>
  <Storage::Tabs />
  {{#if this.isForbidden}}
    <ForbiddenMessage />
  {{else}}
    <Ui::DataTable
      @id="csi-plugins"
      @caption="CSI plugins"
      @columns={{this.columns}}
      @rows={{this.sortedPlugins}}
      @sortBy={{this.sortProperty}}
      @sortDescending={{this.sortDescending}}
      @onSort={{this.sort}}
      @pageSize={{this.pageSize}}
      @page={{this.currentPage}}
      @onPageChange={{this.setPage}}
      @onPageSizeChange={{this.setPageSize}}
      @onRowClick={{this.gotoPlugin}}
      @enumerate={{true}}
      @noun="plugins"
      @viewState={{this.viewState}}
      @onApplyView={{this.applyView}}
    >
      <:filters>
        {{#if this.model.length}}
          <Ui::Input
            @type="search"
            @icon="search"
            @placeholder="Search plugins..."
            @value={{this.searchTerm}}
            @onInput={{this.search}}
            aria-label="Search plugins"
            data-test-plugins-search
          />
        {{/if}}
      </:filters>
      <:row as |plugin r|>
        <r.Row data-test-plugin-row={{plugin.plainId}}>
          <r.Cell @key="plainId" data-test-plugin-id>
            <LinkTo @route="csi.plugins.plugin" @model={{plugin.plainId}}>{{plugin.plainId}}</LinkTo>
          </r.Cell>
          <r.Cell @key="controllersHealthyProportion" data-test-plugin-controller-health>
            <Storage::Health
              @nodeOnly={{not (or plugin.controllerRequired (gt plugin.controllersExpected 0))}}
              @healthy={{plugin.controllersHealthy}}
              @expected={{plugin.controllersExpected}}
            />
          </r.Cell>
          <r.Cell @key="nodesHealthyProportion" data-test-plugin-node-health>
            <Storage::Health @healthy={{plugin.nodesHealthy}} @expected={{plugin.nodesExpected}} />
          </r.Cell>
          <r.Cell @key="provider" data-test-plugin-provider>{{plugin.provider}}</r.Cell>
        </r.Row>
      </:row>
      <:empty>
        {{#if (eq this.model.length 0)}}
          <Ui::EmptyState
            @icon="database"
            @title="No Plugins"
            @message="The cluster currently has no registered CSI plugins. Run a job with a csi_plugin block to register one."
            data-test-empty-plugins-list
          />
        {{else}}
          <Ui::EmptyState
            @icon="filter-off"
            @title="No Matches"
            @message="No plugins match the term {{this.searchTerm}}. Change the search to see more plugins."
            data-test-empty-plugins-list
          />
        {{/if}}
      </:empty>
    </Ui::DataTable>
  {{/if}}
</Ui::PageBody>
