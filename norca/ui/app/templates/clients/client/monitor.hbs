{{page-title "Client " (or this.model.name this.model.shortId)}}
<Clients::Header @client={{this.model}} />
<Ui::PageBody>
  <Clients::Tabs @client={{this.model}} />
  {{#if (can "read agent")}}
    <AgentMonitor @level={{this.level}} @client={{this.model}} @onLevelChange={{fn (mut this.level)}} />
  {{else}}
    <ForbiddenMessage @permission="agent:read" />
  {{/if}}
</Ui::PageBody>
