<Ui::Card @flush={{true}} data-test-variable-paths>
    <Ui::Table
      @inCard={{true}}
      @caption="Variables"
      @columns={{array (hash key="path" label="Path") (hash key="namespace" label="Namespace") (hash key="modified" label="Last modified")}}
      @rows={{this.rows}}
      @emptyMessage="No variables here."
      @onRowClick={{this.handleRowClick}}
      as |row|
    >
      {{#if row.folder}}
        <td colspan="3" data-test-folder-row {{keyboard-shortcut enumerated=true action=(fn this.handleFolderClick row.folder.data.absolutePath)}}>
          <span class="d-inline-flex align-items-center gap-2">
            <Ui::Icon @name="folder" class="text-secondary" />
            <LinkTo @route="variables.path" @model={{row.folder.data.absolutePath}} @query={{hash namespace="*"}}>
              {{trim-path row.folder.name}}
            </LinkTo>
          </span>
        </td>
      {{else}}
        <td data-test-file-row={{row.file.name}} {{keyboard-shortcut enumerated=true action=(fn this.handleFileClick row.file)}}>
          <span class="d-inline-flex align-items-center gap-2">
            <Ui::Icon @name="file-text" class="text-secondary" />
            {{#if (can "read variable" path=row.file.absoluteFilePath namespace=row.file.variable.namespace)}}
              <LinkTo @route="variables.variable" @model={{row.file.variable.id}} @query={{hash namespace="*"}}>{{row.file.name}}</LinkTo>
            {{else}}
              <span class="text-secondary" title="Your access policy does not allow you to view the contents of {{row.file.name}}" data-test-inaccessible>{{row.file.name}}</span>
            {{/if}}
          </span>
        </td>
        <td>{{row.file.variable.namespace}}</td>
        <td>
          <Ui::Tooltip @text={{format-ts row.file.variable.modifyTime}}>
            <span>{{moment-from-now row.file.variable.modifyTime}}</span>
          </Ui::Tooltip>
        </td>
      {{/if}}
    </Ui::Table>
</Ui::Card>
