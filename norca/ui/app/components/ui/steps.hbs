{{!--
  SPDX-FileCopyrightText: 2026 Norca contributors
  SPDX-License-Identifier: MPL-2.0

  A step indicator for wizards (restore, release). @steps is a list of
  labels, @current the zero-based index of the active step.

    <Ui::Steps @steps={{array "Choose backup" "Review" "Restore"}} @current={{1}} />
--}}
<ol class="steps steps-counter {{if @color (concat 'steps-' @color)}} my-3" data-test-steps ...attributes>
  {{#each @steps as |label index|}}
    <li
      class="step-item {{if (eq index @current) 'active'}}"
      aria-current={{if (eq index @current) "step"}}
      data-test-step={{index}}
    >{{label}}</li>
  {{/each}}
</ol>
