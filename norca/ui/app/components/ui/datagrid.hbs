{{!--
  SPDX-FileCopyrightText: 2026 Norca contributors
  SPDX-License-Identifier: MPL-2.0

  A grid of label/value pairs (Tabler datagrid): either @items, a list of
  { title, value, mono? }, or Item blocks for richer values.

    <Ui::Datagrid @items={{array (hash title="Engine" value="built-in")}} />
    <Ui::Datagrid as |g|>
      <g.Item @title="Type" data-test-job-stat="type">{{@job.type}}</g.Item>
    </Ui::Datagrid>
--}}
<div class="datagrid {{if @compact 'norca-datagrid-compact'}}" data-test-datagrid ...attributes>
  {{#each @items as |item|}}
    <Ui::Datagrid::Item @title={{item.title}} @monospace={{item.mono}}>{{item.value}}</Ui::Datagrid::Item>
  {{/each}}
  {{yield (hash Item=(component "ui/datagrid/item"))}}
</div>
