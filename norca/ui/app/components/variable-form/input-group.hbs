<div class="col">
  <Ui::Field @label="Value" class="mb-0" as |f|>
    <div class="d-flex align-items-center gap-1">
      <Ui::Input
        @id={{f.id}}
        @type={{this.inputType}}
        @value={{@entry.value}}
        @onInput={{this.setValue}}
        @autocomplete="new-password"
        data-test-var-value
      />
      <Ui::Button
        @icon={{if this.isObscured "eye" "eye-off"}}
        @iconOnly={{true}}
        @label={{if this.isObscured "Show Value" "Hide Value"}}
        aria-pressed={{if this.isObscured "false" "true"}}
        data-test-toggle-value
        {{on "click" this.toggleInputType}}
      />
    </div>
  </Ui::Field>
</div>
