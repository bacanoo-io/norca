<div data-test-object-detail {{this.setup this.kindId @name @namespace this.region}}>
  <Ui::PageHeader @pretitle={{concat "Objects / " this.kindId}} @title={{@name}}>
    <:subtitle>
      {{#if this.health}}
        <Ui::StatusIndicator @tone={{this.health.tone}} @label={{this.health.label}} data-test-object-health />
      {{/if}}
      {{#if this.deletion}}
        <Ui::Badge @color="red" @icon="trash" class="ms-2" data-test-object-deleting-badge>deleting</Ui::Badge>
      {{/if}}
      {{#if @namespace}}<span class="ms-2">namespace {{@namespace}}</span>{{/if}}
    </:subtitle>
    <:actions>
      <Ui::Button @route="objects" @query={{hash kind=this.kindId}}>All {{@kind}} objects</Ui::Button>
      <Ui::Button @route="kinds.kind" @models={{array @group @kind}} @icon="list-details" data-test-object-kind-link>Definition</Ui::Button>
      {{#if (and this.object this.canWrite (not this.deletion))}}
        <Ui::Button @variant="outline-danger" @icon="trash" data-test-delete-object {{on "click" this.openDelete}}>Delete</Ui::Button>
      {{/if}}
      {{#if (and this.object this.kind this.canWrite (not this.deletion))}}
        <Ui::Button @variant="primary" @icon="pencil" data-test-edit-object {{on "click" this.openEditor}}>Edit</Ui::Button>
      {{/if}}
    </:actions>
  </Ui::PageHeader>

  <Ui::PageBody>
    {{#if this.isLoading}}
      <Ui::Card><Ui::Spinner @showLabel={{true}} @label="Loading the object" /></Ui::Card>
    {{else if this.loadError}}
      <Ui::Card>
        <Ui::EmptyState @icon="box" @title="Object not available" @message={{this.loadError}} data-test-object-error>
          <Ui::Button @route="objects" @query={{hash kind=this.kindId}}>All {{@kind}} objects</Ui::Button>
        </Ui::EmptyState>
      </Ui::Card>
    {{else}}
      {{#if this.deletion}}
        <Ui::Alert @tone="warning" @title="The object is being deleted ({{this.deletion.mode}})" class="mb-3" data-test-object-deletion>
          It was marked for deletion {{moment-from-now this.deletion.since}} and waits for {{this.deletion.waiting}}.
          If this lasts, check that the controller of {{this.kindId}} is running.
        </Ui::Alert>
      {{/if}}
      {{#if this.health.behind}}
        <Ui::Alert @tone="info" class="mb-3" data-test-object-behind>
          The controller has not processed the latest change yet (generation {{this.object.Generation}}, observed {{this.object.Status.observedGeneration}}).
          If this lasts, check that the controller of {{this.kindId}} is running.
        </Ui::Alert>
      {{/if}}
      <div class="row row-cards">
        <div class="col-lg-6">
          <Ui::Card @title="Spec" @subtitle="Set by the user">
            <Ui::CodeBlock @label="Spec" @code={{this.specText}} data-test-object-spec />
            <p class="text-secondary small mt-2 mb-0">Edit checks a changed spec against the schema and the CEL rules of the kind in a dry run before it is saved.</p>
          </Ui::Card>
          {{#if this.scale}}
            <Ui::Card @title="Scale" @subtitle="The scale subresource of the kind" class="mt-3" data-test-object-scale>
              <Ui::Datagrid @items={{this.scaleItems}} />
              <p class="text-secondary small mt-2 mb-0">
                {{#if this.scaleConverging}}The controller has not reached the desired count yet. {{/if}}
                The autoscaler and <span class="font-monospace">norca object scale</span> change the desired count; in the UI, change it with Edit.
              </p>
            </Ui::Card>
          {{/if}}
        </div>
        <div class="col-lg-6">
          <Ui::Card @title="Status" @subtitle="Reported by the controller">
            <Ui::Datagrid @items={{this.statusItems}} data-test-object-status />
            {{#if this.labels.length}}
              <h4 class="mt-3">Labels</h4>
              {{#each this.labels as |label|}}<Ui::Badge class="me-1">{{label}}</Ui::Badge>{{/each}}
            {{/if}}
            {{#if this.owners.length}}
              <h4 class="mt-3">Owners</h4>
              {{#each this.owners as |owner|}}
                <div data-test-object-owner>
                  {{#if owner.route}}
                    <LinkTo @route={{owner.route}} @models={{owner.models}} @query={{or owner.query (hash)}} data-test-object-owner-link>{{owner.label}}</LinkTo>
                  {{else}}
                    {{owner.label}}
                  {{/if}}
                </div>
              {{/each}}
            {{/if}}
            {{#if this.object.Finalizers.length}}
              <h4 class="mt-3">Finalizers</h4>
              {{#each this.object.Finalizers as |f|}}<Ui::Badge class="me-1 font-monospace" data-test-object-finalizer>{{f}}</Ui::Badge>{{/each}}
              <p class="text-secondary small mt-1 mb-0">The object is deleted only after its controllers remove these.</p>
            {{/if}}
          </Ui::Card>
        </div>
      </div>
      <div class="row row-cards mt-1">
        <div class="col-lg-6">
          <Ui::Card @title="Conditions" @flush={{true}} data-test-object-conditions>
            <Ui::Table
              @inCard={{true}}
              @caption="Conditions"
              @columns={{array (hash key="type" label="Condition") (hash key="status" label="Status") (hash key="reason" label="Reason")}}
              @rows={{this.conditionRows}}
              @emptyMessage="The controller reports no conditions."
              as |c|
            >
              <td>{{c.type}}</td>
              <td><Ui::StatusIndicator @tone={{c.tone}} @label={{c.status}} /></td>
              <td>
                {{c.reason}}
                {{#if c.message}}<div class="small text-secondary">{{c.message}}</div>{{/if}}
                {{#if c.since}}<div class="small text-secondary">since {{c.since}}</div>{{/if}}
              </td>
            </Ui::Table>
          </Ui::Card>
          <Ui::Card @title="Owns" @subtitle="Jobs and objects that reference this object as their owner" @flush={{true}} class="mt-3" data-test-object-owns>
            {{#if this.ownsAnything}}
              {{#if this.ownedJobRows.length}}
              <Ui::Table
                @inCard={{true}}
                @caption="Owned jobs and objects"
                @columns={{array (hash key="what" label="Owned") (hash key="namespace" label="Namespace") (hash key="state" label="State")}}
                @rows={{this.ownedJobRows}}
                as |j|
              >
                <td data-test-owned-job={{j.name}}>
                  <Ui::Icon @name="briefcase" class="me-1" />
                  <LinkTo @route="jobs.job.index" @model={{j.routeId}}>Job {{j.name}}</LinkTo>
                </td>
                <td>{{j.namespace}}</td>
                <td><Ui::StatusIndicator @status={{j.status}} /></td>
              </Ui::Table>
              {{/if}}
              {{#if this.ownedObjectRows.length}}
                <Ui::Table
                  @inCard={{true}}
                  @caption="Owned objects"
                  @columns={{array (hash key="what" label="Object") (hash key="namespace" label="Namespace") (hash key="state" label="Health")}}
                  @rows={{this.ownedObjectRows}}
                  as |o|
                >
                  <td data-test-owned-object={{o.Name}}>
                    <LinkTo @route="objects.object" @models={{array o.Group o.Kind o.Name}} @query={{hash namespace=(or o.Namespace null)}}>{{o.Kind}} {{o.Name}}</LinkTo>
                  </td>
                  <td>{{or o.Namespace "–"}}</td>
                  <td><Ui::StatusIndicator @tone={{o.health.tone}} @label={{o.health.label}} /></td>
                </Ui::Table>
              {{/if}}
            {{else}}
              <div class="p-3">
                <p class="text-secondary mb-0" data-test-object-owns-none>
                  {{#if (and (eq this.ownedJobs null) (eq this.ownedObjects null))}}
                    Loading what the object owns…
                  {{else}}
                    No job or object references this object as its owner. A controller sets the owner when it creates them.
                  {{/if}}
                </p>
              </div>
            {{/if}}
          </Ui::Card>
          <Ui::Card @title="Full status" class="mt-3">
            <Ui::CodeBlock @label="Status" @code={{this.statusText}} />
          </Ui::Card>
        </div>
        <div class="col-lg-6">
          <Ui::Card @title="Event log" data-test-object-events>
            {{#if this.eventItems.length}}
              <Ui::Timeline @items={{this.eventItems}} @simple={{true}} />
            {{else}}
              <Ui::EmptyState @compact={{true}} @icon="activity" @title="No events" @message="Controllers and Norca log what they do with the object here (the newest 20 events)." />
            {{/if}}
          </Ui::Card>
        </div>
      </div>
    {{/if}}
  </Ui::PageBody>

  {{#if this.editing}}
    <Objects::Editor @kind={{this.kind}} @object={{this.object}} @region={{this.region}} @onSaved={{this.saved}} @onClose={{this.closeEditor}} />
  {{/if}}

  {{#if this.deleting}}
    <Ui::Confirm
      @title={{concat "Delete " @kind " " @name "?"}}
      @confirmLabel="Delete object"
      @confirmIcon="trash"
      @typedValue={{@name}}
      @onConfirm={{this.confirmDelete}}
      @onClose={{this.closeDelete}}
      @isRunning={{this.isDeleting}}
      @error={{this.deleteError}}
      data-test-object-delete-confirm
    >
      <Ui::RadioGroup @label="Deletion mode" @value={{this.deletionMode}} @onChange={{this.setDeletionMode}} @help={{this.deletionModeHelp}} data-test-deletion-mode as |g|>
        {{#each this.deletionModes as |m|}}
          <g.Option @value={{m.value}} @label={{m.label}} />
        {{/each}}
      </Ui::RadioGroup>
      {{#if this.object.Finalizers.length}}
        <p class="mb-0">The object has finalizers: it is only marked for deletion until its controllers have cleaned up and removed them.</p>
      {{/if}}
    </Ui::Confirm>
  {{/if}}
</div>
