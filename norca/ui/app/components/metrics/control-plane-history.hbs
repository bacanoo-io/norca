{{#if this.prepare.last.isFinished}}
  <Metrics::GaugeHistory
    @id="control-plane"
    @title="Control plane"
    @subtitle="Evaluations and jobs, from the metrics store of the servers"
    @charts={{this.charts}}
    @serverId={{this.leader}}
    @chartHeight={{160}}
    @emptyMessage="The servers sample the scheduler and the jobs every sample interval."
    data-test-control-plane-history
    ...attributes
  />
{{/if}}
