<div {{this.setup @region}} ...attributes>
  {{#if this.allowed}}
    <Ui::Card @title="Key protection" @subtitle={{if this.summary (concat "Seal: " this.summary.types)}} @flush={{true}} data-test-seal-status>
      {{#if this.isLoading}}
        <div class="p-3"><Ui::Spinner @showLabel={{true}} @label="Loading the seal status" /></div>
      {{else if this.error}}
        <div class="p-3"><Ui::Alert @tone="warning" class="mb-0" data-test-seal-error>{{this.error}}</Ui::Alert></div>
      {{else}}
        {{#if this.summary.sealed}}
          <div class="p-3 pb-0">
            <Ui::Alert @tone="danger" class="mb-0" data-test-seal-warning>
              {{this.summary.sealed}} of {{this.summary.total}} servers {{if (eq this.summary.sealed 1) "is" "are"}} sealed: they reject secret and Variable reads
              until unsealed with <span class="font-monospace">norca operator unseal</span>.
            </Ui::Alert>
          </div>
        {{/if}}
        <Ui::Table
          @inCard={{true}}
          @caption="Seal status of the servers"
          @columns={{array
            (hash key="name" label="Server")
            (hash key="seal" label="Keyring")
            (hash key="seals" label="Seals")
            (hash key="store" label="Secret store")
          }}
          @rows={{this.servers}}
          @emptyMessage="No server reported its seal status."
          as |s|
        >
          <td data-test-seal-server={{s.Name}}>
            <span class="font-monospace">{{s.Name}}</span>
            {{#if s.Leader}}<Ui::Badge @color="blue" class="ms-1">leader</Ui::Badge>{{/if}}
            {{#if s.Error}}<div class="small text-secondary">{{s.Error}}</div>{{/if}}
          </td>
          <td data-test-seal-state>
            <Ui::StatusIndicator @tone={{s.sealTone}} @label={{s.sealLabel}} />
            {{#if s.progress}}<div class="small text-secondary">{{s.progress}}</div>{{/if}}
          </td>
          <td>{{s.seals}}</td>
          <td data-test-seal-store><Ui::StatusIndicator @tone={{s.storeTone}} @label={{s.store}} /></td>
        </Ui::Table>
      {{/if}}
    </Ui::Card>
  {{/if}}
</div>
