<div class="norca-acl-form" data-test-policy-form>
  <Ui::Card class="mb-3">
    {{#if @policy.isNew}}
      <Ui::Field @label="Policy Name" @required={{true}} @help="Letters, numbers and dashes, up to 128 characters." as |f|>
        <Ui::Input
          @id={{f.id}}
          @value={{@policy.name}}
          @required={{true}}
          @describedBy={{f.describedBy}}
          @onInput={{this.updatePolicyName}}
          data-test-policy-name-input
          {{autofocus}}
        />
      </Ui::Field>
    {{/if}}
    <Ui::Field @label="Description (optional)" class="mb-0" as |f|>
      <Ui::Input @id={{f.id}} @value={{@policy.description}} @onInput={{this.updateDescription}} data-test-policy-description />
    </Ui::Field>
  </Ui::Card>

  <Ui::Editor
    @label="Policy definition"
    @language="hcl"
    @value={{@policy.rules}}
    @onChange={{this.updatePolicyRules}}
    @original={{this.originalRules}}
    @onSubmit={{this.save}}
    @submitLabel="Save Policy"
    @readOnly={{not (can "update policy")}}
    data-test-policy-editor
  />
</div>
