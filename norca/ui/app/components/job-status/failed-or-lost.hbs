<section class="norca-failed-or-lost">
  <h4 class="h4">Replaced Allocations</h4>
  <div class="norca-failed-or-lost-links">
    {{#if @supportsRescheduling}}
      <span>
        <Ui::Icon
          @name="info-circle"
          @size="sm"
          @label="Allocations that have been rescheduled, on another node if possible, due to failure or manual restart"
          title="Allocations that have been rescheduled, on another node if possible, due to failure or manual restart"
          class="text-secondary"
        />
        {{#if @rescheduledAllocs.length}}
          <LinkTo
            @route="jobs.job.allocations"
            @model={{@job}}
            @query={{hash scheduling='["has-been-rescheduled"]' version=(concat "[" @job.latestDeployment.versionNumber "]")}}
          >{{@rescheduledAllocs.length}} Rescheduled</LinkTo>
        {{else}}
          {{@rescheduledAllocs.length}} Rescheduled
        {{/if}}
      </span>
    {{/if}}
    <span>
      <Ui::Icon
        @name="info-circle"
        @size="sm"
        @label="Allocations that have been restarted in-place due to a task failure or manual restart"
        title="Allocations that have been restarted in-place due to a task failure or manual restart"
        class="text-secondary"
      />
      {{#if @restartedAllocs.length}}
        <LinkTo
          @route="jobs.job.allocations"
          @model={{@job}}
          @query={{hash scheduling='["has-been-restarted"]' version=(concat "[" @job.latestDeployment.versionNumber "]")}}
        >{{@restartedAllocs.length}} Restarted</LinkTo>
      {{else}}
        {{@restartedAllocs.length}} Restarted
      {{/if}}
    </span>
  </div>
</section>
